&НаСервере
Функция ValidationIssueЭПД(Id, Level, Message, FieldLabel = "", FieldId = "")
	Issue = Новый Структура("id, level, message", Id, Level, Message);
	Если ЗначениеЗаполнено(FieldLabel) Тогда
		Issue.Вставить("fieldLabel", FieldLabel);
	КонецЕсли;
	Если ЗначениеЗаполнено(FieldId) Тогда
		Issue.Вставить("fieldId", FieldId);
	КонецЕсли;
	Возврат Issue;
КонецФункции

&НаСервере
Функция ИННСоответствуетФорматуЭПД(ИНН)
	ИНН = СокрЛП(Строка(ИНН));
	Если ПустаяСтрока(ИНН) Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрДлина(ИНН) <> 10 И СтрДлина(ИНН) <> 12 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Инд = 1 По СтрДлина(ИНН) Цикл
		Если Не СтрНайти("0123456789", Сред(ИНН, Инд, 1)) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаСервере
Функция КППСоответствуетФорматуЭПД(КПП)
	КПП = СокрЛП(Строка(КПП));
	Если ПустаяСтрока(КПП) Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрДлина(КПП) <> 9 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Инд = 1 По 9 Цикл
		Если Не СтрНайти("0123456789", Сред(КПП, Инд, 1)) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаСервере
Процедура ДобавитьValidationСтороныЭПД(Issues, Summary, Key, Party, PartyLabel)
	Если ТипЗнч(Party) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Имя = СокрЛП(Строка(Party.name));
	ИНН = СокрЛП(Строка(Party.inn));
	КПП = СокрЛП(Строка(Party.kpp));
	EdoId = СокрЛП(Строка(Party.edoId));
	Своё = Party.Свойство("isOwnOrganization") И Party.isOwnOrganization;
	Если ЗначениеЗаполнено(Имя) И ПустаяСтрока(ИНН) Тогда
		Issues.Добавить(ValidationIssueЭПД(Key + ".inn.empty", "warn", "Не заполнен ИНН (" + PartyLabel + ").", "ИНН"));
		Summary.warnCount = Summary.warnCount + 1;
		Summary.ok = Ложь;
	ИначеЕсли ЗначениеЗаполнено(ИНН) И Не ИННСоответствуетФорматуЭПД(ИНН) Тогда
		Issues.Добавить(ValidationIssueЭПД(Key + ".inn.invalid", "error", "ИНН " + PartyLabel + ": неверный формат.", "ИНН"));
		Summary.errorCount = Summary.errorCount + 1;
		Summary.ok = Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(КПП) И Не КППСоответствуетФорматуЭПД(КПП) Тогда
		Issues.Добавить(ValidationIssueЭПД(Key + ".kpp.invalid", "warn", "КПП " + PartyLabel + ": ожидается 9 цифр.", "КПП"));
		Summary.warnCount = Summary.warnCount + 1;
		Summary.ok = Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Имя) И ПустаяСтрока(EdoId) И Не Своё Тогда
		Issues.Добавить(ValidationIssueЭПД(Key + ".edo.empty", "warn", "Не заполнен ID ЭДО (" + PartyLabel + ").", "ID ЭДО"));
		Summary.warnCount = Summary.warnCount + 1;
		Summary.ok = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПостроитьValidationIssuesЭПД(СтруктураДокумента, Подробно)
	Issues = Новый Массив;
	Summary = Новый Структура("errorCount, warnCount, externalCount, ok", 0, 0, 0, Истина);
	Если СтруктураДокумента.deletionMark Тогда
		Issues.Добавить(ValidationIssueЭПД("doc.deleted", "warn", "Документ помечен на удаление."));
		Summary.warnCount = Summary.warnCount + 1;
		Summary.ok = Ложь;
	КонецЕсли;
	ДобавитьValidationСтороныЭПД(Issues, Summary, "shipper", СтруктураДокумента.shipper, "грузоотправитель");
	ДобавитьValidationСтороныЭПД(Issues, Summary, "consignee", СтруктураДокумента.consignee, "грузополучатель");
	ДобавитьValidationСтороныЭПД(Issues, Summary, "carrier", СтруктураДокумента.carrier, "перевозчик");
	Если Подробно И СтруктураДокумента.Свойство("detailFields") Тогда
		Для Каждого Поле Из СтруктураДокумента.detailFields Цикл
			Если ТипЗнч(Поле) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			Метка = СокрЛП(Строка(Поле.label));
			Значение = СокрЛП(Строка(Поле.value));
			FieldId = ?(Поле.Свойство("fieldId"), Строка(Поле.fieldId), "");
			Если СтрНайти(Метка, "ИНН") > 0 И ЗначениеЗаполнено(Значение) И Не ИННСоответствуетФорматуЭПД(Значение) Тогда
				Issues.Добавить(ValidationIssueЭПД("detail.inn.invalid", "error", "«" + Метка + "»: неверный ИНН.", Метка, FieldId));
				Summary.errorCount = Summary.errorCount + 1;
				Summary.ok = Ложь;
			КонецЕсли;
			Если СтрНайти(Метка, "КПП") > 0 И ЗначениеЗаполнено(Значение) И Не КППСоответствуетФорматуЭПД(Значение) Тогда
				Issues.Добавить(ValidationIssueЭПД("detail.kpp.invalid", "warn", "«" + Метка + "»: неверный КПП.", Метка, FieldId));
				Summary.warnCount = Summary.warnCount + 1;
				Summary.ok = Ложь;
			КонецЕсли;
			Если СтрНайти(НРег(Метка), "адрес") > 0 И СтрДлина(Значение) > 5 Тогда
				Summary.externalCount = Summary.externalCount + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Issues.Количество() = 0 Тогда
		Summary.ok = Истина;
	КонецЕсли;
	Возврат Новый Структура("issues, summary", Issues, Summary);
КонецФункции

&НаСервере
Процедура ОбогатитьValidationПоляКарточкиЭПД(СтруктураДокумента)
	Если Не СтруктураДокумента.Свойство("detailFields") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Поле Из СтруктураДокумента.detailFields Цикл
		Если ТипЗнч(Поле) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Метка = СокрЛП(Строка(Поле.label));
		Значение = СокрЛП(Строка(Поле.value));
		Если СтрНайти(Метка, "ИНН") > 0 И ЗначениеЗаполнено(Значение) И Не ИННСоответствуетФорматуЭПД(Значение) Тогда
			Поле.Вставить("validationLevel", "error");
		ИначеЕсли СтрНайти(Метка, "КПП") > 0 И ЗначениеЗаполнено(Значение) И Не КППСоответствуетФорматуЭПД(Значение) Тогда
			Поле.Вставить("validationLevel", "warn");
		ИначеЕсли СтрНайти(НРег(Метка), "адрес") > 0 И СтрДлина(Значение) > 5 Тогда
			Поле.Вставить("validationLevel", "external");
			Поле.Вставить("externalCheck", "address");
		ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
			Поле.Вставить("validationLevel", "ok");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПрименитьValidationКСтруктуреДокументаЭПД(СтруктураДокумента, Подробно)
	Validation = ПостроитьValidationIssuesЭПД(СтруктураДокумента, Подробно);
	СтруктураДокумента.Вставить("validationIssues", Validation.issues);
	СтруктураДокумента.Вставить("validationSummary", Validation.summary);
	Если Подробно Тогда
		ОбогатитьValidationПоляКарточкиЭПД(СтруктураДокумента);
	КонецЕсли;
КонецПроцедуры
