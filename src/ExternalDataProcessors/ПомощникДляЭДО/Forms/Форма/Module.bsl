	Если ПустаяСтрока(ИдЭДО) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Абоненты.ИНН КАК ИНН,
	|	Абоненты.КПП КАК КПП,
	|	Абоненты.КраткоеОписание КАК Наименование
	|ИЗ
	|	РегистрСведений.АбонентыЭДО КАК Абоненты
	|ГДЕ
	|	Абоненты.ИдентификаторЭДО = &ИдЭДО";
	Запрос.УстановитьПараметр("ИдЭДО", ИдЭДО);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ИНН = Строка(Выборка.ИНН);
		Результат.КПП = Строка(Выборка.КПП);
		Результат.Наименование = Строка(Выборка.Наименование);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗаписатьJSONСтрокой(Значение)
	
	Настройки = Новый НастройкиСериализацииJSON;
	Настройки.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	Настройки.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.УниверсальнаяДата;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение, Настройки);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

#КонецОбласти
