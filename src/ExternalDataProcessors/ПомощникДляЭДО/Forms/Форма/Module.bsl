&НаСервере
Функция СтруктураДокументаИзРеестраЛегкая(Выборка)

	СсылкаДокумента = Выборка.Ссылка;
	ОрганизацияДокумента = Выборка.ОрганизацияСсылка;

	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("ref", Строка(СсылкаДокумента.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("docType", КодТипаДокументаЭПД(СсылкаДокумента));
	СтруктураДокумента.Вставить("docTypeName", НаименованиеТипаДокументаЭПД(СсылкаДокумента));
	СтруктураДокумента.Вставить("number", Строка(Выборка.НомерЭПД));
	СтруктураДокумента.Вставить("ibNumber", Строка(Выборка.НомерДокументаИБ));
	СтруктураДокумента.Вставить("date", ДатаСозданияДляJSONИзВыборки(Выборка));
	СтруктураДокумента.Вставить("comment", Строка(Выборка.Комментарий));
	СтруктураДокумента.Вставить("organization", Строка(Выборка.Организация));
	СтруктураДокумента.Вставить("organizationRef", ?(ЗначениеЗаполнено(ОрганизацияДокумента), Строка(ОрганизацияДокумента.УникальныйИдентификатор()), ""));
	СтруктураДокумента.Вставить("currentStep", Строка(Выборка.ТекущийШаг));
	СтруктураДокумента.Вставить("currentStepDone", Выборка.ТекущийШагВыполнен);
	СтруктураДокумента.Вставить("posted", Выборка.Проведен);
	СтруктураДокумента.Вставить("deletionMark", Выборка.ПометкаУдаления);
	СтруктураДокумента.Вставить("partiesPending", Истина);
	СтруктураДокумента.Вставить("shipper", СформироватьЯчейкуСтороныЛегкая(Выборка.Грузоотправитель, ОрганизацияДокумента));
	СтруктураДокумента.Вставить("consignee", СформироватьЯчейкуСтороныЛегкая(Выборка.Грузополучатель, ОрганизацияДокумента));
	СтруктураДокумента.Вставить("carrier", СформироватьЯчейкуСтороныЛегкая(Выборка.Перевозчик, ОрганизацияДокумента));

	СтруктураДокумента.Вставить("docFlowIds", Новый Массив);
	СтруктураДокумента.Вставить("edoDocumentRefs", Новый Массив);
	СтруктураДокумента.Вставить("organizationEdoId", "");
	СтруктураДокумента.Вставить("partyEdoIds", Новый Массив);
	СтруктураДокумента.Вставить("searchIndex", ПоисковыйИндексДокументаЭПД(СтруктураДокумента));

	Возврат СтруктураДокумента;

КонецФункции

&НаСервере
Функция СформироватьЯчейкуСтороныЛегкая(Участник, ОрганизацияДокумента)
	
	Имя = "";
	ИНН = "";
	КПП = "";
	
	Если ЗначениеЗаполнено(Участник) Тогда
		Имя = Строка(Участник);
	КонецЕсли;
	
	ЭтоНашаОрганизация = ЗначениеЗаполнено(Участник) И ЗначениеЗаполнено(ОрганизацияДокумента) И Участник = ОрганизацияДокумента;
	
	Ячейка = Новый Структура;
	Ячейка.Вставить("name", Имя);
	Ячейка.Вставить("inn", ИНН);
	Ячейка.Вставить("kpp", КПП);
	Ячейка.Вставить("edoId", "");
	Ячейка.Вставить("isOwnOrganization", ЭтоНашаОрганизация);
	
	Если ЗначениеЗаполнено(Участник) Тогда
		Ячейка.Вставить("entityRef", Строка(Участник.УникальныйИдентификатор()));
		Ячейка.Вставить("entityKind", ВидСсылкиУчастника(Участник));
	Иначе
		Ячейка.Вставить("entityRef", "");
		Ячейка.Вставить("entityKind", "");
	КонецЕсли;
	
	Если ЭтоНашаОрганизация Тогда
		Ячейка.Вставить("edoExchangeStatus", "own");
	Иначе
		Ячейка.Вставить("edoExchangeStatus", "pending");
	КонецЕсли;
	
	Возврат Ячейка;
	
КонецФункции

&НаСервере
Функция СтруктураДокументаИзРеестра(Выборка, Подробно)
	
	СсылкаДокумента = Выборка.Ссылка;
	ОрганизацияДокумента = Выборка.ОрганизацияСсылка;
	Идентификаторы = ИдентификаторыСторонИзДокумента(СсылкаДокумента);
	
	ИдОрганизации = ИдентификаторЭДООрганизации(ОрганизацияДокумента);
	ИдКонтрагентов = Новый Массив;
	ДобавитьИдентификаторВМассив(ИдКонтрагентов, Идентификаторы.shipper);
	ДобавитьИдентификаторВМассив(ИдКонтрагентов, Идентификаторы.consignee);
	ДобавитьИдентификаторВМассив(ИдКонтрагентов, Идентификаторы.carrier);
	Принятые = ПринятыеИдентификаторыЭДО(ИдОрганизации, ИдКонтрагентов);
	
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("ref", Строка(СсылкаДокумента.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("docType", КодТипаДокументаЭПД(СсылкаДокумента));
	СтруктураДокумента.Вставить("docTypeName", НаименованиеТипаДокументаЭПД(СсылкаДокумента));
	СтруктураДокумента.Вставить("number", Строка(Выборка.НомерЭПД));
	СтруктураДокумента.Вставить("ibNumber", Строка(Выборка.НомерДокументаИБ));
	СтруктураДокумента.Вставить("date", ДатаСозданияДляJSONИзВыборки(Выборка));
	СтруктураДокумента.Вставить("comment", Строка(Выборка.Комментарий));
	СтруктураДокумента.Вставить("organization", Строка(Выборка.Организация));
	СтруктураДокумента.Вставить("organizationRef", ?(ЗначениеЗаполнено(ОрганизацияДокумента), Строка(ОрганизацияДокумента.УникальныйИдентификатор()), ""));
	СтруктураДокумента.Вставить("currentStep", Строка(Выборка.ТекущийШаг));
	СтруктураДокумента.Вставить("currentStepDone", Выборка.ТекущийШагВыполнен);
	СтруктураДокумента.Вставить("posted", Выборка.Проведен);
	СтруктураДокумента.Вставить("deletionMark", Выборка.ПометкаУдаления);
	СтруктураДокумента.Вставить("shipper", СформироватьЯчейкуСтороны(Выборка.Грузоотправитель, Идентификаторы.shipper, ОрганизацияДокумента, ИдОрганизации, Принятые));
	СтруктураДокумента.Вставить("consignee", СформироватьЯчейкуСтороны(Выборка.Грузополучатель, Идентификаторы.consignee, ОрганизацияДокумента, ИдОрганизации, Принятые));
	СтруктураДокумента.Вставить("carrier", СформироватьЯчейкуСтороны(Выборка.Перевозчик, Идентификаторы.carrier, ОрганизацияДокумента, ИдОрганизации, Принятые));
	
	Если Подробно Тогда
		Попытка
			ДополнительныеПоля = ДополнительныеПоляДокументаЭПД(СсылкаДокумента);
			Для Каждого КлючЗначение Из ДополнительныеПоля Цикл
				СтруктураДокумента.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
			СтруктураДокумента.Вставить("diagnostics", ДиагностикаДокументаЭПД(СтруктураДокумента));
		Исключение
			СтруктураДокумента.Вставить("diagnostics", Новый Массив);
		КонецПопытки;
	Иначе
		Попытка
			КраткиеПоля = КраткиеПоляПоискаДокументаЭПД(СсылкаДокумента);
			Для Каждого КлючЗначение Из КраткиеПоля Цикл
				СтруктураДокумента.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	ОбогатитьПоисковыйИндексИКарточкуДокумента(СтруктураДокумента, СсылкаДокумента, ОрганизацияДокумента, ИдОрганизации, Идентификаторы, Подробно);
	
	Возврат СтруктураДокумента;
	
КонецФункции

&НаСервере
Функция СформироватьЯчейкуСтороны(Участник, ИдЭДО, ОрганизацияДокумента, ИдОрганизацииЭДО, Принятые)
	
	Имя = "";
	ИНН = "";
	КПП = "";
	
	Если ЗначениеЗаполнено(Участник) Тогда
		Имя = Строка(Участник);
		РеквизитыУчастника = РеквизитыУчастникаЭПД(Участник);
		ИНН = РеквизитыУчастника.ИНН;
		КПП = РеквизитыУчастника.КПП;
	КонецЕсли;
	
	Если ПустаяСтрока(Имя) И ЗначениеЗаполнено(ИдЭДО) Тогда
		РеквАбонента = РеквизитыАбонентаЭДО(ИдЭДО);
		Имя = РеквАбонента.Наименование;
		Если ПустаяСтрока(ИНН) Тогда
			ИНН = РеквАбонента.ИНН;
		КонецЕсли;
		Если ПустаяСтрока(КПП) Тогда
			КПП = РеквАбонента.КПП;
		КонецЕсли;
	КонецЕсли;
	
	ЭтоНашаОрганизация = ЭтоНашаОрганизацияВДокументе(Участник, ИдЭДО, ОрганизацияДокумента, ИдОрганизацииЭДО);
	
	Ячейка = Новый Структура;
	Ячейка.Вставить("name", Имя);
	Ячейка.Вставить("inn", ИНН);
	Ячейка.Вставить("kpp", КПП);
	Ячейка.Вставить("edoId", ИдЭДО);
	Ячейка.Вставить("isOwnOrganization", ЭтоНашаОрганизация);
	
	Если ЗначениеЗаполнено(Участник) Тогда
		Ячейка.Вставить("entityRef", Строка(Участник.УникальныйИдентификатор()));
		Ячейка.Вставить("entityKind", ВидСсылкиУчастника(Участник));
	Иначе
		Ячейка.Вставить("entityRef", "");
		Ячейка.Вставить("entityKind", "");
	КонецЕсли;
	
	Если ЭтоНашаОрганизация Тогда
		Ячейка.Вставить("edoExchangeStatus", "own");
	Иначе
		Ячейка.Вставить("edoExchangeStatus", СтатусОбменаЭДО(ОрганизацияДокумента, ИдЭДО, Принятые));
	КонецЕсли;
	
	Возврат Ячейка;
	
КонецФункции

&НаСервере
Функция ЭтоНашаОрганизацияВДокументе(Участник, ИдЭДО, ОрганизацияДокумента, ИдОрганизацииЭДО)
	
	Если ЗначениеЗаполнено(Участник) И ЗначениеЗаполнено(ОрганизацияДокумента) И Участник = ОрганизацияДокумента Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдЭДО) И ЗначениеЗаполнено(ИдОрганизацииЭДО) И ИдЭДО = ИдОрганизацииЭДО Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция РеквизитыУчастникаЭПД(Участник)
	
	Результат = Новый Структура("ИНН, КПП", "", "");
	Если Не ЗначениеЗаполнено(Участник) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		РеквУчастника = ОбменСГИСЭПД.ПолучитьРеквизитыУчастника(Участник);
		Результат.ИНН = Строка(?(ЗначениеЗаполнено(РеквУчастника.ЮЛ_ИНН), РеквУчастника.ЮЛ_ИНН, РеквУчастника.ИП_ИНН));
		Результат.КПП = Строка(РеквУчастника.ЮЛ_КПП);
	Исключение
		Попытка
			РеквКаталога = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Участник, "ИНН, КПП");
			Результат.ИНН = Строка(РеквКаталога.ИНН);
			Результат.КПП = Строка(РеквКаталога.КПП);
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ИдентификаторыСторонИзДокумента(СсылкаДокумента)
	
	Результат = Новый Структура("shipper, consignee, carrier", "", "", "");
	Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяДокумента = СсылкаДокумента.Метаданные().Имя;
	
	Если ИмяДокумента = "ЭлектроннаяТранспортнаяНакладная"
		Или ИмяДокумента = "ЭлектроннаяСопроводительнаяВедомость" Тогда
		
		ИменаРеквизитов = "ИдентификаторГрузоотправителя, ИдентификаторГрузополучателя, ИдентификаторПеревозчика";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.shipper = Строка(Реквизиты.ИдентификаторГрузоотправителя);
		Результат.consignee = Строка(Реквизиты.ИдентификаторГрузополучателя);
		Результат.carrier = Строка(Реквизиты.ИдентификаторПеревозчика);
		
	ИначеЕсли ИмяДокумента = "ЭлектронныйЗаказЗаявка" Тогда
		
		ИменаРеквизитов = "ИдентификаторГрузоотправителя, ИдентификаторПеревозчика";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.shipper = Строка(Реквизиты.ИдентификаторГрузоотправителя);
		Результат.carrier = Строка(Реквизиты.ИдентификаторПеревозчика);
		
	ИначеЕсли ИмяДокумента = "ЭлектронныйЗаказНаряд"
		Или ИмяДокумента = "ЭлектронныйДоговорФрахтования" Тогда
		
		ИменаРеквизитов = "ИдентификаторФрахтователя, ИдентификаторФрахтовщика";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.shipper = Строка(Реквизиты.ИдентификаторФрахтователя);
		Результат.carrier = Строка(Реквизиты.ИдентификаторФрахтовщика);
		
	ИначеЕсли ИмяДокумента = "ЭлектронныйПутевойЛист" Тогда
		
		ИменаРеквизитов = "ИдентификаторОформителя, ИдентификаторМедорганизации, ИдентификаторТехконтроль";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.shipper = Строка(Реквизиты.ИдентификаторОформителя);
		Результат.consignee = Строка(Реквизиты.ИдентификаторМедорганизации);
		Результат.carrier = Строка(Реквизиты.ИдентификаторТехконтроль);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДополнительныеПоляДокументаЭПД(СсылкаДокумента)
	
	Результат = Новый Структура;
	ИмяДокумента = СсылкаДокумента.Метаданные().Имя;
	
	Если ИмяДокумента = "ЭлектроннаяТранспортнаяНакладная" Тогда
		
		ИменаРеквизитов = "УИДМинтранс, ЭтоВходящий, ТитулГрузоотправителяТранспортнаяНакладнаяНомер,
			|ТитулГрузоотправителяТранспортнаяНакладнаяДата, ТитулГрузоотправителяДатаФормированияФайла,
			|ТитулПеревозчикаПриемкаДатаФормированияФайла, ТитулГрузополучателяДатаФормированияФайла,
			|ТитулПеревозчикаВыдачаДатаФормированияФайла, РольУчастника, ИныеПолучателиСтрока,
			|ТитулГрузоотправителяИдентификаторФайла, ТитулПеревозчикаПриемкаИдентификаторФайла,
			|ТитулГрузополучателяИдентификаторФайла, ТитулПеревозчикаВыдачаИдентификаторФайла";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.Вставить("uidMintrans", Строка(Реквизиты.УИДМинтранс));
		Результат.Вставить("isIncoming", Реквизиты.ЭтоВходящий);
		Результат.Вставить("waybillNumber", Строка(Реквизиты.ТитулГрузоотправителяТранспортнаяНакладнаяНомер));
		Результат.Вставить("waybillDate", ?(ЗначениеЗаполнено(Реквизиты.ТитулГрузоотправителяТранспортнаяНакладнаяДата),
			XMLСтрока(Реквизиты.ТитулГрузоотправителяТранспортнаяНакладнаяДата), ""));
		Результат.Вставить("roleParticipant", Строка(Реквизиты.РольУчастника));
		Результат.Вставить("otherRecipients", Строка(Реквизиты.ИныеПолучателиСтрока));
		Результат.Вставить("titleFileIds", МассивИдентификаторовТитуловЭТН(Реквизиты));
		
		Результат.Вставить("titleDates", МассивДатТитуловЭТН(Реквизиты));
		
	Иначе
		
		Попытка
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, "УИДМинтранс, ЭтоВходящий, РольУчастника");
			Результат.Вставить("uidMintrans", Строка(Реквизиты.УИДМинтранс));
			Результат.Вставить("isIncoming", Реквизиты.ЭтоВходящий);
			Результат.Вставить("roleParticipant", Строка(Реквизиты.РольУчастника));
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция МассивИдентификаторовТитуловЭТН(Реквизиты)
	
	Результат = Новый Массив;
	ДобавитьИдентификаторВМассивСтрок(Результат, Строка(Реквизиты.ТитулГрузоотправителяИдентификаторФайла));
	ДобавитьИдентификаторВМассивСтрок(Результат, Строка(Реквизиты.ТитулПеревозчикаПриемкаИдентификаторФайла));
	ДобавитьИдентификаторВМассивСтрок(Результат, Строка(Реквизиты.ТитулГрузополучателяИдентификаторФайла));
	ДобавитьИдентификаторВМассивСтрок(Результат, Строка(Реквизиты.ТитулПеревозчикаВыдачаИдентификаторФайла));
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьИдентификаторВМассивСтрок(МассивСтрок, Значение)
	
	Значение = СокрЛП(Значение);
	Если ПустаяСтрока(Значение) Тогда
		Возврат;
	КонецЕсли;
	МассивСтрок.Добавить(Значение);
	
КонецПроцедуры

&НаСервере
Функция КраткиеПоляПоискаДокументаЭПД(СсылкаДокумента)
	
	Результат = Новый Структура;
	ИмяДокумента = СсылкаДокумента.Метаданные().Имя;
	
	Если ИмяДокумента = "ЭлектроннаяТранспортнаяНакладная" Тогда
		Попытка
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента,
				"УИДМинтранс, ИныеПолучателиСтрока,
				|ТитулГрузоотправителяИдентификаторФайла, ТитулПеревозчикаПриемкаИдентификаторФайла,
				|ТитулГрузополучателяИдентификаторФайла, ТитулПеревозчикаВыдачаИдентификаторФайла");
			Результат.Вставить("uidMintrans", Строка(Реквизиты.УИДМинтранс));
			Результат.Вставить("otherRecipients", Строка(Реквизиты.ИныеПолучателиСтрока));
			Результат.Вставить("titleFileIds", МассивИдентификаторовТитуловЭТН(Реквизиты));
		Исключение
		КонецПопытки;
	Иначе
		Попытка
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, "УИДМинтранс");
			Результат.Вставить("uidMintrans", Строка(Реквизиты.УИДМинтранс));
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ИдентификаторыСвязанныхЭДО(СсылкаДокумента)
	
	Результат = Новый Структура("docFlowIds, edoDocumentRefs", Новый Массив, Новый Массив);
	
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ОбъектУчета", СсылкаДокумента);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Связь.ЭлектронныйДокумент КАК ЭлектронныйДокумент
		|ИЗ
		|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК Связь
		|ГДЕ
		|	Связь.ОбъектУчета = &ОбъектУчета";
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЭДО = Выборка.ЭлектронныйДокумент;
			Если Не ЗначениеЗаполнено(ЭДО) Тогда
				Продолжить;
			КонецЕсли;
			
			Результат.edoDocumentRefs.Добавить(Строка(ЭДО.УникальныйИдентификатор()));
			
			Попытка
				ИдДО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭДО, "ИдентификаторДокументооборота");
				ДобавитьИдентификаторВМассивСтрок(Результат.docFlowIds, Строка(ИдДО));
			Исключение
			КонецПопытки;
		КонецЦикла;
	Исключение
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОбогатитьПоисковыйИндексИКарточкуДокумента(СтруктураДокумента, СсылкаДокумента, ОрганизацияДокумента, ИдОрганизации, ИдентификаторыСторон, Подробно)
	
	СвязанныеЭДО = ИдентификаторыСвязанныхЭДО(СсылкаДокумента);
	СтруктураДокумента.Вставить("docFlowIds", СвязанныеЭДО.docFlowIds);
	СтруктураДокумента.Вставить("edoDocumentRefs", СвязанныеЭДО.edoDocumentRefs);
	СтруктураДокумента.Вставить("organizationEdoId", СокрЛП(ИдОрганизации));
	СтруктураДокумента.Вставить("partyEdoIds", МассивИдентификаторовСторонДокумента(ИдентификаторыСторон));
	
	СтруктураДокумента.Вставить("searchIndex", ПоисковыйИндексДокументаЭПД(СтруктураДокумента));
	
	Если Подробно Тогда
		СтруктураДокумента.Вставить("detailFields", ПоляКарточкиДокументаЭПД(СтруктураДокумента, СсылкаДокумента));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция МассивИдентификаторовСторонДокумента(ИдентификаторыСторон)
	
	Результат = Новый Массив;
	ДобавитьИдентификаторВМассивСтрок(Результат, ИдентификаторыСторон.shipper);
	ДобавитьИдентификаторВМассивСтрок(Результат, ИдентификаторыСторон.consignee);
	ДобавитьИдентификаторВМассивСтрок(Результат, ИдентификаторыСторон.carrier);
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПоисковыйИндексДокументаЭПД(СтруктураДокумента)
	
	Части = Новый Массив;
	ДобавитьТекстВПоисковыйИндекс(Части, СтруктураДокумента.ref);
	ДобавитьТекстВПоисковыйИндекс(Части, СтруктураДокумента.organizationRef);
	ДобавитьТекстВПоисковыйИндекс(Части, ЗначениеПоляСтруктурыДокумента(СтруктураДокумента, "organizationEdoId"));
	ДобавитьТекстВПоисковыйИндекс(Части, ЗначениеПоляСтруктурыДокумента(СтруктураДокумента, "uidMintrans"));
	ДобавитьТекстВПоисковыйИндекс(Части, ЗначениеПоляСтруктурыДокумента(СтруктураДокумента, "otherRecipients"));
	ДобавитьТекстВПоисковыйИндекс(Части, СтруктураДокумента.number);
	ДобавитьТекстВПоисковыйИндекс(Части, СтруктураДокумента.ibNumber);
	ДобавитьТекстВПоисковыйИндекс(Части, СтруктураДокумента.docType);
	ДобавитьТекстВПоисковыйИндекс(Части, СтруктураДокумента.docTypeName);
	ДобавитьТекстВПоисковыйИндекс(Части, СтруктураДокумента.organization);
	ДобавитьТекстВПоисковыйИндекс(Части, СтруктураДокумента.currentStep);
	ДобавитьТекстВПоисковыйИндекс(Части, СтруктураДокумента.comment);
	ДобавитьТекстВПоисковыйИндекс(Части, ЗначениеПоляСтруктурыДокумента(СтруктураДокумента, "waybillNumber"));
	
	ДобавитьМассивВПоисковыйИндекс(Части, JSONМассивСтрокНаСервере(СтруктураДокумента, "docFlowIds"));
	ДобавитьМассивВПоисковыйИндекс(Части, JSONМассивСтрокНаСервере(СтруктураДокумента, "edoDocumentRefs"));
	ДобавитьМассивВПоисковыйИндекс(Части, JSONМассивСтрокНаСервере(СтруктураДокумента, "partyEdoIds"));
	ДобавитьМассивВПоисковыйИндекс(Части, JSONМассивСтрокНаСервере(СтруктураДокумента, "titleFileIds"));
	
	ИменаСторон = Новый Массив;
	ИменаСторон.Добавить("shipper");
	ИменаСторон.Добавить("consignee");
	ИменаСторон.Добавить("carrier");
	Для Каждого Ключ Из ИменаСторон Цикл
		Если СтруктураДокумента.Свойство(Ключ) Тогда
			Ячейка = СтруктураДокумента[Ключ];
			ДобавитьТекстВПоисковыйИндекс(Части, Ячейка.name);
			ДобавитьТекстВПоисковыйИндекс(Части, Ячейка.inn);
			ДобавитьТекстВПоисковыйИндекс(Части, Ячейка.kpp);
			ДобавитьТекстВПоисковыйИндекс(Части, Ячейка.edoId);
			ДобавитьТекстВПоисковыйИндекс(Части, Ячейка.entityRef);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(Части, " ");
	
КонецФункции



&НаСервере
Процедура ДобавитьТекстВПоисковыйИндекс(Части, Значение)
	
	Значение = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Значение) Тогда
		Возврат;
	КонецЕсли;
	
	Части.Добавить(Значение);
	Части.Добавить(НормализоватьТекстПоискаНаСервере(Значение));
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьМассивВПоисковыйИндекс(Части, МассивЗначений)
	
	Если МассивЗначений = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из МассивЗначений Цикл
		ДобавитьТекстВПоисковыйИндекс(Части, Элемент);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НормализоватьТекстПоискаНаСервере(Текст)
	
	Результат = НРег(СокрЛП(Текст));
	Результат = СтрЗаменить(Результат, "-", "");
	Результат = СтрЗаменить(Результат, "{", "");
	Результат = СтрЗаменить(Результат, "}", "");
	Результат = СтрЗаменить(Результат, " ", "");
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция JSONМассивСтрокНаСервере(СтруктураДокумента, ИмяПоля)
	
	Если Не СтруктураДокумента.Свойство(ИмяПоля) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Значение = СтруктураДокумента[ИмяПоля];
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;
	
	Возврат Новый Массив;
	
КонецФункции

&НаСервере
Функция ПоляКарточкиДокументаЭПД(СтруктураДокумента, СсылкаДокумента)
	
	Поля = Новый Массив;
	ДобавитьПолеКарточки(Поля, "Идентификация", "Ссылка документа (ИБ)", СтруктураДокумента.ref);
	ДобавитьПолеКарточки(Поля, "Идентификация", "Тип", СтруктураДокумента.docTypeName);
	ДобавитьПолеКарточки(Поля, "Идентификация", "Код типа", СтруктураДокумента.docType);
	ДобавитьПолеКарточки(Поля, "Идентификация", "Номер ЭПД", СтруктураДокумента.number);
	ДобавитьПолеКарточки(Поля, "Идентификация", "Номер в ИБ", СтруктураДокумента.ibNumber);
	ДобавитьПолеКарточки(Поля, "Идентификация", "Организация", СтруктураДокумента.organization);
	ДобавитьПолеКарточки(Поля, "Идентификация", "Ссылка организации", СтруктураДокумента.organizationRef);
	ДобавитьПолеКарточки(Поля, "Идентификация", "ID ЭДО организации", ЗначениеПоляСтруктурыДокумента(СтруктураДокумента, "organizationEdoId"));
	ДобавитьПолеКарточки(Поля, "Идентификация", "УИД Минтранс", ЗначениеПоляСтруктурыДокумента(СтруктураДокумента, "uidMintrans"));
	
	ДобавитьПоляМассиваВКарточку(Поля, "Документооборот ЭДО", "Идентификатор документооборота", JSONМассивСтрокНаСервере(СтруктураДокумента, "docFlowIds"));
	ДобавитьПоляМассиваВКарточку(Поля, "Документооборот ЭДО", "Ссылка электронного документа ЭДО", JSONМассивСтрокНаСервере(СтруктураДокумента, "edoDocumentRefs"));
	
	ДобавитьПолеКарточки(Поля, "Участники", "ID грузоотправителя (из док.)", ИдентификаторЯчейкиСтороны(СтруктураДокумента, "shipper"));
	ДобавитьПолеКарточки(Поля, "Участники", "ID перевозчика (из док.)", ИдентификаторЯчейкиСтороны(СтруктураДокумента, "carrier"));
	ДобавитьПолеКарточки(Поля, "Участники", "ID грузополучателя / получателя (из док.)", ИдентификаторЯчейкиСтороны(СтруктураДокумента, "consignee"));
	
	ДобавитьПоляСтороныВКарточку(Поля, "Грузоотправитель", СтруктураДокумента.shipper);
	ДобавитьПоляСтороныВКарточку(Поля, "Перевозчик", СтруктураДокумента.carrier);
	ДобавитьПоляСтороныВКарточку(Поля, "Грузополучатель", СтруктураДокумента.consignee);
	
	ДобавитьПолеКарточки(Поля, "ЭТрН", "Иные получатели", ЗначениеПоляСтруктурыДокумента(СтруктураДокумента, "otherRecipients"));
	ДобавитьПоляМассиваВКарточку(Поля, "ЭТрН", "Идентификатор файла титула", JSONМассивСтрокНаСервере(СтруктураДокумента, "titleFileIds"));
	ДобавитьПолеКарточки(Поля, "ЭТрН", "Номер ТН", ЗначениеПоляСтруктурыДокумента(СтруктураДокумента, "waybillNumber"));
	ДобавитьПолеКарточки(Поля, "ЭТрН", "Дата ТН", ЗначениеПоляСтруктурыДокумента(СтруктураДокумента, "waybillDate"));
	ДобавитьПолеКарточки(Поля, "ЭТрН", "Входящий", Строка(БулевоПоляСтруктурыДокумента(СтруктураДокумента, "isIncoming")));
	ДобавитьПолеКарточки(Поля, "ЭТрН", "Роль участника", ЗначениеПоляСтруктурыДокумента(СтруктураДокумента, "roleParticipant"));
	ДобавитьПолеКарточки(Поля, "Состояние", "Текущий шаг", СтруктураДокумента.currentStep);
	ДобавитьПолеКарточки(Поля, "Состояние", "Шаг выполнен", ?(СтруктураДокумента.currentStepDone, "Да", "Нет"));
	ДобавитьПолеКарточки(Поля, "Состояние", "Проведён", ?(СтруктураДокумента.posted, "Да", "Нет"));
	ДобавитьПолеКарточки(Поля, "Состояние", "Пометка удаления", ?(СтруктураДокумента.deletionMark, "Да", "Нет"));
	ДобавитьПолеКарточки(Поля, "Комментарий", "Комментарий", СтруктураДокумента.comment);
	
	Если СтруктураДокумента.Свойство("titleDates") Тогда
		Для Каждого Элемент Из СтруктураДокумента.titleDates Цикл
			ДобавитьПолеКарточки(Поля, "Даты титулов", Элемент.key, Элемент.value);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Поля;
	
КонецФункции

