&НаКлиенте
Функция РазобратьКомандуМостаНаКлиенте(Href)
	
	ПозицияQuery = СтрНайти(Href, "?");
	Если ПозицияQuery = 0 Тогда
		ВызватьИсключение "В команде моста отсутствуют параметры";
	КонецЕсли;
	
	ПараметрыЗапроса = ПараметрыЗапросаИзСтрокиНаКлиенте(Сред(Href, ПозицияQuery + 1));
	Действие = ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, "action");
	
	Если ПустаяСтрока(Действие) Тогда
		ВызватьИсключение "В команде моста отсутствует параметр action";
	КонецЕсли;
	
	Команда = Новый Структура;
	Команда.Вставить("Действие", Действие);
	Команда.Вставить("Ref", ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, "ref"));
	Команда.Вставить("DocType", ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, "docType"));
	Команда.Вставить("Comment", ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, "comment"));
	Команда.Вставить("EdoId", ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, "edoId"));
	Команда.Вставить("OrgRef", ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, "orgRef"));
	Команда.Вставить("EntityRef", ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, "entityRef"));
	Команда.Вставить("Offset", ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, "offset"));
	Команда.Вставить("Limit", ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, "limit"));
	Команда.Вставить("Refs", ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, "refs"));
	Команда.Вставить("TargetPath", ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, "targetPath"));
	Команда.Вставить("ReleaseVer", ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, "releaseVer"));
	Команда.Вставить("EpfUrl", ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, "epfUrl"));
	
	Возврат Команда;
	
КонецФункции

&НаКлиенте
Функция ПараметрыЗапросаИзСтрокиНаКлиенте(QueryString)
	
	Результат = Новый Соответствие;
	
	Для Каждого Часть Из СтрРазделить(QueryString, "&", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Имя = Сред(Часть, 1, Позиция - 1);
		Значение = РаскодироватьПроцентыURLНаКлиенте(Сред(Часть, Позиция + 1));
		Результат.Вставить(Имя, Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ЗначениеПараметраЗапросаНаКлиенте(ПараметрыЗапроса, Имя)
	
	Значение = ПараметрыЗапроса.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаКлиенте
Функция РаскодироватьПроцентыURLНаКлиенте(Знач Строка)
	
	// РаскодироватьСтроку недоступна в &НаКлиенте (тонкий клиент) — только на сервере без контекста.
	Возврат РаскодироватьПроцентыURLБезКонтекста(Строка);
	
КонецФункции

&НаКлиенте
Функция JSONСтрокаПоляНаКлиенте(ДанныеJSON, ИмяПоля)
	
	Если ДанныеJSON = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(ДанныеJSON) = Тип("Структура") Тогда
		Если ДанныеJSON.Свойство(ИмяПоля) Тогда
			Возврат Строка(ДанныеJSON[ИмяПоля]);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеJSON) = Тип("Соответствие") Тогда
		Значение = ДанныеJSON.Получить(ИмяПоля);
		Если Значение <> Неопределено Тогда
			Возврат Строка(Значение);
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти

#Область СерверныеAPI

&НаСервере
Функция РазобратьКомандуМостаНаСервере(Href)
	
	ПозицияQuery = СтрНайти(Href, "?");
	Если ПозицияQuery = 0 Тогда
		ВызватьИсключение "В команде моста отсутствуют параметры";
	КонецЕсли;
	
	ПараметрыЗапроса = ПараметрыЗапросаИзСтроки(Сред(Href, ПозицияQuery + 1));
	Действие = ЗначениеПараметраЗапроса(ПараметрыЗапроса, "action");
	
	Если ПустаяСтрока(Действие) Тогда
		ВызватьИсключение "В команде моста отсутствует параметр action";
	КонецЕсли;
	
	Команда = Новый Структура;
	Команда.Вставить("Действие", Действие);
	Команда.Вставить("Ref", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "ref"));
	Команда.Вставить("DocType", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "docType"));
	Команда.Вставить("Comment", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "comment"));
	Команда.Вставить("EdoId", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "edoId"));
	Команда.Вставить("OrgRef", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "orgRef"));
	Команда.Вставить("EntityRef", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "entityRef"));
	Команда.Вставить("Offset", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "offset"));
	Команда.Вставить("Limit", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "limit"));
	Команда.Вставить("Refs", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "refs"));
	Команда.Вставить("TargetPath", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "targetPath"));
	Команда.Вставить("ReleaseVer", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "releaseVer"));
	Команда.Вставить("EpfUrl", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "epfUrl"));
	
	Возврат Команда;
	
КонецФункции

&НаСервере
Функция ПараметрыЗапросаИзСтроки(QueryString)
	
	Результат = Новый Соответствие;
	
	Для Каждого Часть Из СтрРазделить(QueryString, "&", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Имя = Сред(Часть, 1, Позиция - 1);
		Значение = РаскодироватьПроцентыURL(Сред(Часть, Позиция + 1));
		Результат.Вставить(Имя, Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗначениеПараметраЗапроса(ПараметрыЗапроса, Имя)
	
	Значение = ПараметрыЗапроса.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗаписатьJSONСтрокойБезКонтекста(Значение)
	
	Настройки = Новый НастройкиСериализацииJSON;
	Настройки.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	Настройки.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.УниверсальнаяДата;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение, Настройки);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

&НаСервереБезКонтекста
Функция РазобратьJSONСтруктуруБезКонтекста(JSON)
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(JSON);
		Возврат ПрочитатьJSON(ЧтениеJSON, Ложь);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаСервереБезКонтекста
Функция РаскодироватьПроцентыURLБезКонтекста(Знач Строка)
	
	// КодировкаURL корректно раскодирует UTF-8 (%D0%A7…), в отличие от посимвольного Символ().
	Результат = РаскодироватьСтроку(Строка, СпособКодированияСтроки.КодировкаURL);
	// Пробелы в query-string часто приходят как «+».
	Возврат СтрЗаменить(Результат, "+", " ");
	
КонецФункции

&НаСервере
Функция РаскодироватьПроцентыURL(Знач Строка)
	
	Возврат РаскодироватьПроцентыURLБезКонтекста(Строка);
	
КонецФункции

