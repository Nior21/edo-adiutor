&НаКлиенте
Процедура ОткрытьТранспортныеНастройкиЭДОПоМосту(OrgRef, EntityRef, EdoId)
	
	Данные = ДанныеДляТранспортныхНастроекНаСервере(OrgRef, EntityRef);
	Если Не Данные.Успех Тогда
		СообщитьBridgeОшибку(Данные.Сообщение);
		Возврат;
	КонецЕсли;
	
	Попытка
		ПараметрыВыбора = НастройкиОтправкиЭДОСлужебныйКлиент.НовыеПараметрыТранспортныхНастроек();
		ПараметрыВыбора.КлючНастроек.Отправитель = Данные.Организация;
		ПараметрыВыбора.КлючНастроек.Получатель = Данные.Контрагент;
		ПараметрыВыбора.ИдентификаторОтправителя = Данные.ИдОрганизации;
