#Область ОписаниеПеременных

// Установите Истина для сообщений о загрузке React в окне 1С (диагностика).
&НаКлиенте
Перем ОтладкаReact;

&НаКлиенте
Перем ReactГотов;

&НаКлиенте
Перем ОчередьRefДокумента;

&НаКлиенте
Перем ОчередьDocTypeДокумента;

&НаКлиенте
Перем ОчередьДиагностикаOrgRef;

&НаКлиенте
Перем ОчередьДиагностикаEntityRef;

&НаКлиенте
Перем ОчередьДиагностикаCurrentEdoId;

&НаКлиенте
Перем ОчередьДиагностикаРежим;

&НаКлиенте
Перем ОкноПомеченоУстаревшим;

&НаКлиенте
Перем ОчередьПереключенияВерсии;

&НаКлиенте
Перем ОчередьApplyTargetPath;

&НаКлиенте
Перем ОчередьApplyReleaseVer;

&НаКлиенте
Перем ОчередьApplyEpfUrl;

&НаКлиенте
Перем ПутьПоследнегоРелизаEpf;

&НаКлиенте
Перем МостПриостановлен;

&НаКлиенте
Перем ОжидаемReadyПослеПерезагрузки;

&НаСервере
Перем КэшСсылокЭПДUUID;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.АдресHTML = "";
	Объект.АдресМакета = "";
	ПолеHTML = "";
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработатьПараметрыОткрытияEpfНаСервере();
	ОбеспечитьПутьEpfИзИспользуемогоИмениНаСервере();
	
	Попытка
		ЗагрузитьReactМакетОбработкиВФормуНаСервере(ОбработкаОбъект);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписатьДиагностикуReact("Ошибка загрузки макета React: " + ТекстОшибки, Истина);
		ОбщегоНазначения.СообщитьПользователю(
			"Макет ReactПриложение не найден или пуст. Выполните scripts/pack.ps1 и обновите макет в EDT.");
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ReactГотов = Ложь;
	ОтладкаReact = Ложь;
	ОкноПомеченоУстаревшим = Ложь;
	МостПриостановлен = Ложь;
	ОжидаемReadyПослеПерезагрузки = Ложь;
	ПутьПоследнегоРелизаEpf = "";
	ПрименитьОтложеннуюПодменуЯкоряНаКлиенте();
	
	Если ПустаяСтрока(Объект.АдресHTML) Тогда
		ПолеHTML = HTMLСтраницаДиагностики("HTML React UI не загружен на сервере. Выполните pack.ps1 и F7.");
		Возврат;
	КонецЕсли;
	
	РезультатЗагрузки = ПолучитьReactHTMLНаСервере();
	Если РезультатЗагрузки.Успех Тогда
		ПолеHTML = РезультатЗагрузки.HTML;
	Иначе
		ПолеHTML = HTMLСтраницаДиагностики(РезультатЗагрузки.Сообщение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеHTMLДокументСформирован(Элемент)
	
	Если Элементы.ПолеHTML.Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ПолеHTML.Документ.readyState <> "complete" Тогда
		Возврат;
	КонецЕсли;
	
	// Резерв, если action=ready из JS не пришёл.
	ПодключитьОбработчикОжидания("ОтложеннаяИнициализацияReact", 2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Если ДанныеСобытия = Неопределено Или Не ЗначениеЗаполнено(ДанныеСобытия.Href) Тогда
		Возврат;
	КонецЕсли;
	
	Href = ДанныеСобытия.Href;
	Если Не СтрНачинаетсяС(НРег(Href), "onec:") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ОбработатьКомандуМоста(Href);
	
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаReact

&НаСервере
Процедура ЗагрузитьReactМакетОбработкиВФормуНаСервере(ОбработкаОбъект)
	
	ДвоичныеДанныеМакета = ОбработкаОбъект.ПолучитьМакет(ОбработкаОбъект.ИмяМакетаReact());
	
	Если ДвоичныеДанныеМакета = Неопределено Или ДвоичныеДанныеМакета.Размер() = 0 Тогда
		ВызватьИсключение "Макет React пуст";
	КонецЕсли;
	
	// Inline HTML (CSS + IIFE JS в одном файле). Идентификатор формы — для чтения на клиенте.
	Объект.АдресHTML = ПоместитьВоВременноеХранилище(ДвоичныеДанныеМакета, УникальныйИдентификатор);
	ЗаписатьДиагностикуReact(
		"HTML React UI помещён во временное хранилище. Размер: "
		+ Формат(ДвоичныеДанныеМакета.Размер(), "ЧГ=0")
		+ ", версия UI: "
		+ ОбработкаОбъект.ВерсияПриложения());
	
КонецПроцедуры

&НаСервере
Функция ПрименитьПодключеннуюEpfНаСервере(ИмяПодключения)
	
	Результат = Новый Структура("Успех, Сообщение", Ложь, "");
	ИмяПодключения = СокрЛП(ИмяПодключения);
	Если ПустаяСтрока(ИмяПодключения) Тогда
		Результат.Сообщение = "Пустое имя подключения .epf";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ОбработкаОбъект = ВнешниеОбработки.Создать(ИмяПодключения);
	Исключение
		Результат.Сообщение = "ВнешниеОбработки.Создать: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
	Попытка
		ЗагрузитьReactМакетОбработкиВФормуНаСервере(ОбработкаОбъект);
	Исключение
		Результат.Сообщение = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	Результат.Успех = Истина;
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПереподключитьОбъектEpfНаСервере(ПутьEpf)
	
	РезультатПодключения = ПодключитьEpfФайлНаСервере(ПутьEpf);
	Если Не РезультатПодключения.Успех Тогда
		Возврат Новый Структура("Успех, Сообщение", Ложь, РезультатПодключения.Сообщение);
	КонецЕсли;
	
	Возврат ПрименитьПодключеннуюEpfНаСервере(РезультатПодключения.ИмяПодключения);
	
КонецФункции

&НаКлиенте
Функция ОбновитьОбработкуИReactИзФайлаНаКлиенте(ПутьEpf)

	ПутьEpf = СокрЛП(ПутьEpf);
	Если ПустаяСтрока(ПутьEpf) Тогда
		Возврат Ложь;
	КонецЕсли;

	Результат = ПереподключитьОбъектEpfНаСервере(ПутьEpf);
	Если Не Результат.Успех Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПерезагрузитьReactИнтерфейсНаКлиенте();

КонецФункции
&НаКлиенте
Функция ПерезагрузитьReactИнтерфейсНаКлиенте()
	
	ReactГотов = Ложь;
	ОкноПомеченоУстаревшим = Ложь;
	
	РезультатЗагрузки = ПолучитьReactHTMLНаСервере();
	Если РезультатЗагрузки.Успех Тогда
		ПолеHTML = РезультатЗагрузки.HTML;
		Возврат Истина;
	КонецЕсли;
	
	ПолеHTML = HTMLСтраницаДиагностики(РезультатЗагрузки.Сообщение);
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ПерезагрузитьТекущуюФормуИзEpfНаКлиенте(ПутьEpf)
	
	ПутьEpf = СокрЛП(ПутьEpf);
	Если ПустаяСтрока(ПутьEpf) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = ПереподключитьОбъектEpfНаСервере(ПутьEpf);
	Если Не Результат.Успех И Не ЭтоВебКлиентПомощникаНаКлиенте() Тогда
		Попытка
			Двоичные = Новый ДвоичныеДанные(ПутьEpf);
			РезультатДвоичные = ПодключитьEpfИзДвоичныхНаСервере(Двоичные);
			Если РезультатДвоичные.Успех Тогда
				Результат = ПрименитьПодключеннуюEpfНаСервере(РезультатДвоичные.ИмяПодключения);
			Иначе
				Результат = Новый Структура("Успех, Сообщение", Ложь, РезультатДвоичные.Сообщение);
			КонецЕсли;
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Если Не Результат.Успех Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ПерезагрузитьReactИнтерфейсНаКлиенте();
	
КонецФункции

&НаСервере
Функция ПолучитьReactHTMLНаСервере()
	
	Результат = Новый Структура("Успех, HTML, Сообщение", Ложь, "", "");
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат.Сообщение = "Версия UI: " + ОбработкаОбъект.ВерсияПриложения();
	
	Если ПустаяСтрока(Объект.АдресHTML) Тогда
		Результат.Сообщение = Результат.Сообщение + ". АдресHTML пуст. Обновите базу из EDT.";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ДвоичныеДанныеМакета = ПолучитьИзВременногоХранилища(Объект.АдресHTML);
		ТекстHTML = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеМакета, КодировкаТекста.UTF8);
		Размер = СтрДлина(ТекстHTML);
		
		Если Размер < 1000 Тогда
			Результат.Сообщение = "Макет слишком мал (" + Формат(Размер, "ЧГ=0") + " симв.). Пересоберите pack.ps1.";
			Возврат Результат;
		КонецЕсли;
		
		Если СтрНайти(НРег(ТекстHTML), "<html") = 0 Тогда
			Результат.Сообщение = "Макет не похож на HTML (нет тега html). Проверьте Template.bin.";
			Возврат Результат;
		КонецЕсли;
		
		Если СтрНайти(НРег(ТекстHTML), "type=""module""") > 0
			Или СтрНайти(НРег(ТекстHTML), "type='module'") > 0 Тогда
			Результат.Сообщение = "В макете найден type=module — WebKit 1С его не выполняет. Пересоберите pack.ps1.";
			Возврат Результат;
		КонецЕсли;
		
		Результат.HTML = ТекстHTML;
		Результат.Успех = Истина;
		Результат.Сообщение = Результат.Сообщение
			+ ". Inline HTML, длина "
			+ Формат(Размер, "ЧГ=0")
			+ " симв.";
	Исключение
		Результат.Сообщение = "Ошибка чтения HTML из временного хранилища: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОтложеннаяИнициализацияReact() Экспорт
	
	Если ReactГотов Тогда
		Возврат;
	КонецЕсли;
	
	ЛогReact("Резервная инициализация React (ready не пришёл)");
	ReactГотов = Истина;
	СообщитьBridgeСтатус("Подключено (резерв)");
	
КонецПроцедуры

&НаКлиенте
Процедура ЛогReact(Текст, Всегда = Ложь)
	
	Если Всегда Или ОтладкаReact Тогда
		Сообщить("[ПомощникЭДО] " + Текст);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДиагностикуReact(Текст, ЭтоОшибка = Ложь)
	
	Уровень = ?(ЭтоОшибка, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация);
	ЗаписьЖурналаРегистрации("ПомощникДляЭДО.React", Уровень, , , Текст);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция HTMLСтраницаДиагностики(ТекстОшибки)
	
	Текст = СтрЗаменить(ТекстОшибки, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	
	Возврат "<!DOCTYPE html><html lang=""ru""><head><meta charset=""UTF-8""><title>Помощник ЭДО</title></head>"
		+ "<body style=""font-family:Segoe UI,sans-serif;padding:16px;background:#fff8f0"">"
		+ "<h2 style=""color:#c00;margin-top:0"">Помощник ЭДО — диагностика</h2>"
		+ "<p>" + Текст + "</p>"
		+ "<p>1. scripts/pack.ps1<br>2. Обновление конфигурации в EDT<br>3. Открыть обработку из обновлённой базы</p>"
		+ "</body></html>";
	
КонецФункции

#КонецОбласти

#Область МостReact

&НаКлиенте
Функция View()
	
	Если Элементы.ПолеHTML.Документ = Неопределено Тогда
		ВызватьИсключение "HTML-документ не создан";
	КонецЕсли;
	
	Если Элементы.ПолеHTML.Документ.defaultView = Неопределено Тогда
		ВызватьИсключение "defaultView HTML-документа недоступен";
	КонецЕсли;
	
	Возврат Элементы.ПолеHTML.Документ.defaultView;
	
КонецФункции

&НаКлиенте
Функция МостСессияФормыПотеряна(ТекстОшибки)
	
	Если ПустаяСтрока(ТекстОшибки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Текст = НРег(ТекстОшибки);
	Возврат СтрНайти(Текст, "неизвестный идентификатор формы") > 0
		Или СтрНайти(Текст, "unknown form identifier") > 0;
	
КонецФункции

&НаКлиенте
Функция МостКомандыРазрешены(Действие)
	
	Если ОкноПомеченоУстаревшим Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если МостПриостановлен Тогда
		Если Действие = "ready" И ОжидаемReadyПослеПерезагрузки Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьКомандуМоста(Href)
	
	Попытка
		Команда = РазобратьКомандуМостаНаКлиенте(Href);
	Исключение
		СообщитьBridgeОшибку(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если Не МостКомандыРазрешены(Команда.Действие) Тогда
		Возврат;
	КонецЕсли;
	
	Если Команда.Действие = "ready" Тогда
		ReactГотов = Истина;
		ЛогReact("React сообщил о готовности (action=ready)");
		Если ОжидаемReadyПослеПерезагрузки Тогда
			ОжидаемReadyПослеПерезагрузки = Ложь;
			МостПриостановлен = Ложь;
			ОтправитьResumeПослеПерезагрузкиВИнтерфейс();
			Возврат;
		КонецЕсли;
		СообщитьBridgeСтатус("Подключено");
		ЗапланироватьПроверкуОбновления();
	ИначеЕсли Команда.Действие = "checkUpdate" Тогда
		ЗапланироватьПроверкуОбновления();
	ИначеЕсли Команда.Действие = "pickEpfPath" Тогда
		ВыбратьПутьКФайлуEPFНаКлиенте();
	ИначеЕсли Команда.Действие = "pickAndOpenEpf" Тогда
		ВыбратьИОткрытьEpfНаКлиенте();
	ИначеЕсли Команда.Действие = "openLaunchEpf" Тогда
		ОткрытьEpfПоПутиЗапускаНаКлиенте(СокрЛП(Команда.TargetPath));
	ИначеЕсли Команда.Действие = "applyUpdate" Тогда
		МостПриостановлен = Истина;
		ОжидаемReadyПослеПерезагрузки = Ложь;
		ОчередьApplyTargetPath = Команда.TargetPath;
		ОчередьApplyReleaseVer = Команда.ReleaseVer;
		ОчередьApplyEpfUrl = Команда.EpfUrl;
		ПодключитьОбработчикОжидания("ОтложенноеПрименениеОбновления", 0.05, Истина);
	ИначеЕсли Команда.Действие = "openRelease" Тогда
		ОткрытьЛокальныйРелизПоВерсии(СокрЛП(Команда.ReleaseVer), СокрЛП(Команда.EpfUrl));
	ИначеЕсли Команда.Действие = "getListMeta" Тогда
		ЗапланироватьОтправкуМетаСпискаЭПД();
	ИначеЕсли Команда.Действие = "getListPage" Тогда
		ОтправитьСтраницуСпискаЭПДВИнтерфейс(Команда.Offset, Команда.Limit);
	ИначеЕсли Команда.Действие = "enrichRows" Тогда
		ОтправитьОбогащениеСтрокЭПДВИнтерфейс(Команда.Refs);
	ИначеЕсли Команда.Действие = "getList" Тогда
		ЗапланироватьЗагрузкуСпискаЭПД();
	ИначеЕсли Команда.Действие = "getDocument" Тогда
		ЗапланироватьЗагрузкуДокументаЭПД(Команда.Ref, Команда.DocType);
	ИначеЕсли Команда.Действие = "openDocument" Тогда
		ОткрытьДокументЭПД(Команда.Ref, Команда.DocType);
	ИначеЕсли Команда.Действие = "openCatalog" Тогда
		ОткрытьКаталогПоМосту(Команда.Ref);
	ИначеЕсли Команда.Действие = "openEdoSettings" Тогда
		ОткрытьНастройкиЭДОПоМосту(Команда.EdoId, Команда.OrgRef, Команда.EntityRef);
	ИначеЕсли Команда.Действие = "openEdoSendSettings" Тогда
		ОткрытьНастройкиОтправкиЭДОПоМосту(Команда.EntityRef);
	ИначеЕсли Команда.Действие = "getEdoDiagnostics" Тогда
		ЗапланироватьДиагностикуЭДО(Команда.OrgRef, Команда.EntityRef, Команда.EdoId, "local");
	ИначеЕсли Команда.Действие = "getEdoDiagnosticsLocal" Тогда
		ЗапланироватьДиагностикуЭДО(Команда.OrgRef, Команда.EntityRef, Команда.EdoId, "local");
	ИначеЕсли Команда.Действие = "getEdoDiagnosticsOnline" Тогда
		ЗапланироватьДиагностикуЭДО(Команда.OrgRef, Команда.EntityRef, Команда.EdoId, "online");
	ИначеЕсли Команда.Действие = "openEdoTransportSettings" Тогда
		ОткрытьТранспортныеНастройкиЭДОПоМосту(Команда.OrgRef, Команда.EntityRef, Команда.EdoId);
	ИначеЕсли Команда.Действие = "saveComment" Тогда
		Результат = СохранитьКомментарийЭПДНаСервере(Команда.Ref, Команда.Comment, Команда.DocType);
		Если Результат.Успех Тогда
			СообщитьBridgeСтатус("Комментарий сохранён.");
			ОтправитьДокументЭПДВИнтерфейс(Команда.Ref, Команда.DocType);
		Иначе
			СообщитьBridgeОшибку(Результат.Сообщение);
		КонецЕсли;
	Иначе
		СообщитьBridgeОшибку("Неизвестная команда моста: " + Команда.Действие);
	КонецЕсли;
	
