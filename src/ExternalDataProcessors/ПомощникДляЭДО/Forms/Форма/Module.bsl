#Область ОписаниеПеременных

// Установите Истина для сообщений о загрузке React в окне 1С (диагностика).
&НаКлиенте
Перем ОтладкаReact;

&НаКлиенте
Перем ReactГотов;

&НаСервере
Перем КэшСсылокЭПДUUID;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.АдресHTML = "";
	Объект.АдресМакета = "";
	ПолеHTML = "";
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Попытка
		ДвоичныеДанныеМакета = ОбработкаОбъект.ПолучитьМакет(ОбработкаОбъект.ИмяМакетаReact());
		
		Если ДвоичныеДанныеМакета = Неопределено Или ДвоичныеДанныеМакета.Размер() = 0 Тогда
			ВызватьИсключение "Макет React пуст";
		КонецЕсли;
		
		// Inline HTML (CSS + IIFE JS в одном файле). Идентификатор формы — для чтения на клиенте.
		Объект.АдресHTML = ПоместитьВоВременноеХранилище(ДвоичныеДанныеМакета, УникальныйИдентификатор);
		ЗаписатьДиагностикуReact(
			"HTML React UI помещён во временное хранилище. Размер: "
			+ Формат(ДвоичныеДанныеМакета.Размер(), "ЧГ=0")
			+ ", версия UI: "
			+ ОбработкаОбъект.ВерсияПриложения());
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписатьДиагностикуReact("Ошибка загрузки макета React: " + ТекстОшибки, Истина);
		ОбщегоНазначения.СообщитьПользователю(
			"Макет ReactПриложение не найден или пуст. Выполните scripts/pack.ps1 и обновите макет в EDT.");
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ReactГотов = Ложь;
	ОтладкаReact = Ложь;
	
	Если ПустаяСтрока(Объект.АдресHTML) Тогда
		ПолеHTML = HTMLСтраницаДиагностики("HTML React UI не загружен на сервере. Выполните pack.ps1 и F7.");
		Возврат;
	КонецЕсли;
	
	РезультатЗагрузки = ПолучитьReactHTMLНаСервере();
	Если РезультатЗагрузки.Успех Тогда
		ПолеHTML = РезультатЗагрузки.HTML;
	Иначе
		ПолеHTML = HTMLСтраницаДиагностики(РезультатЗагрузки.Сообщение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеHTMLДокументСформирован(Элемент)
	
	Если Элементы.ПолеHTML.Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ПолеHTML.Документ.readyState <> "complete" Тогда
		Возврат;
	КонецЕсли;
	
	// Резерв, если action=ready из JS не пришёл.
	ПодключитьОбработчикОжидания("ОтложеннаяИнициализацияReact", 2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Если ДанныеСобытия = Неопределено Или Не ЗначениеЗаполнено(ДанныеСобытия.Href) Тогда
		Возврат;
	КонецЕсли;
	
	Href = ДанныеСобытия.Href;
	Если Не СтрНачинаетсяС(НРег(Href), "onec:") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ОбработатьКомандуМоста(Href);
	
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаReact

&НаСервере
Функция ПолучитьReactHTMLНаСервере()
	
	Результат = Новый Структура("Успех, HTML, Сообщение", Ложь, "", "");
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат.Сообщение = "Версия UI: " + ОбработкаОбъект.ВерсияПриложения();
	
	Если ПустаяСтрока(Объект.АдресHTML) Тогда
		Результат.Сообщение = Результат.Сообщение + ". АдресHTML пуст. Обновите базу из EDT.";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ДвоичныеДанныеМакета = ПолучитьИзВременногоХранилища(Объект.АдресHTML);
		ТекстHTML = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеМакета, КодировкаТекста.UTF8);
		Размер = СтрДлина(ТекстHTML);
		
		Если Размер < 1000 Тогда
			Результат.Сообщение = "Макет слишком мал (" + Формат(Размер, "ЧГ=0") + " симв.). Пересоберите pack.ps1.";
			Возврат Результат;
		КонецЕсли;
		
		Если СтрНайти(НРег(ТекстHTML), "<html") = 0 Тогда
			Результат.Сообщение = "Макет не похож на HTML (нет тега html). Проверьте Template.bin.";
			Возврат Результат;
		КонецЕсли;
		
		Если СтрНайти(НРег(ТекстHTML), "type=""module""") > 0
			Или СтрНайти(НРег(ТекстHTML), "type='module'") > 0 Тогда
			Результат.Сообщение = "В макете найден type=module — WebKit 1С его не выполняет. Пересоберите pack.ps1.";
			Возврат Результат;
		КонецЕсли;
		
		Результат.HTML = ТекстHTML;
		Результат.Успех = Истина;
		Результат.Сообщение = Результат.Сообщение
			+ ". Inline HTML, длина "
			+ Формат(Размер, "ЧГ=0")
			+ " симв.";
	Исключение
		Результат.Сообщение = "Ошибка чтения HTML из временного хранилища: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОтложеннаяИнициализацияReact() Экспорт
	
	Если ReactГотов Тогда
		Возврат;
	КонецЕсли;
	
	ЛогReact("Резервная инициализация React (ready не пришёл)");
	ReactГотов = Истина;
	ОтправитьСписокЭПДВИнтерфейс();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛогReact(Текст, Всегда = Ложь)
	
	Если Всегда Или ОтладкаReact Тогда
		Сообщить("[ПомощникЭДО] " + Текст);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДиагностикуReact(Текст, ЭтоОшибка = Ложь)
	
	Уровень = ?(ЭтоОшибка, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация);
	ЗаписьЖурналаРегистрации("ПомощникДляЭДО.React", Уровень, , , Текст);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция HTMLСтраницаДиагностики(ТекстОшибки)
	
	Текст = СтрЗаменить(ТекстОшибки, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	
	Возврат "<!DOCTYPE html><html lang=""ru""><head><meta charset=""UTF-8""><title>Помощник ЭДО</title></head>"
		+ "<body style=""font-family:Segoe UI,sans-serif;padding:16px;background:#fff8f0"">"
		+ "<h2 style=""color:#c00;margin-top:0"">Помощник ЭДО — диагностика</h2>"
		+ "<p>" + Текст + "</p>"
		+ "<p>1. scripts/pack.ps1<br>2. Обновление конфигурации в EDT<br>3. Открыть обработку из обновлённой базы</p>"
		+ "</body></html>";
	
КонецФункции

#КонецОбласти

#Область МостReact

&НаКлиенте
Функция View()
	
	Если Элементы.ПолеHTML.Документ = Неопределено Тогда
		ВызватьИсключение "HTML-документ не создан";
	КонецЕсли;
	
	Если Элементы.ПолеHTML.Документ.defaultView = Неопределено Тогда
		ВызватьИсключение "defaultView HTML-документа недоступен";
	КонецЕсли;
	
	Возврат Элементы.ПолеHTML.Документ.defaultView;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьКомандуМоста(Href)
	
	Попытка
		Команда = РазобратьКомандуМостаНаСервере(Href);
	Исключение
		СообщитьBridgeОшибку(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если Команда.Действие = "ready" Тогда
		ReactГотов = Истина;
		ЛогReact("React сообщил о готовности (action=ready)");
		ОтправитьСписокЭПДВИнтерфейс();
	ИначеЕсли Команда.Действие = "getList" Тогда
		ОтправитьСписокЭПДВИнтерфейс();
	ИначеЕсли Команда.Действие = "getDocument" Тогда
		ОтправитьДокументЭПДВИнтерфейс(Команда.Ref, Команда.DocType);
	ИначеЕсли Команда.Действие = "openDocument" Тогда
		ОткрытьДокументЭПД(Команда.Ref, Команда.DocType);
	ИначеЕсли Команда.Действие = "openCatalog" Тогда
		ОткрытьКаталогПоМосту(Команда.Ref);
	ИначеЕсли Команда.Действие = "openEdoSettings" Тогда
		ОткрытьНастройкиЭДОПоМосту(Команда.EdoId, Команда.OrgRef);
	ИначеЕсли Команда.Действие = "saveComment" Тогда
		Результат = СохранитьКомментарийЭПДНаСервере(Команда.Ref, Команда.Comment, Команда.DocType);
		Если Результат.Успех Тогда
			СообщитьBridgeСтатус("Комментарий сохранён.");
			ОтправитьДокументЭПДВИнтерфейс(Команда.Ref, Команда.DocType);
		Иначе
			СообщитьBridgeОшибку(Результат.Сообщение);
		КонецЕсли;
	Иначе
		СообщитьBridgeОшибку("Неизвестная команда моста: " + Команда.Действие);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСписокЭПДВИнтерфейс()
	
	JSON = ПолучитьСписокЭПДJSONНаСервере();
	Попытка
		View().edoInit(JSON);
	Исключение
		СообщитьBridgeОшибку("React UI ещё не готов: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьДокументЭПДВИнтерфейс(Ref, DocType = "")
	
	JSON = ПолучитьДокументЭПДJSONНаСервере(Ref, DocType);
	Попытка
		View().edoSetDocument(JSON);
	Исключение
		СообщитьBridgeОшибку("Не удалось передать документ в React UI: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДокументЭПД(Ref, DocType = "")
	
	Если ПустаяСтрока(НормализоватьUUIDСтрокуНаСервере(Ref)) Тогда
		СообщитьBridgeОшибку("Не передан идентификатор документа (ref).");
		Возврат;
	КонецЕсли;
	
	Ссылка = ПолучитьСсылкуДокументаЭПДНаСервере(Ref, DocType);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ПоказатьЗначение(, Ссылка);
	Иначе
		СообщитьBridgeОшибку("Документ не найден.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКаталогПоМосту(Ref)
	
	Ссылка = ПолучитьСсылкуКаталогаНаСервере(Ref);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ПоказатьЗначение(, Ссылка);
	Иначе
		СообщитьBridgeОшибку("Объект не найден.");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьНастройкиЭДОПоМосту(EdoId, OrgRef)
	
	ПараметрыФормы = ПараметрыФормыПриглашенияЭДОНаСервере(EdoId, OrgRef);
	Если ПараметрыФормы = Неопределено Тогда
		СообщитьBridgeОшибку("Настройки ЭДО не найдены.");
		Возврат;
	КонецЕсли;
	
	Попытка
		ОткрытьФорму("РегистрСведений.ПриглашенияКОбменуЭлектроннымиДокументами.ФормаЗаписи", ПараметрыФормы);
	Исключение
		СообщитьBridgeОшибку("Не удалось открыть настройки ЭДО: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьBridgeСтатус(Текст)
	
	Попытка
		View().edoSetStatus(Текст);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьBridgeОшибку(Текст)
	
	Попытка
		View().edoSetError(Текст);
	Исключение
		ПоказатьПредупреждение(, Текст);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СерверныеAPI

&НаСервере
Функция РазобратьКомандуМостаНаСервере(Href)
	
	ПозицияQuery = СтрНайти(Href, "?");
	Если ПозицияQuery = 0 Тогда
		ВызватьИсключение "В команде моста отсутствуют параметры";
	КонецЕсли;
	
	ПараметрыЗапроса = ПараметрыЗапросаИзСтроки(Сред(Href, ПозицияQuery + 1));
	Действие = ЗначениеПараметраЗапроса(ПараметрыЗапроса, "action");
	
	Если ПустаяСтрока(Действие) Тогда
		ВызватьИсключение "В команде моста отсутствует параметр action";
	КонецЕсли;
	
	Команда = Новый Структура;
	Команда.Вставить("Действие", Действие);
	Команда.Вставить("Ref", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "ref"));
	Команда.Вставить("DocType", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "docType"));
	Команда.Вставить("Comment", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "comment"));
	Команда.Вставить("EdoId", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "edoId"));
	Команда.Вставить("OrgRef", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "orgRef"));
	
	Возврат Команда;
	
КонецФункции

&НаСервере
Функция ПараметрыЗапросаИзСтроки(QueryString)
	
	Результат = Новый Соответствие;
	
	Для Каждого Часть Из СтрРазделить(QueryString, "&", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Имя = Сред(Часть, 1, Позиция - 1);
		Значение = РаскодироватьПроцентыURL(Сред(Часть, Позиция + 1));
		Результат.Вставить(Имя, Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗначениеПараметраЗапроса(ПараметрыЗапроса, Имя)
	
	Значение = ПараметрыЗапроса.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаСервере
Функция РаскодироватьПроцентыURL(Знач Строка)
	
	// КодировкаURL корректно раскодирует UTF-8 (%D0%A7…), в отличие от посимвольного Символ().
	Результат = РаскодироватьСтроку(Строка, СпособКодированияСтроки.КодировкаURL);
	// Пробелы в query-string часто приходят как «+».
	Возврат СтрЗаменить(Результат, "+", " ");
	
КонецФункции

&НаСервере
Функция ПолучитьВерсиюПриложенияНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ВерсияПриложения();
	
КонецФункции

&НаСервере
Функция ПолучитьСписокЭПДJSONНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Данные = Новый Структура;
	Данные.Вставить("version", ОбработкаОбъект.ВерсияПриложения());
	Данные.Вставить("items", ПолучитьСписокЭПД());
	Возврат ЗаписатьJSONСтрокой(Данные);
	
КонецФункции

&НаСервере
Функция ПолучитьДокументЭПДJSONНаСервере(Ref, DocType = "")
	
	Попытка
		Документ = ПолучитьДокументЭПД(Ref, DocType);
		Если Документ = Неопределено Тогда
			Возврат "{""error"":""Документ не найден в реестре ЭПД""}";
		КонецЕсли;
		
		Возврат ЗаписатьJSONСтрокой(Документ);
	Исключение
		Возврат "{""error"":""" + ЭкранироватьСтрокуJSON(ОписаниеОшибки()) + """}";
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПолучитьСсылкуДокументаЭПДНаСервере(Ref, DocType = "")
	
	Возврат СсылкаДокументаЭПДПоUUID(Ref, DocType);
	
КонецФункции

&НаСервере
Функция ПолучитьСписокЭПД()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	Реестр.Ссылка КАК Ссылка,
	|	Реестр.Организация КАК ОрганизацияСсылка,
	|	ПРЕДСТАВЛЕНИЕ(Реестр.Организация) КАК Организация,
	|	Реестр.НомерЭПД КАК НомерЭПД,
	|	Реестр.ДатаЭПД КАК ДатаЭПД,
	|	Реестр.НомерДокументаИБ КАК НомерДокументаИБ,
	|	Реестр.Грузоотправитель КАК Грузоотправитель,
	|	Реестр.Грузополучатель КАК Грузополучатель,
	|	Реестр.Перевозчик КАК Перевозчик,
	|	Реестр.ТекущийШаг КАК ТекущийШаг,
	|	Реестр.ТекущийШагВыполнен КАК ТекущийШагВыполнен,
	|	Реестр.Проведен КАК Проведен,
	|	Реестр.ПометкаУдаления КАК ПометкаУдаления,
	|	Реестр.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.РеестрЭПД КАК Реестр
	|
	|УПОРЯДОЧИТЬ ПО
	|	Реестр.ДатаЭПД УБЫВ,
	|	Реестр.НомерЭПД УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;
	КэшСсылокЭПДUUID = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		ДобавитьСсылкуВКэшЭПД(Выборка.Ссылка);
		Результат.Добавить(СтруктураДокументаИзРеестра(Выборка, Ложь));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьСсылкуВКэшЭПД(СсылкаДокумента)
	
	Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Если КэшСсылокЭПДUUID = Неопределено Тогда
		КэшСсылокЭПДUUID = Новый Соответствие;
	КонецЕсли;
	
	UUIDСтрока = НормализоватьUUIDСтроку(Строка(СсылкаДокумента.УникальныйИдентификатор()));
	КэшСсылокЭПДUUID.Вставить(UUIDСтрока, СсылкаДокумента);
	
КонецПроцедуры

&НаСервере
Функция СсылкаИзКэшаЭПД(UUIDСтрока)
	
	Если КэшСсылокЭПДUUID = Неопределено Или ПустаяСтрока(UUIDСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ссылка = КэшСсылокЭПДUUID.Получить(UUIDСтрока);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПолучитьДокументЭПД(Ref, DocType = "")
	
	Ссылка = СсылкаДокументаЭПДПоUUID(Ref, DocType);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реестр.Ссылка КАК Ссылка,
	|	Реестр.Организация КАК ОрганизацияСсылка,
	|	ПРЕДСТАВЛЕНИЕ(Реестр.Организация) КАК Организация,
	|	Реестр.НомерЭПД КАК НомерЭПД,
	|	Реестр.ДатаЭПД КАК ДатаЭПД,
	|	Реестр.НомерДокументаИБ КАК НомерДокументаИБ,
	|	Реестр.Грузоотправитель КАК Грузоотправитель,
	|	Реестр.Грузополучатель КАК Грузополучатель,
	|	Реестр.Перевозчик КАК Перевозчик,
	|	Реестр.ТекущийШаг КАК ТекущийШаг,
	|	Реестр.ТекущийШагВыполнен КАК ТекущийШагВыполнен,
	|	Реестр.Проведен КАК Проведен,
	|	Реестр.ПометкаУдаления КАК ПометкаУдаления,
	|	Реестр.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.РеестрЭПД КАК Реестр
	|ГДЕ
	|	Реестр.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СтруктураДокументаИзРеестра(Выборка, Истина);
	
КонецФункции

&НаСервере
Функция НормализоватьUUIDСтрокуНаСервере(Ref)
	
	Возврат НормализоватьUUIDСтроку(Ref);
	
КонецФункции

&НаСервере
Функция СохранитьКомментарийЭПДНаСервере(Ref, Comment, DocType = "")
	
	Результат = Новый Структура("Успех, Сообщение", Ложь, "");
	
	Если ПустаяСтрока(НормализоватьUUIDСтроку(Ref)) Тогда
		Результат.Сообщение = "Не передан идентификатор документа (ref).";
		Возврат Результат;
	КонецЕсли;
	
	Ссылка = СсылкаДокументаЭПДПоUUID(Ref, DocType);
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Результат.Сообщение = "Документ ЭПД не найден.";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ОбъектДокумента = Ссылка.ПолучитьОбъект();
		ОбъектДокумента.Комментарий = Comment;
		ОбъектДокумента.Записать();
		ЗаписатьКомментарийВРеестрЭПД(Ссылка, Comment);
		Результат.Успех = Истина;
	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаписатьКомментарийВРеестрЭПД(СсылкаДокумента, Comment)
	
	МенеджерЗаписи = РегистрыСведений.РеестрЭПД.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Ссылка = СсылкаДокумента;
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи.Комментарий = Comment;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

&НаСервере
Функция СтруктураДокументаИзРеестра(Выборка, Подробно)
	
	СсылкаДокумента = Выборка.Ссылка;
	ОрганизацияДокумента = Выборка.ОрганизацияСсылка;
	Идентификаторы = ИдентификаторыСторонИзДокумента(СсылкаДокумента);
	
	ИдОрганизации = ИдентификаторЭДООрганизации(ОрганизацияДокумента);
	ИдКонтрагентов = Новый Массив;
	ДобавитьИдентификаторВМассив(ИдКонтрагентов, Идентификаторы.shipper);
	ДобавитьИдентификаторВМассив(ИдКонтрагентов, Идентификаторы.consignee);
	ДобавитьИдентификаторВМассив(ИдКонтрагентов, Идентификаторы.carrier);
	Принятые = ПринятыеИдентификаторыЭДО(ИдОрганизации, ИдКонтрагентов);
	
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("ref", Строка(СсылкаДокумента.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("docType", КодТипаДокументаЭПД(СсылкаДокумента));
	СтруктураДокумента.Вставить("docTypeName", НаименованиеТипаДокументаЭПД(СсылкаДокумента));
	СтруктураДокумента.Вставить("number", Строка(Выборка.НомерЭПД));
	СтруктураДокумента.Вставить("ibNumber", Строка(Выборка.НомерДокументаИБ));
	СтруктураДокумента.Вставить("date", ?(ЗначениеЗаполнено(Выборка.ДатаЭПД), XMLСтрока(Выборка.ДатаЭПД), ""));
	СтруктураДокумента.Вставить("comment", Строка(Выборка.Комментарий));
	СтруктураДокумента.Вставить("organization", Строка(Выборка.Организация));
	СтруктураДокумента.Вставить("organizationRef", ?(ЗначениеЗаполнено(ОрганизацияДокумента), Строка(ОрганизацияДокумента.УникальныйИдентификатор()), ""));
	СтруктураДокумента.Вставить("currentStep", Строка(Выборка.ТекущийШаг));
	СтруктураДокумента.Вставить("currentStepDone", Выборка.ТекущийШагВыполнен);
	СтруктураДокумента.Вставить("posted", Выборка.Проведен);
	СтруктураДокумента.Вставить("deletionMark", Выборка.ПометкаУдаления);
	СтруктураДокумента.Вставить("shipper", СформироватьЯчейкуСтороны(Выборка.Грузоотправитель, Идентификаторы.shipper, ОрганизацияДокумента, ИдОрганизации, Принятые));
	СтруктураДокумента.Вставить("consignee", СформироватьЯчейкуСтороны(Выборка.Грузополучатель, Идентификаторы.consignee, ОрганизацияДокумента, ИдОрганизации, Принятые));
	СтруктураДокумента.Вставить("carrier", СформироватьЯчейкуСтороны(Выборка.Перевозчик, Идентификаторы.carrier, ОрганизацияДокумента, ИдОрганизации, Принятые));
	
	Если Подробно Тогда
		Попытка
			ДополнительныеПоля = ДополнительныеПоляДокументаЭПД(СсылкаДокумента);
			Для Каждого КлючЗначение Из ДополнительныеПоля Цикл
				СтруктураДокумента.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
			СтруктураДокумента.Вставить("diagnostics", ДиагностикаДокументаЭПД(СтруктураДокумента));
		Исключение
			СтруктураДокумента.Вставить("diagnostics", Новый Массив);
		КонецПопытки;
	КонецЕсли;
	
	Возврат СтруктураДокумента;
	
КонецФункции

&НаСервере
Функция СформироватьЯчейкуСтороны(Участник, ИдЭДО, ОрганизацияДокумента, ИдОрганизацииЭДО, Принятые)
	
	Имя = "";
	ИНН = "";
	КПП = "";
	
	Если ЗначениеЗаполнено(Участник) Тогда
		Имя = Строка(Участник);
		РеквизитыУчастника = РеквизитыУчастникаЭПД(Участник);
		ИНН = РеквизитыУчастника.ИНН;
		КПП = РеквизитыУчастника.КПП;
	КонецЕсли;
	
	Если ПустаяСтрока(Имя) И ЗначениеЗаполнено(ИдЭДО) Тогда
		РеквАбонента = РеквизитыАбонентаЭДО(ИдЭДО);
		Имя = РеквАбонента.Наименование;
		Если ПустаяСтрока(ИНН) Тогда
			ИНН = РеквАбонента.ИНН;
		КонецЕсли;
		Если ПустаяСтрока(КПП) Тогда
			КПП = РеквАбонента.КПП;
		КонецЕсли;
	КонецЕсли;
	
	ЭтоНашаОрганизация = ЭтоНашаОрганизацияВДокументе(Участник, ИдЭДО, ОрганизацияДокумента, ИдОрганизацииЭДО);
	
	Ячейка = Новый Структура;
	Ячейка.Вставить("name", Имя);
	Ячейка.Вставить("inn", ИНН);
	Ячейка.Вставить("kpp", КПП);
	Ячейка.Вставить("edoId", ИдЭДО);
	Ячейка.Вставить("isOwnOrganization", ЭтоНашаОрганизация);
	
	Если ЗначениеЗаполнено(Участник) Тогда
		Ячейка.Вставить("entityRef", Строка(Участник.УникальныйИдентификатор()));
		Ячейка.Вставить("entityKind", ВидСсылкиУчастника(Участник));
	Иначе
		Ячейка.Вставить("entityRef", "");
		Ячейка.Вставить("entityKind", "");
	КонецЕсли;
	
	Если ЭтоНашаОрганизация Тогда
		Ячейка.Вставить("edoExchangeStatus", "own");
	Иначе
		Ячейка.Вставить("edoExchangeStatus", СтатусОбменаЭДО(ОрганизацияДокумента, ИдЭДО, Принятые));
	КонецЕсли;
	
	Возврат Ячейка;
	
КонецФункции

&НаСервере
Функция ЭтоНашаОрганизацияВДокументе(Участник, ИдЭДО, ОрганизацияДокумента, ИдОрганизацииЭДО)
	
	Если ЗначениеЗаполнено(Участник) И ЗначениеЗаполнено(ОрганизацияДокумента) И Участник = ОрганизацияДокумента Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдЭДО) И ЗначениеЗаполнено(ИдОрганизацииЭДО) И ИдЭДО = ИдОрганизацииЭДО Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция РеквизитыУчастникаЭПД(Участник)
	
	Результат = Новый Структура("ИНН, КПП", "", "");
	Если Не ЗначениеЗаполнено(Участник) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		РеквУчастника = ОбменСГИСЭПД.ПолучитьРеквизитыУчастника(Участник);
		Результат.ИНН = Строка(?(ЗначениеЗаполнено(РеквУчастника.ЮЛ_ИНН), РеквУчастника.ЮЛ_ИНН, РеквУчастника.ИП_ИНН));
		Результат.КПП = Строка(РеквУчастника.ЮЛ_КПП);
	Исключение
		Попытка
			РеквКаталога = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Участник, "ИНН, КПП");
			Результат.ИНН = Строка(РеквКаталога.ИНН);
			Результат.КПП = Строка(РеквКаталога.КПП);
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ИдентификаторыСторонИзДокумента(СсылкаДокумента)
	
	Результат = Новый Структура("shipper, consignee, carrier", "", "", "");
	Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяДокумента = СсылкаДокумента.Метаданные().Имя;
	
	Если ИмяДокумента = "ЭлектроннаяТранспортнаяНакладная"
		Или ИмяДокумента = "ЭлектроннаяСопроводительнаяВедомость" Тогда
		
		ИменаРеквизитов = "ИдентификаторГрузоотправителя, ИдентификаторГрузополучателя, ИдентификаторПеревозчика";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.shipper = Строка(Реквизиты.ИдентификаторГрузоотправителя);
		Результат.consignee = Строка(Реквизиты.ИдентификаторГрузополучателя);
		Результат.carrier = Строка(Реквизиты.ИдентификаторПеревозчика);
		
	ИначеЕсли ИмяДокумента = "ЭлектронныйЗаказЗаявка" Тогда
		
		ИменаРеквизитов = "ИдентификаторГрузоотправителя, ИдентификаторПеревозчика";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.shipper = Строка(Реквизиты.ИдентификаторГрузоотправителя);
		Результат.carrier = Строка(Реквизиты.ИдентификаторПеревозчика);
		
	ИначеЕсли ИмяДокумента = "ЭлектронныйЗаказНаряд"
		Или ИмяДокумента = "ЭлектронныйДоговорФрахтования" Тогда
		
		ИменаРеквизитов = "ИдентификаторФрахтователя, ИдентификаторФрахтовщика";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.shipper = Строка(Реквизиты.ИдентификаторФрахтователя);
		Результат.carrier = Строка(Реквизиты.ИдентификаторФрахтовщика);
		
	ИначеЕсли ИмяДокумента = "ЭлектронныйПутевойЛист" Тогда
		
		ИменаРеквизитов = "ИдентификаторОформителя, ИдентификаторМедорганизации, ИдентификаторТехконтроль";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.shipper = Строка(Реквизиты.ИдентификаторОформителя);
		Результат.consignee = Строка(Реквизиты.ИдентификаторМедорганизации);
		Результат.carrier = Строка(Реквизиты.ИдентификаторТехконтроль);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДополнительныеПоляДокументаЭПД(СсылкаДокумента)
	
	Результат = Новый Структура;
	ИмяДокумента = СсылкаДокумента.Метаданные().Имя;
	
	Если ИмяДокумента = "ЭлектроннаяТранспортнаяНакладная" Тогда
		
		ИменаРеквизитов = "УИДМинтранс, ЭтоВходящий, ТитулГрузоотправителяТранспортнаяНакладнаяНомер,
			|ТитулГрузоотправителяТранспортнаяНакладнаяДата, ТитулГрузоотправителяДатаФормированияФайла,
			|ТитулПеревозчикаПриемкаДатаФормированияФайла, ТитулГрузополучателяДатаФормированияФайла,
			|ТитулПеревозчикаВыдачаДатаФормированияФайла, РольУчастника";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.Вставить("uidMintrans", Строка(Реквизиты.УИДМинтранс));
		Результат.Вставить("isIncoming", Реквизиты.ЭтоВходящий);
		Результат.Вставить("waybillNumber", Строка(Реквизиты.ТитулГрузоотправителяТранспортнаяНакладнаяНомер));
		Результат.Вставить("waybillDate", ?(ЗначениеЗаполнено(Реквизиты.ТитулГрузоотправителяТранспортнаяНакладнаяДата),
			XMLСтрока(Реквизиты.ТитулГрузоотправителяТранспортнаяНакладнаяДата), ""));
		Результат.Вставить("roleParticipant", Строка(Реквизиты.РольУчастника));
		
		Результат.Вставить("titleDates", МассивДатТитуловЭТН(Реквизиты));
		
	Иначе
		
		Попытка
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, "УИДМинтранс, ЭтоВходящий, РольУчастника");
			Результат.Вставить("uidMintrans", Строка(Реквизиты.УИДМинтранс));
			Результат.Вставить("isIncoming", Реквизиты.ЭтоВходящий);
			Результат.Вставить("roleParticipant", Строка(Реквизиты.РольУчастника));
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДиагностикаДокументаЭПД(СтруктураДокумента)
	
	Замечания = Новый Массив;
	
	Если СтруктураДокумента.deletionMark Тогда
		Замечания.Добавить("Документ помечен на удаление.");
	КонецЕсли;
	
	ДобавитьЗамечаниеПустогоИдЭДО(Замечания, "грузоотправителя", СтруктураДокумента.shipper);
	ДобавитьЗамечаниеПустогоИдЭДО(Замечания, "грузополучателя", СтруктураДокумента.consignee);
	ДобавитьЗамечаниеПустогоИдЭДО(Замечания, "перевозчика", СтруктураДокумента.carrier);
	
	Если СтруктураДокумента.Свойство("waybillNumber")
		И ЗначениеЗаполнено(СтруктураДокумента.waybillNumber)
		И СтруктураДокумента.waybillNumber <> СтруктураДокумента.number Тогда
		Замечания.Добавить("Номер ЭПД (" + СтруктураДокумента.number + ") не совпадает с номером ТН (" + СтруктураДокумента.waybillNumber + ").");
	КонецЕсли;
	
	Если СтруктураДокумента.Свойство("isIncoming")
		И СтруктураДокумента.isIncoming = Истина
		И СтруктураДокумента.Свойство("roleParticipant")
		И СтрНайти(Строка(СтруктураДокумента.roleParticipant), "2") > 0 Тогда
		Замечания.Добавить("Входящий документ: роль участника — грузополучатель.");
	КонецЕсли;
	
	Для Каждого Ключ Из Новый Массив("shipper", "consignee", "carrier") Цикл
		Ячейка = СтруктураДокумента[Ключ];
		Если ЗначениеЗаполнено(Ячейка.edoId)
			И Ячейка.edoExchangeStatus = "not_accepted"
			И Не Ячейка.isOwnOrganization Тогда
			Замечания.Добавить("Обмен ЭДО не принят для ID: " + Ячейка.edoId);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Замечания;
	
КонецФункции

