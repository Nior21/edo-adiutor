КонецФункции

&НаСервере
Функция СтруктураДокументаИзРеестраЛегкая(Выборка)
	
	СсылкаДокумента = Выборка.Ссылка;
	ОрганизацияДокумента = Выборка.ОрганизацияСсылка;
	
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("ref", Строка(СсылкаДокумента.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("docType", КодТипаДокументаЭПД(СсылкаДокумента));
	СтруктураДокумента.Вставить("docTypeName", НаименованиеТипаДокументаЭПД(СсылкаДокумента));
	СтруктураДокумента.Вставить("number", Строка(Выборка.НомерЭПД));
	СтруктураДокумента.Вставить("ibNumber", Строка(Выборка.НомерДокументаИБ));
	СтруктураДокумента.Вставить("date", ?(ЗначениеЗаполнено(Выборка.ДатаЭПД), XMLСтрока(Выборка.ДатаЭПД), ""));
	СтруктураДокумента.Вставить("comment", Строка(Выборка.Комментарий));
	СтруктураДокумента.Вставить("organization", Строка(Выборка.Организация));
	СтруктураДокумента.Вставить("organizationRef", ?(ЗначениеЗаполнено(ОрганизацияДокумента), Строка(ОрганизацияДокумента.УникальныйИдентификатор()), ""));
	СтруктураДокумента.Вставить("currentStep", Строка(Выборка.ТекущийШаг));
	СтруктураДокумента.Вставить("currentStepDone", Выборка.ТекущийШагВыполнен);
	СтруктураДокумента.Вставить("posted", Выборка.Проведен);
	СтруктураДокумента.Вставить("deletionMark", Выборка.ПометкаУдаления);
	СтруктураДокумента.Вставить("partiesPending", Истина);
	СтруктураДокумента.Вставить("shipper", СформироватьЯчейкуСтороныЛегкая(Выборка.Грузоотправитель, ОрганизацияДокумента));
	СтруктураДокумента.Вставить("consignee", СформироватьЯчейкуСтороныЛегкая(Выборка.Грузополучатель, ОрганизацияДокумента));
	СтруктураДокумента.Вставить("carrier", СформироватьЯчейкуСтороныЛегкая(Выборка.Перевозчик, ОрганизацияДокумента));
	
	Возврат СтруктураДокумента;
	
КонецФункции

&НаСервере
Функция СформироватьЯчейкуСтороныЛегкая(Участник, ОрганизацияДокумента)
	
	Имя = "";
	ИНН = "";
	КПП = "";
	
	Если ЗначениеЗаполнено(Участник) Тогда
		Имя = Строка(Участник);
		РеквизитыУчастника = РеквизитыУчастникаЭПД(Участник);
		ИНН = РеквизитыУчастника.ИНН;
		КПП = РеквизитыУчастника.КПП;
	КонецЕсли;
	
	ЭтоНашаОрганизация = ЗначениеЗаполнено(Участник) И ЗначениеЗаполнено(ОрганизацияДокумента) И Участник = ОрганизацияДокумента;
	
	Ячейка = Новый Структура;
	Ячейка.Вставить("name", Имя);
	Ячейка.Вставить("inn", ИНН);
	Ячейка.Вставить("kpp", КПП);
	Ячейка.Вставить("edoId", "");
	Ячейка.Вставить("isOwnOrganization", ЭтоНашаОрганизация);
	
	Если ЗначениеЗаполнено(Участник) Тогда
		Ячейка.Вставить("entityRef", Строка(Участник.УникальныйИдентификатор()));
		Ячейка.Вставить("entityKind", ВидСсылкиУчастника(Участник));
	Иначе
		Ячейка.Вставить("entityRef", "");
		Ячейка.Вставить("entityKind", "");
	КонецЕсли;
	
	Если ЭтоНашаОрганизация Тогда
		Ячейка.Вставить("edoExchangeStatus", "own");
	Иначе
		Ячейка.Вставить("edoExchangeStatus", "pending");
	КонецЕсли;
	
	Возврат Ячейка;
	
КонецФункции

&НаСервере
Функция СтруктураДокументаИзРеестра(Выборка, Подробно)
	
	СсылкаДокумента = Выборка.Ссылка;
	ОрганизацияДокумента = Выборка.ОрганизацияСсылка;
	Идентификаторы = ИдентификаторыСторонИзДокумента(СсылкаДокумента);
	
	ИдОрганизации = ИдентификаторЭДООрганизации(ОрганизацияДокумента);
	ИдКонтрагентов = Новый Массив;
	ДобавитьИдентификаторВМассив(ИдКонтрагентов, Идентификаторы.shipper);
	ДобавитьИдентификаторВМассив(ИдКонтрагентов, Идентификаторы.consignee);
	ДобавитьИдентификаторВМассив(ИдКонтрагентов, Идентификаторы.carrier);
	Принятые = ПринятыеИдентификаторыЭДО(ИдОрганизации, ИдКонтрагентов);
	
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("ref", Строка(СсылкаДокумента.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("docType", КодТипаДокументаЭПД(СсылкаДокумента));
	СтруктураДокумента.Вставить("docTypeName", НаименованиеТипаДокументаЭПД(СсылкаДокумента));
	СтруктураДокумента.Вставить("number", Строка(Выборка.НомерЭПД));
	СтруктураДокумента.Вставить("ibNumber", Строка(Выборка.НомерДокументаИБ));
	СтруктураДокумента.Вставить("date", ?(ЗначениеЗаполнено(Выборка.ДатаЭПД), XMLСтрока(Выборка.ДатаЭПД), ""));
	СтруктураДокумента.Вставить("comment", Строка(Выборка.Комментарий));
	СтруктураДокумента.Вставить("organization", Строка(Выборка.Организация));
	СтруктураДокумента.Вставить("organizationRef", ?(ЗначениеЗаполнено(ОрганизацияДокумента), Строка(ОрганизацияДокумента.УникальныйИдентификатор()), ""));
	СтруктураДокумента.Вставить("currentStep", Строка(Выборка.ТекущийШаг));
	СтруктураДокумента.Вставить("currentStepDone", Выборка.ТекущийШагВыполнен);
	СтруктураДокумента.Вставить("posted", Выборка.Проведен);
	СтруктураДокумента.Вставить("deletionMark", Выборка.ПометкаУдаления);
	СтруктураДокумента.Вставить("shipper", СформироватьЯчейкуСтороны(Выборка.Грузоотправитель, Идентификаторы.shipper, ОрганизацияДокумента, ИдОрганизации, Принятые));
	СтруктураДокумента.Вставить("consignee", СформироватьЯчейкуСтороны(Выборка.Грузополучатель, Идентификаторы.consignee, ОрганизацияДокумента, ИдОрганизации, Принятые));
	СтруктураДокумента.Вставить("carrier", СформироватьЯчейкуСтороны(Выборка.Перевозчик, Идентификаторы.carrier, ОрганизацияДокумента, ИдОрганизации, Принятые));
	
	Если Подробно Тогда
		Попытка
			ДополнительныеПоля = ДополнительныеПоляДокументаЭПД(СсылкаДокумента);
			Для Каждого КлючЗначение Из ДополнительныеПоля Цикл
				СтруктураДокумента.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
			КонецЦикла;
			СтруктураДокумента.Вставить("diagnostics", ДиагностикаДокументаЭПД(СтруктураДокумента));
		Исключение
			СтруктураДокумента.Вставить("diagnostics", Новый Массив);
		КонецПопытки;
	КонецЕсли;
	
	Возврат СтруктураДокумента;
	
КонецФункции

&НаСервере
Функция СформироватьЯчейкуСтороны(Участник, ИдЭДО, ОрганизацияДокумента, ИдОрганизацииЭДО, Принятые)
	
	Имя = "";
	ИНН = "";
	КПП = "";
	
	Если ЗначениеЗаполнено(Участник) Тогда
		Имя = Строка(Участник);
		РеквизитыУчастника = РеквизитыУчастникаЭПД(Участник);
		ИНН = РеквизитыУчастника.ИНН;
		КПП = РеквизитыУчастника.КПП;
	КонецЕсли;
	
	Если ПустаяСтрока(Имя) И ЗначениеЗаполнено(ИдЭДО) Тогда
		РеквАбонента = РеквизитыАбонентаЭДО(ИдЭДО);
		Имя = РеквАбонента.Наименование;
		Если ПустаяСтрока(ИНН) Тогда
			ИНН = РеквАбонента.ИНН;
		КонецЕсли;
		Если ПустаяСтрока(КПП) Тогда
			КПП = РеквАбонента.КПП;
		КонецЕсли;
	КонецЕсли;
	
	ЭтоНашаОрганизация = ЭтоНашаОрганизацияВДокументе(Участник, ИдЭДО, ОрганизацияДокумента, ИдОрганизацииЭДО);
	
	Ячейка = Новый Структура;
	Ячейка.Вставить("name", Имя);
	Ячейка.Вставить("inn", ИНН);
	Ячейка.Вставить("kpp", КПП);
	Ячейка.Вставить("edoId", ИдЭДО);
	Ячейка.Вставить("isOwnOrganization", ЭтоНашаОрганизация);
	
	Если ЗначениеЗаполнено(Участник) Тогда
		Ячейка.Вставить("entityRef", Строка(Участник.УникальныйИдентификатор()));
		Ячейка.Вставить("entityKind", ВидСсылкиУчастника(Участник));
	Иначе
		Ячейка.Вставить("entityRef", "");
		Ячейка.Вставить("entityKind", "");
	КонецЕсли;
	
	Если ЭтоНашаОрганизация Тогда
		Ячейка.Вставить("edoExchangeStatus", "own");
	Иначе
		Ячейка.Вставить("edoExchangeStatus", СтатусОбменаЭДО(ОрганизацияДокумента, ИдЭДО, Принятые));
	КонецЕсли;
	
	Возврат Ячейка;
	
КонецФункции

&НаСервере
Функция ЭтоНашаОрганизацияВДокументе(Участник, ИдЭДО, ОрганизацияДокумента, ИдОрганизацииЭДО)
	
	Если ЗначениеЗаполнено(Участник) И ЗначениеЗаполнено(ОрганизацияДокумента) И Участник = ОрганизацияДокумента Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдЭДО) И ЗначениеЗаполнено(ИдОрганизацииЭДО) И ИдЭДО = ИдОрганизацииЭДО Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция РеквизитыУчастникаЭПД(Участник)
	
	Результат = Новый Структура("ИНН, КПП", "", "");
	Если Не ЗначениеЗаполнено(Участник) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		РеквУчастника = ОбменСГИСЭПД.ПолучитьРеквизитыУчастника(Участник);
		Результат.ИНН = Строка(?(ЗначениеЗаполнено(РеквУчастника.ЮЛ_ИНН), РеквУчастника.ЮЛ_ИНН, РеквУчастника.ИП_ИНН));
		Результат.КПП = Строка(РеквУчастника.ЮЛ_КПП);
	Исключение
		Попытка
			РеквКаталога = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Участник, "ИНН, КПП");
			Результат.ИНН = Строка(РеквКаталога.ИНН);
			Результат.КПП = Строка(РеквКаталога.КПП);
		Исключение
		КонецПопытки;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ИдентификаторыСторонИзДокумента(СсылкаДокумента)
	
	Результат = Новый Структура("shipper, consignee, carrier", "", "", "");
	Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяДокумента = СсылкаДокумента.Метаданные().Имя;
	
	Если ИмяДокумента = "ЭлектроннаяТранспортнаяНакладная"
		Или ИмяДокумента = "ЭлектроннаяСопроводительнаяВедомость" Тогда
		
		ИменаРеквизитов = "ИдентификаторГрузоотправителя, ИдентификаторГрузополучателя, ИдентификаторПеревозчика";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.shipper = Строка(Реквизиты.ИдентификаторГрузоотправителя);
		Результат.consignee = Строка(Реквизиты.ИдентификаторГрузополучателя);
		Результат.carrier = Строка(Реквизиты.ИдентификаторПеревозчика);
		
	ИначеЕсли ИмяДокумента = "ЭлектронныйЗаказЗаявка" Тогда
		
		ИменаРеквизитов = "ИдентификаторГрузоотправителя, ИдентификаторПеревозчика";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.shipper = Строка(Реквизиты.ИдентификаторГрузоотправителя);
		Результат.carrier = Строка(Реквизиты.ИдентификаторПеревозчика);
		
	ИначеЕсли ИмяДокумента = "ЭлектронныйЗаказНаряд"
		Или ИмяДокумента = "ЭлектронныйДоговорФрахтования" Тогда
		
		ИменаРеквизитов = "ИдентификаторФрахтователя, ИдентификаторФрахтовщика";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.shipper = Строка(Реквизиты.ИдентификаторФрахтователя);
		Результат.carrier = Строка(Реквизиты.ИдентификаторФрахтовщика);
		
	ИначеЕсли ИмяДокумента = "ЭлектронныйПутевойЛист" Тогда
		
		ИменаРеквизитов = "ИдентификаторОформителя, ИдентификаторМедорганизации, ИдентификаторТехконтроль";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.shipper = Строка(Реквизиты.ИдентификаторОформителя);
		Результат.consignee = Строка(Реквизиты.ИдентификаторМедорганизации);
		Результат.carrier = Строка(Реквизиты.ИдентификаторТехконтроль);
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДополнительныеПоляДокументаЭПД(СсылкаДокумента)
	
	Результат = Новый Структура;
	ИмяДокумента = СсылкаДокумента.Метаданные().Имя;
	
	Если ИмяДокумента = "ЭлектроннаяТранспортнаяНакладная" Тогда
		
		ИменаРеквизитов = "УИДМинтранс, ЭтоВходящий, ТитулГрузоотправителяТранспортнаяНакладнаяНомер,
			|ТитулГрузоотправителяТранспортнаяНакладнаяДата, ТитулГрузоотправителяДатаФормированияФайла,
			|ТитулПеревозчикаПриемкаДатаФормированияФайла, ТитулГрузополучателяДатаФормированияФайла,
			|ТитулПеревозчикаВыдачаДатаФормированияФайла, РольУчастника";
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, ИменаРеквизитов);
		Результат.Вставить("uidMintrans", Строка(Реквизиты.УИДМинтранс));
		Результат.Вставить("isIncoming", Реквизиты.ЭтоВходящий);
		Результат.Вставить("waybillNumber", Строка(Реквизиты.ТитулГрузоотправителяТранспортнаяНакладнаяНомер));
		Результат.Вставить("waybillDate", ?(ЗначениеЗаполнено(Реквизиты.ТитулГрузоотправителяТранспортнаяНакладнаяДата),
			XMLСтрока(Реквизиты.ТитулГрузоотправителяТранспортнаяНакладнаяДата), ""));
		Результат.Вставить("roleParticipant", Строка(Реквизиты.РольУчастника));
		
		Результат.Вставить("titleDates", МассивДатТитуловЭТН(Реквизиты));
		
	Иначе
		
		Попытка
			Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДокумента, "УИДМинтранс, ЭтоВходящий, РольУчастника");
			Результат.Вставить("uidMintrans", Строка(Реквизиты.УИДМинтранс));
			Результат.Вставить("isIncoming", Реквизиты.ЭтоВходящий);
			Результат.Вставить("roleParticipant", Строка(Реквизиты.РольУчастника));
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДиагностикаДокументаЭПД(СтруктураДокумента)
	
	Замечания = Новый Массив;
	
	Если СтруктураДокумента.deletionMark Тогда
		Замечания.Добавить("Документ помечен на удаление.");
	КонецЕсли;
	
	ДобавитьЗамечаниеПустогоИдЭДО(Замечания, "грузоотправителя", СтруктураДокумента.shipper);
	ДобавитьЗамечаниеПустогоИдЭДО(Замечания, "грузополучателя", СтруктураДокумента.consignee);
	ДобавитьЗамечаниеПустогоИдЭДО(Замечания, "перевозчика", СтруктураДокумента.carrier);
	
	Если СтруктураДокумента.Свойство("waybillNumber")
		И ЗначениеЗаполнено(СтруктураДокумента.waybillNumber)
		И СтруктураДокумента.waybillNumber <> СтруктураДокумента.number Тогда
		Замечания.Добавить("Номер ЭПД (" + СтруктураДокумента.number + ") не совпадает с номером ТН (" + СтруктураДокумента.waybillNumber + ").");
	КонецЕсли;
	
	Если СтруктураДокумента.Свойство("isIncoming")
		И СтруктураДокумента.isIncoming = Истина
		И СтруктураДокумента.Свойство("roleParticipant")
		И СтрНайти(Строка(СтруктураДокумента.roleParticipant), "2") > 0 Тогда
		Замечания.Добавить("Входящий документ: роль участника — грузополучатель.");
	КонецЕсли;
	
	Для Каждого Ключ Из Новый Массив("shipper", "consignee", "carrier") Цикл
		Ячейка = СтруктураДокумента[Ключ];
		Если ЗначениеЗаполнено(Ячейка.edoId)
			И Ячейка.edoExchangeStatus = "not_accepted"
			И Не Ячейка.isOwnOrganization Тогда
			Замечания.Добавить("Обмен ЭДО не принят для ID: " + Ячейка.edoId);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Замечания;
	
КонецФункции

&НаСервере
Процедура ДобавитьЗамечаниеПустогоИдЭДО(Замечания, ИмяСтороны, Ячейка)
	
	Если ЗначениеЗаполнено(Ячейка.name) И ПустаяСтрока(Ячейка.edoId) Тогда
		Замечания.Добавить("Не заполнен ID ЭДО " + ИмяСтороны + ".");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция МассивДатТитуловЭТН(Реквизиты)
	
	Результат = Новый Массив;
	ДобавитьДатуТитула(Результат, "Грузоотправитель", Реквизиты.ТитулГрузоотправителяДатаФормированияФайла);
	ДобавитьДатуТитула(Результат, "Перевозчик (приёмка)", Реквизиты.ТитулПеревозчикаПриемкаДатаФормированияФайла);
	ДобавитьДатуТитула(Результат, "Грузополучатель", Реквизиты.ТитулГрузополучателяДатаФормированияФайла);
	ДобавитьДатуТитула(Результат, "Перевозчик (выдача)", Реквизиты.ТитулПеревозчикаВыдачаДатаФормированияФайла);
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьДатуТитула(МассивДат, Ключ, ЗначениеДаты)
	
	Элемент = Новый Структура;
	Элемент.Вставить("key", Ключ);
	Элемент.Вставить("value", XMLСтрокаЕслиЗаполнено(ЗначениеДаты));
	МассивДат.Добавить(Элемент);
	
КонецПроцедуры

&НаСервере
Функция ЭкранироватьСтрокуJSON(Знач Строка)
	
	Результат = СтрЗаменить(Строка, "\", "\\");
	Результат = СтрЗаменить(Результат, """", "\""");
	Результат = СтрЗаменить(Результат, Символы.ПС, " ");
	Результат = СтрЗаменить(Результат, Символы.ВК, " ");
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция XMLСтрокаЕслиЗаполнено(Значение)
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат XMLСтрока(Значение);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Процедура ДобавитьИдентификаторВМассив(МассивИд, ИдЭДО)
	
	Если ЗначениеЗаполнено(ИдЭДО) Тогда
		МассивИд.Добавить(ИдЭДО);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СоответствиеКодовТиповДокументовЭПД()
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("ЭлектроннаяТранспортнаяНакладная", "ЭТрН");
	Соответствие.Вставить("ЭлектроннаяСопроводительнаяВедомость", "ЭСВ");
	Соответствие.Вставить("ЭлектронныйЗаказЗаявка", "ЭЗЗ");
	Соответствие.Вставить("ЭлектронныйЗаказНаряд", "ЭЗН");
	Соответствие.Вставить("ЭлектронныйПутевойЛист", "ЭПЛ");
	Соответствие.Вставить("ЭлектронныйДоговорФрахтования", "ЭДФ");
	Возврат Соответствие;
	
КонецФункции

&НаСервере
Функция КодТипаДокументаЭПД(СсылкаДокумента)
	
	Соответствие = СоответствиеКодовТиповДокументовЭПД();
	ИмяДокумента = СсылкаДокумента.Метаданные().Имя;
	Код = Соответствие.Получить(ИмяДокумента);
	Если Код = Неопределено Тогда
		Возврат ИмяДокумента;
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции

&НаСервере
Функция ИмяДокументаЭПДПоКоду(DocTypeCode)
	
	Если ПустаяСтрока(DocTypeCode) Тогда
		Возврат "";
	КонецЕсли;
	
	Соответствие = СоответствиеКодовТиповДокументовЭПД();
	Для Каждого КлючЗначение Из Соответствие Цикл
		Если КлючЗначение.Значение = DocTypeCode Тогда
			Возврат КлючЗначение.Ключ;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрНайти(DocTypeCode, "Электрон") > 0 Тогда
		Возврат DocTypeCode;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция НормализоватьUUIDСтроку(Ref)
	
	UUIDСтрока = СокрЛП(Ref);
	UUIDСтрока = СтрЗаменить(UUIDСтрока, "{", "");
	UUIDСтрока = СтрЗаменить(UUIDСтрока, "}", "");
	Возврат НРег(UUIDСтрока);
	
КонецФункции

&НаСервере
Функция UUIDИзСтроки(Ref)
	
	UUIDСтрока = НормализоватьUUIDСтроку(Ref);
	Если ПустаяСтрока(UUIDСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат Новый УникальныйИдентификатор(UUIDСтрока);
	Исключение
		Попытка
			Возврат Новый УникальныйИдентификатор("{" + UUIDСтрока + "}");
		Исключение
			Возврат Неопределено;
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция СсылкаДокументаЭПДИзРеестраПоUUID(UUIDСтрока)
	
	Если ПустаяСтрока(UUIDСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реестр.Ссылка КАК Ссылка
	|ИЗ
	|	РегистрСведений.РеестрЭПД КАК Реестр";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		Если НормализоватьUUIDСтроку(Строка(Выборка.Ссылка.УникальныйИдентификатор())) = UUIDСтрока Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция НаименованиеТипаДокументаЭПД(СсылкаДокумента)
	
	Возврат СсылкаДокумента.Метаданные().Синоним;
	
КонецФункции

&НаСервере
Функция СсылкаДокументаЭПДПоUUID(Ref, DocTypeCode = "")
	
	UUIDСтрока = НормализоватьUUIDСтроку(Ref);
	Если ПустаяСтрока(UUIDСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СсылкаИзКэша = СсылкаИзКэшаЭПД(UUIDСтрока);
	Если ЗначениеЗаполнено(СсылкаИзКэша) Тогда
		Возврат СсылкаИзКэша;
	КонецЕсли;
	
	УИДСсылки = UUIDИзСтроки(Ref);
	Если УИДСсылки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// 1. Тип из UI (ЭТрН, ЭСВ, …) + UUID.
	ИмяДокумента = ИмяДокументаЭПДПоКоду(DocTypeCode);
	Если ЗначениеЗаполнено(ИмяДокумента) Тогда
		Ссылка = Документы[ИмяДокумента].ПолучитьСсылку(УИДСсылки);
		Если СсылкаДокументаЭПДСуществует(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	// 2. Перебор реестра (надёжно для составных ссылок в запросах 1С).
	СсылкаИзРеестра = СсылкаДокументаЭПДИзРеестраПоUUID(UUIDСтрока);
	Если ЗначениеЗаполнено(СсылкаИзРеестра) Тогда
		Возврат СсылкаИзРеестра;
	КонецЕсли;
	
	// 3. Перебор всех типов ЭПД.
	Для Каждого ИмяТипа Из ИменаДокументовЭПД() Цикл
		Ссылка = Документы[ИмяТипа].ПолучитьСсылку(УИДСсылки);
		Если СсылкаДокументаЭПДСуществует(Ссылка) Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция СсылкаДокументаЭПДСуществует(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	" + Ссылка.Метаданные().ПолноеИмя() + " КАК Док
	|ГДЕ
	|	Док.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервере
Функция ИменаДокументовЭПД()
	
	Результат = Новый Массив;
	Результат.Добавить("ЭлектроннаяСопроводительнаяВедомость");
	Результат.Добавить("ЭлектроннаяТранспортнаяНакладная");
	Результат.Добавить("ЭлектронныйДоговорФрахтования");
	Результат.Добавить("ЭлектронныйЗаказЗаявка");
	Результат.Добавить("ЭлектронныйЗаказНаряд");
	Результат.Добавить("ЭлектронныйПутевойЛист");
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СтатусОбменаЭДО(Организация, ИдЭДО, ПринятыеПоИд)
	
	Если ПустаяСтрока(ИдЭДО) Тогда
		Возврат "unknown";
	КонецЕсли;
	
	Если ПринятыеПоИд.Получить(ИдЭДО) = Истина Тогда
		Возврат "accepted";
	КонецЕсли;
	
	Если ПриглашениеПринятоПоИдентификаторам(ИдЭДО, Организация) Тогда
		Возврат "accepted";
	КонецЕсли;
	
	Возврат "not_accepted";
	
КонецФункции

&НаСервере
Функция ПриглашениеПринятоПоИдентификаторам(ИдЭДО, Организация)
	
	ИдОрганизации = ИдентификаторЭДООрганизации(Организация);
	Если ПустаяСтрока(ИдОрганизации) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Принято
	|ИЗ
	|	РегистрСведений.ПриглашенияКОбменуЭлектроннымиДокументами КАК П
	|ГДЕ
	|	П.ИдентификаторОрганизации = &ИдОрганизации
	|	И П.ИдентификаторКонтрагента = &ИдКонтрагента
	|	И П.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПриглашений.Принято)";
	Запрос.УстановитьПараметр("ИдОрганизации", ИдОрганизации);
	Запрос.УстановитьПараметр("ИдКонтрагента", ИдЭДО);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервере
Функция ИдентификаторЭДООрганизации(Организация)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УчетныеЗаписи.ИдентификаторЭДО КАК ИдентификаторЭДО
	|ИЗ
	|	РегистрСведений.УчетныеЗаписиЭДО КАК УчетныеЗаписи
	|ГДЕ
	|	УчетныеЗаписи.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ИдентификаторЭДО;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ПринятыеИдентификаторыЭДО(ИдОрганизации, ИдКонтрагентов)
	
	Результат = Новый Соответствие;
	
	Если ПустаяСтрока(ИдОрганизации) Или ИдКонтрагентов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.ИдентификаторКонтрагента КАК ИдентификаторКонтрагента
	|ИЗ
	|	РегистрСведений.ПриглашенияКОбменуЭлектроннымиДокументами КАК П
	|ГДЕ
	|	П.ИдентификаторОрганизации = &ИдОрганизации
	|	И П.ИдентификаторКонтрагента В (&ИдКонтрагентов)
	|	И П.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПриглашений.Принято)";
	Запрос.УстановитьПараметр("ИдОрганизации", ИдОрганизации);
	Запрос.УстановитьПараметр("ИдКонтрагентов", ИдКонтрагентов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ИдентификаторКонтрагента, Истина);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьСсылкуКаталогаНаСервере(Ref)
	
	Возврат СсылкаКаталогаПоUUID(Ref);
	
КонецФункции

&НаСервере
Функция СсылкаКаталогаПоUUID(Ref)
	
	УИДСсылки = UUIDИзСтроки(Ref);
	Если УИДСсылки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Справочники.Организации.ПолучитьСсылку(УИДСсылки));
	Кандидаты.Добавить(Справочники.Контрагенты.ПолучитьСсылку(УИДСсылки));
	
	Для Каждого Кандидат Из Кандидаты Цикл
		Если СсылкаКаталогаСуществует(Кандидат) Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция СсылкаКаталогаСуществует(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Возврат ОбщегоНазначения.СсылкаСуществует(Ссылка);
	Исключение
		Попытка
			Возврат ЗначениеЗаполнено(Ссылка.ПолучитьОбъект());
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ВидСсылкиУчастника(Участник)
	
	Если Не ЗначениеЗаполнено(Участник) Тогда
		Возврат "";
	КонецЕсли;
	
	Если Участник.Метаданные().Имя = "Организации" Тогда
		Возврат "organization";
	КонецЕсли;
	
	Возврат "contragent";
	
КонецФункции

&НаСервере
Функция ДанныеДляОткрытияНастроекЭДОНаСервере(EdoId, OrgRef, EntityRef)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("ИдентификаторОрганизации", "");
	Результат.Вставить("ИдентификаторКонтрагента", "");
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("Контрагент", Неопределено);
	
	EdoId = СокрЛП(EdoId);
	Если ПустаяСтрока(EdoId) Тогда
		Результат.Сообщение = "Не указан ID ЭДО контрагента.";
		Возврат Результат;
	КонецЕсли;
	
	Организация = СсылкаКаталогаПоUUID(OrgRef);
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.Сообщение = "Не найдена организация документа.";
		Возврат Результат;
	КонецЕсли;
	
	ИдОрганизации = ИдентификаторЭДООрганизации(Организация);
	Если ПустаяСтрока(ИдОрганизации) Тогда
		Результат.Сообщение = "Для организации не настроена учётная запись ЭДО.";
		Возврат Результат;
	КонецЕсли;
	
	Контрагент = СсылкаКаталогаПоUUID(EntityRef);
	
	Результат.Успех = Истина;
	Результат.ИдентификаторОрганизации = ИдОрганизации;
	Результат.ИдентификаторКонтрагента = EdoId;
	Результат.Организация = Организация;
	Результат.Контрагент = Контрагент;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ДанныеДляОткрытияНастроекОтправкиНаСервере(EntityRef)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Контрагент", Неопределено);
	Результат.Вставить("ОрганизацияИнтеркампани", Неопределено);
	
	Участник = СсылкаКаталогаПоUUID(EntityRef);
	Если Не ЗначениеЗаполнено(Участник) Тогда
		Результат.Сообщение = "Не найден контрагент для настроек отправки.";
		Возврат Результат;
	КонецЕсли;
	
	ИмяСправочника = Участник.Метаданные().Имя;
	Если ИмяСправочника = "Контрагенты" Тогда
		Результат.Контрагент = Участник;
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;
	
	Если ИмяСправочника = "Организации" Тогда
		Результат.ОрганизацияИнтеркампани = Участник;
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Сообщение = "Настройки отправки доступны для контрагентов и организаций.";
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция JSONОшибкиДиагностикиЭДОНаСервере(ТекстОшибки)
	
	Возврат ЗаписатьJSONСтрокой(Новый Структура("error", ТекстОшибки));
	
КонецФункции

&НаСервере
Функция JSONОшибкиОнлайнИдЭДОНаСервере(ТекстОшибки)
	
	Ответ = Новый Структура;
	Ответ.Вставить("error", ТекстОшибки);
	Ответ.Вставить("onlineItems", Новый Массив);
	Ответ.Вставить("onlineLoaded", Ложь);
	Ответ.Вставить("loadWarning", ТекстОшибки);
