&НаСервере
Функция НормализоватьВерсиюSemverНаСервере(Версия)
	
	Версия = СокрЛП(Строка(Версия));
	Если ПустаяСтрока(Версия) Тогда
		Возврат "";
	КонецЕсли;
	Если Лев(НРег(Версия), 1) = "v" Тогда
		Версия = СокрЛП(Сред(Версия, 2));
	КонецЕсли;
	Возврат Версия;
	
