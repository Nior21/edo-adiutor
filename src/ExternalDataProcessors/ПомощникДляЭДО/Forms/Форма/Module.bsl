	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ИмяФайлаGitHubRelease();
	
КонецФункции

&НаСервере
Функция ПрочитатьGitHubРелизНаСервере()
	
	Результат = Новый Структура("Версия, EpfUrl, Примечания, HtmlUrl, Ошибка", "", "", "", "", "");
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Репозиторий = СокрЛП(ОбработкаОбъект.РепозиторийGitHub());
	Если ПустаяСтрока(Репозиторий) Тогда
		Результат.Ошибка = "Не задан РепозиторийGitHub() в ObjectModule.";
		Возврат Результат;
	КонецЕсли;
	
	URL = "https://api.github.com/repos/" + Репозиторий + "/releases/latest";
	Заголовки = ЗаголовкиHTTPGitHubНаСервере();
	Загрузка = HTTPПолучитьСтроку(URL, Заголовки);
	Если Не ПустаяСтрока(Загрузка.Ошибка) Тогда
		Результат.Ошибка = Загрузка.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	Данные = JSONВЗначениеНаСервере(Загрузка.Текст);
	Если Данные = Неопределено Тогда
		Результат.Ошибка = "Не удалось разобрать ответ GitHub Releases.";
		Возврат Результат;
	КонецЕсли;
	
	Тег = JSONСтрокаПоляНаСервере(Данные, "tag_name");
	Если ПустаяСтрока(Тег) Тогда
		Тег = JSONСтрокаПоляНаСервере(Данные, "name");
	КонецЕсли;
	Результат.Версия = НормализоватьВерсиюSemverНаСервере(Тег);
	Результат.HtmlUrl = JSONСтрокаПоляНаСервере(Данные, "html_url");
	Результат.Примечания = Лев(ОчиститьСтрокуДляОбмена(JSONСтрокаПоляНаСервере(Данные, "body")), 500);
	Результат.EpfUrl = URLAssetEpfИзGitHubJSONНаСервере(Данные, ИмяФайлаGitHubReleaseНаСервере());
	
	Если ПустаяСтрока(Результат.EpfUrl) Тогда
		ЗаполнитьGitHubРелизСEpfИзСпискаНаСервере(Репозиторий, Заголовки, ИмяФайлаGitHubReleaseНаСервере(), Результат);
	КонецЕсли;
	
	Если ПустаяСтрока(Результат.Версия) Тогда
		Результат.Ошибка = "В ответе GitHub нет tag_name.";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


&НаСервере
Процедура ЗаполнитьGitHubРелизСEpfИзСпискаНаСервере(Репозиторий, Заголовки, ИмяAssetEpf, Результат)
	
	URL = "https://api.github.com/repos/" + Репозиторий + "/releases?per_page=30";
	Загрузка = HTTPПолучитьСтроку(URL, Заголовки);
	Если Не ПустаяСтрока(Загрузка.Ошибка) Тогда
		Возврат;
	КонецЕсли;
	
	Список = JSONВЗначениеНаСервере(Загрузка.Текст);
	Если Список = Неопределено Или ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из Список Цикл
		EpfUrl = URLAssetEpfИзGitHubJSONНаСервере(Элемент, ИмяAssetEpf);
		Если ПустаяСтрока(EpfUrl) Тогда
			Продолжить;
		КонецЕсли;
		Тег = JSONСтрокаПоляНаСервере(Элемент, "tag_name");
		Если ПустаяСтрока(Тег) Тогда
			Тег = JSONСтрокаПоляНаСервере(Элемент, "name");
		КонецЕсли;
		Версия = НормализоватьВерсиюSemverНаСервере(Тег);
		Если ПустаяСтрока(Версия) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Версия = Версия;
		Результат.EpfUrl = EpfUrl;
		Результат.HtmlUrl = JSONСтрокаПоляНаСервере(Элемент, "html_url");
		Результат.Примечания = Лев(ОчиститьСтрокуДляОбмена(JSONСтрокаПоляНаСервере(Элемент, "body")), 500);
		Возврат;
	КонецЦикла;
	
КонецПроцедуры

