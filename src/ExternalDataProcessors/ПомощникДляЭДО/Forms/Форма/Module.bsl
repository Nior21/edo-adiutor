#Область ОписаниеПеременных

// Установите Истина для сообщений о загрузке React в окне 1С (диагностика).
&НаКлиенте
Перем ОтладкаReact;

&НаКлиенте
Перем ReactГотов;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.АдресHTML = "";
	Объект.АдресМакета = "";
	ПолеHTML = "";
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Попытка
		ДвоичныеДанныеМакета = ОбработкаОбъект.ПолучитьМакет(ОбработкаОбъект.ИмяМакетаReact());
		
		Если ДвоичныеДанныеМакета = Неопределено Или ДвоичныеДанныеМакета.Размер() = 0 Тогда
			ВызватьИсключение "Макет React пуст";
		КонецЕсли;
		
		// Inline HTML (CSS + IIFE JS в одном файле). Идентификатор формы — для чтения на клиенте.
		Объект.АдресHTML = ПоместитьВоВременноеХранилище(ДвоичныеДанныеМакета, УникальныйИдентификатор);
		ЗаписатьДиагностикуReact(
			"HTML React UI помещён во временное хранилище. Размер: "
			+ Формат(ДвоичныеДанныеМакета.Размер(), "ЧГ=0")
			+ ", версия UI: "
			+ ОбработкаОбъект.ВерсияПриложения());
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		ЗаписатьДиагностикуReact("Ошибка загрузки макета React: " + ТекстОшибки, Истина);
		ОбщегоНазначения.СообщитьПользователю(
			"Макет ReactПриложение не найден или пуст. Выполните scripts/pack.ps1 и обновите макет в EDT.");
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ReactГотов = Ложь;
	// Подробные сообщения в панели 1С. Выключите, когда всё заработает.
	ОтладкаReact = Истина;
	
	Если ПустаяСтрока(Объект.АдресHTML) Тогда
		ПолеHTML = HTMLСтраницаДиагностики("HTML React UI не загружен на сервере. Выполните pack.ps1 и F7.");
		ЛогReact("АдресHTML пуст", Истина);
		Возврат;
	КонецЕсли;
	
	РезультатЗагрузки = ПолучитьReactHTMLНаСервере();
	ЛогReact(РезультатЗагрузки.Сообщение, Истина);
	Если РезультатЗагрузки.Успех Тогда
		ПолеHTML = РезультатЗагрузки.HTML;
	Иначе
		ПолеHTML = HTMLСтраницаДиагностики(РезультатЗагрузки.Сообщение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеHTMLДокументСформирован(Элемент)
	
	Если Элементы.ПолеHTML.Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ПолеHTML.Документ.readyState <> "complete" Тогда
		Возврат;
	КонецЕсли;
	
	// Резерв, если action=ready из JS не пришёл.
	ПодключитьОбработчикОжидания("ОтложеннаяИнициализацияReact", 2, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Если ДанныеСобытия = Неопределено Или Не ЗначениеЗаполнено(ДанныеСобытия.Href) Тогда
		Возврат;
	КонецЕсли;
	
	Href = ДанныеСобытия.Href;
	Если Не СтрНачинаетсяС(НРег(Href), "onec:") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	ОбработатьКомандуМоста(Href);
	
КонецПроцедуры

#КонецОбласти

#Область ЗагрузкаReact

&НаСервере
Функция ПолучитьReactHTMLНаСервере()
	
	Результат = Новый Структура("Успех, HTML, Сообщение", Ложь, "", "");
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Результат.Сообщение = "Версия UI: " + ОбработкаОбъект.ВерсияПриложения();
	
	Если ПустаяСтрока(Объект.АдресHTML) Тогда
		Результат.Сообщение = Результат.Сообщение + ". АдресHTML пуст. Обновите базу из EDT.";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ДвоичныеДанныеМакета = ПолучитьИзВременногоХранилища(Объект.АдресHTML);
		ТекстHTML = ПолучитьСтрокуИзДвоичныхДанных(ДвоичныеДанныеМакета, КодировкаТекста.UTF8);
		Размер = СтрДлина(ТекстHTML);
		
		Если Размер < 1000 Тогда
			Результат.Сообщение = "Макет слишком мал (" + Формат(Размер, "ЧГ=0") + " симв.). Пересоберите pack.ps1.";
			Возврат Результат;
		КонецЕсли;
		
		Если СтрНайти(НРег(ТекстHTML), "<html") = 0 Тогда
			Результат.Сообщение = "Макет не похож на HTML (нет тега html). Проверьте Template.bin.";
			Возврат Результат;
		КонецЕсли;
		
		Если СтрНайти(НРег(ТекстHTML), "type=""module""") > 0
			Или СтрНайти(НРег(ТекстHTML), "type='module'") > 0 Тогда
			Результат.Сообщение = "В макете найден type=module — WebKit 1С его не выполняет. Пересоберите pack.ps1.";
			Возврат Результат;
		КонецЕсли;
		
		Результат.HTML = ТекстHTML;
		Результат.Успех = Истина;
		Результат.Сообщение = Результат.Сообщение
			+ ". Inline HTML, длина "
			+ Формат(Размер, "ЧГ=0")
			+ " симв.";
	Исключение
		Результат.Сообщение = "Ошибка чтения HTML из временного хранилища: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОтложеннаяИнициализацияReact() Экспорт
	
	Если ReactГотов Тогда
		Возврат;
	КонецЕсли;
	
	ЛогReact("Резервная инициализация React (ready не пришёл)", Истина);
	ReactГотов = Истина;
	ОтправитьСписокЭТНВИнтерфейс();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛогReact(Текст, Всегда = Ложь)
	
	Если Всегда Или ОтладкаReact Тогда
		Сообщить("[ПомощникЭДО] " + Текст);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДиагностикуReact(Текст, ЭтоОшибка = Ложь)
	
	Уровень = ?(ЭтоОшибка, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация);
	ЗаписьЖурналаРегистрации("ПомощникДляЭДО.React", Уровень, , , Текст);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция HTMLСтраницаДиагностики(ТекстОшибки)
	
	Текст = СтрЗаменить(ТекстОшибки, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	
	Возврат "<!DOCTYPE html><html lang=""ru""><head><meta charset=""UTF-8""><title>Помощник ЭДО</title></head>"
		+ "<body style=""font-family:Segoe UI,sans-serif;padding:16px;background:#fff8f0"">"
		+ "<h2 style=""color:#c00;margin-top:0"">Помощник ЭДО — диагностика</h2>"
		+ "<p>" + Текст + "</p>"
		+ "<p>1. scripts/pack.ps1<br>2. Обновление конфигурации в EDT<br>3. Открыть обработку из обновлённой базы</p>"
		+ "</body></html>";
	
КонецФункции

#КонецОбласти

#Область МостReact

&НаКлиенте
Функция View()
	
	Если Элементы.ПолеHTML.Документ = Неопределено Тогда
		ВызватьИсключение "HTML-документ не создан";
	КонецЕсли;
	
	Если Элементы.ПолеHTML.Документ.defaultView = Неопределено Тогда
		ВызватьИсключение "defaultView HTML-документа недоступен";
	КонецЕсли;
	
	Возврат Элементы.ПолеHTML.Документ.defaultView;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьКомандуМоста(Href)
	
	Попытка
		Команда = РазобратьКомандуМостаНаСервере(Href);
	Исключение
		СообщитьBridgeОшибку(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	Если Команда.Действие = "ready" Тогда
		ReactГотов = Истина;
		ЛогReact("React сообщил о готовности (action=ready)");
		ОтправитьСписокЭТНВИнтерфейс();
	ИначеЕсли Команда.Действие = "getList" Тогда
		ОтправитьСписокЭТНВИнтерфейс();
	ИначеЕсли Команда.Действие = "getDocument" Тогда
		ОтправитьДокументЭТНВИнтерфейс(Команда.Ref);
	ИначеЕсли Команда.Действие = "saveComment" Тогда
		Результат = СохранитьКомментарийЭТННаСервере(Команда.Ref, Команда.Comment);
		Если Результат.Успех Тогда
			СообщитьBridgeСтатус("Комментарий сохранён.");
			ОтправитьДокументЭТНВИнтерфейс(Команда.Ref);
		Иначе
			СообщитьBridgeОшибку(Результат.Сообщение);
		КонецЕсли;
	Иначе
		СообщитьBridgeОшибку("Неизвестная команда моста: " + Команда.Действие);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСписокЭТНВИнтерфейс()
	
	JSON = ПолучитьСписокЭТНJSONНаСервере();
	Попытка
		View().edoInit(JSON);
	Исключение
		СообщитьBridgeОшибку("React UI ещё не готов: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьДокументЭТНВИнтерфейс(Ref)
	
	JSON = ПолучитьДокументЭТНJSONНаСервере(Ref);
	Попытка
		View().edoSetDocument(JSON);
	Исключение
		СообщитьBridgeОшибку("Не удалось передать документ в React UI: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьBridgeСтатус(Текст)
	
	Попытка
		View().edoSetStatus(Текст);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СообщитьBridgeОшибку(Текст)
	
	Попытка
		View().edoSetError(Текст);
	Исключение
		ПоказатьПредупреждение(, Текст);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СерверныеAPI

&НаСервере
Функция РазобратьКомандуМостаНаСервере(Href)
	
	ПозицияQuery = СтрНайти(Href, "?");
	Если ПозицияQuery = 0 Тогда
		ВызватьИсключение "В команде моста отсутствуют параметры";
	КонецЕсли;
	
	ПараметрыЗапроса = ПараметрыЗапросаИзСтроки(Сред(Href, ПозицияQuery + 1));
	Действие = ЗначениеПараметраЗапроса(ПараметрыЗапроса, "action");
	
	Если ПустаяСтрока(Действие) Тогда
		ВызватьИсключение "В команде моста отсутствует параметр action";
	КонецЕсли;
	
	Команда = Новый Структура;
	Команда.Вставить("Действие", Действие);
	Команда.Вставить("Ref", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "ref"));
	Команда.Вставить("Comment", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "comment"));
	
	Возврат Команда;
	
КонецФункции

&НаСервере
Функция ПараметрыЗапросаИзСтроки(QueryString)
	
	Результат = Новый Соответствие;
	
	Для Каждого Часть Из СтрРазделить(QueryString, "&", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Имя = Сред(Часть, 1, Позиция - 1);
		Значение = РаскодироватьПроцентыURL(Сред(Часть, Позиция + 1));
		Результат.Вставить(Имя, Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗначениеПараметраЗапроса(ПараметрыЗапроса, Имя)
	
	Значение = ПараметрыЗапроса.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаСервере
Функция РаскодироватьПроцентыURL(Знач Строка)
	
	Результат = СтрЗаменить(Строка, "+", " ");
	
	Пока Истина Цикл
		Позиция = СтрНайти(Результат, "%");
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если Позиция + 2 > СтрДлина(Результат) Тогда
			ВызватьИсключение "Некорректное URL-кодирование в параметре data";
		КонецЕсли;
		
		КодСимвола = ШестнадцатеричноеВЧисло(Сред(Результат, Позиция + 1, 2));
		Результат = Лев(Результат, Позиция - 1) + Символ(КодСимвола) + Сред(Результат, Позиция + 3);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ШестнадцатеричноеВЧисло(Hex)
	
	Hex = ВРег(Hex);
	Результат = 0;
	
	Для Индекс = 1 По 2 Цикл
		СимволHex = Сред(Hex, Индекс, 1);
		Если СимволHex >= "0" И СимволHex <= "9" Тогда
			Цифра = Число(СимволHex);
		ИначеЕсли СимволHex >= "A" И СимволHex <= "F" Тогда
			Цифра = КодСимвола(СимволHex) - КодСимвола("A") + 10;
		Иначе
			ВызватьИсключение "Некорректный hex-символ в URL: " + Hex;
		КонецЕсли;
		Результат = Результат * 16 + Цифра;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьВерсиюПриложенияНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ВерсияПриложения();
	
КонецФункции

&НаСервере
Функция ПолучитьСписокЭТНJSONНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Данные = Новый Структура;
	Данные.Вставить("version", ОбработкаОбъект.ВерсияПриложения());
	Данные.Вставить("items", ПолучитьСписокЭТН());
	Возврат ЗаписатьJSONСтрокой(Данные);
	
КонецФункции

&НаСервере
Функция ПолучитьДокументЭТНJSONНаСервере(Ref)
	
	Документ = ПолучитьДокументЭТН(Ref);
	Если Документ = Неопределено Тогда
		Возврат ЗаписатьJSONСтрокой(Неопределено);
	КонецЕсли;
	
	Возврат ЗаписатьJSONСтрокой(Документ);
	
КонецФункции

&НаСервере
Функция ПолучитьСписокЭТН()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 100
	|	ЭТН.Ссылка КАК Ссылка,
	|	ЭТН.Номер КАК Номер,
	|	ЭТН.Дата КАК Дата,
	|	ЭТН.Комментарий КАК Комментарий,
	|	ЭТН.УИДМинтранс КАК УИДМинтранс,
	|	ПРЕДСТАВЛЕНИЕ(ЭТН.Организация) КАК Организация,
	|	ПРЕДСТАВЛЕНИЕ(ЭТН.ТекущийТитул) КАК ТекущийТитул,
	|	ЭТН.ТитулГрузоотправителяТранспортнаяНакладнаяНомер КАК НомерТН,
	|	ЭТН.ТитулГрузоотправителяТранспортнаяНакладнаяДата КАК ДатаТН,
	|	ЭТН.ЭтоВходящий КАК ЭтоВходящий
	|ИЗ
	|	Документ.ЭлектроннаяТранспортнаяНакладная КАК ЭТН
	|ГДЕ
	|	НЕ ЭТН.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭТН.Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(СтруктураЭТНИзВыборки(Выборка, Ложь));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьДокументЭТН(Ref)
	
	Ссылка = СсылкаЭТНПоUUID(Ref);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭТН.Ссылка КАК Ссылка,
	|	ЭТН.Номер КАК Номер,
	|	ЭТН.Дата КАК Дата,
	|	ЭТН.Комментарий КАК Комментарий,
	|	ЭТН.УИДМинтранс КАК УИДМинтранс,
	|	ЭТН.Организация КАК ОрганизацияСсылка,
	|	ПРЕДСТАВЛЕНИЕ(ЭТН.Организация) КАК Организация,
	|	ПРЕДСТАВЛЕНИЕ(ЭТН.ТекущийТитул) КАК ТекущийТитул,
	|	ЭТН.ТитулГрузоотправителяТранспортнаяНакладнаяНомер КАК НомерТН,
	|	ЭТН.ТитулГрузоотправителяТранспортнаяНакладнаяДата КАК ДатаТН,
	|	ЭТН.ЭтоВходящий КАК ЭтоВходящий,
	|	ПРЕДСТАВЛЕНИЕ(ЭТН.РольУчастника) КАК РольУчастника,
	|	ПРЕДСТАВЛЕНИЕ(ЭТН.ТекущийШаг) КАК ТекущийШаг,
	|	ЭТН.ТекущийШагВыполнен КАК ТекущийШагВыполнен
	|ИЗ
	|	Документ.ЭлектроннаяТранспортнаяНакладная КАК ЭТН
	|ГДЕ
	|	ЭТН.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СтруктураЭТНИзВыборки(Выборка, Истина);
	
КонецФункции

&НаСервере
Функция СохранитьКомментарийЭТННаСервере(Ref, Comment)
	
	Результат = Новый Структура("Успех, Сообщение", Ложь, "");
	Ссылка = СсылкаЭТНПоUUID(Ref);
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Результат.Сообщение = "Документ ЭТН не найден.";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ОбъектДокумента = Ссылка.ПолучитьОбъект();
		ОбъектДокумента.Комментарий = Comment;
		ОбъектДокумента.Записать();
		Результат.Успех = Истина;
	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СтруктураЭТНИзВыборки(Выборка, Подробно)
	
	СтруктураДокумента = Новый Структура;
	СтруктураДокумента.Вставить("ref", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
	СтруктураДокумента.Вставить("docType", "ЭТрН");
	СтруктураДокумента.Вставить("number", Строка(Выборка.Номер));
	СтруктураДокумента.Вставить("date", XMLСтрока(Выборка.Дата));
	СтруктураДокумента.Вставить("comment", Строка(Выборка.Комментарий));
	СтруктураДокумента.Вставить("uidMintrans", Строка(Выборка.УИДМинтранс));
	СтруктураДокумента.Вставить("organization", Строка(Выборка.Организация));
	СтруктураДокумента.Вставить("currentTitle", Строка(Выборка.ТекущийТитул));
	СтруктураДокумента.Вставить("waybillNumber", Строка(Выборка.НомерТН));
	СтруктураДокумента.Вставить("waybillDate", ?(ЗначениеЗаполнено(Выборка.ДатаТН), XMLСтрока(Выборка.ДатаТН), ""));
	СтруктураДокумента.Вставить("isIncoming", Выборка.ЭтоВходящий);
	
	Если Подробно Тогда
		СтруктураДокумента.Вставить("roleParticipant", Строка(Выборка.РольУчастника));
		СтруктураДокумента.Вставить("currentStep", Строка(Выборка.ТекущийШаг));
		СтруктураДокумента.Вставить("currentStepDone", Выборка.ТекущийШагВыполнен);
		СтруктураДокумента.Вставить("parties", ПолучитьСтороныЭТН(Выборка.Ссылка, Выборка.ОрганизацияСсылка));
	КонецЕсли;
	
	Возврат СтруктураДокумента;
	
КонецФункции

&НаСервере
Функция ПолучитьСтороныЭТН(СсылкаЭТН, ОрганизацияДокумента)
	
	ОписанияСторон = Новый Массив;
	ОписанияСторон.Добавить(Новый Структура("role, roleLabel, refField, idField",
		"shipper", "Грузоотправитель", "СсылкаТитулГрузоотправителяГрузоотправитель", "ИдентификаторГрузоотправителя"));
	ОписанияСторон.Добавить(Новый Структура("role, roleLabel, refField, idField",
		"consignee", "Грузополучатель", "СсылкаТитулГрузоотправителяГрузополучатель", "ИдентификаторГрузополучателя"));
	ОписанияСторон.Добавить(Новый Структура("role, roleLabel, refField, idField",
		"carrier", "Перевозчик", "СсылкаТитулГрузоотправителяПеревозчик", "ИдентификаторПеревозчика"));
	ОписанияСторон.Добавить(Новый Структура("role, roleLabel, refField, idField",
		"customer", "Заказчик", "СсылкаТитулГрузоотправителяЗаказчик", ""));
	
	ИменаРеквизитов = "ИдентификаторГрузоотправителя, ИдентификаторГрузополучателя, ИдентификаторПеревозчика,
		|СсылкаТитулГрузоотправителяГрузоотправитель, СсылкаТитулГрузоотправителяГрузополучатель,
		|СсылкаТитулГрузоотправителяПеревозчик, СсылкаТитулГрузоотправителяЗаказчик";
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаЭТН, ИменаРеквизитов);
	
	ИдОрганизации = ИдентификаторЭДООрганизации(ОрганизацияДокумента);
	ИдКонтрагентов = Новый Массив;
	Результат = Новый Массив;
	
	Для Каждого Описание Из ОписанияСторон Цикл
		Участник = Реквизиты[Описание.refField];
		ИдЭДО = "";
		Если ЗначениеЗаполнено(Описание.idField) Тогда
			ИдЭДО = Строка(Реквизиты[Описание.idField]);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Участник) И ПустаяСтрока(ИдЭДО) Тогда
			Продолжить;
		КонецЕсли;
		
		ИНН = "";
		КПП = "";
		Если ЗначениеЗаполнено(Участник) Тогда
			РеквУчастника = ОбменСГИСЭПД.ПолучитьРеквизитыУчастника(Участник);
			ИНН = Строка(?(ЗначениеЗаполнено(РеквУчастника.ЮЛ_ИНН), РеквУчастника.ЮЛ_ИНН, РеквУчастника.ИП_ИНН));
			КПП = Строка(РеквУчастника.ЮЛ_КПП);
		ИначеЕсли ЗначениеЗаполнено(ИдЭДО) Тогда
			РеквАбонента = РеквизитыАбонентаЭДО(ИдЭДО);
			ИНН = РеквАбонента.ИНН;
			КПП = РеквАбонента.КПП;
		КонецЕсли;
		
		Сторона = Новый Структура;
		Сторона.Вставить("role", Описание.role);
		Сторона.Вставить("roleLabel", Описание.roleLabel);
		Сторона.Вставить("participantName", ?(ЗначениеЗаполнено(Участник), Строка(Участник), ""));
		Сторона.Вставить("inn", ИНН);
		Сторона.Вставить("kpp", КПП);
		Сторона.Вставить("edoId", ИдЭДО);
		
		Если ЗначениеЗаполнено(ИдЭДО) Тогда
			ИдКонтрагентов.Добавить(ИдЭДО);
		КонецЕсли;
		
		Результат.Добавить(Сторона);
	КонецЦикла;
	
	Принятые = ПринятыеИдентификаторыЭДО(ИдОрганизации, ИдКонтрагентов);
	
	Для Каждого Сторона Из Результат Цикл
		Сторона.Вставить("edoExchangeStatus", СтатусОбменаЭДО(ОрганизацияДокумента, Сторона.edoId, Принятые));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СтатусОбменаЭДО(Организация, ИдЭДО, ПринятыеПоИд)
	
	Если ПустаяСтрока(ИдЭДО) Тогда
		Возврат "unknown";
	КонецЕсли;
	
	Если ПринятыеПоИд.Получить(ИдЭДО) = Истина Тогда
		Возврат "accepted";
	КонецЕсли;
	
	Если ПриглашениеПринятоПоИдентификаторам(ИдЭДО, Организация) Тогда
		Возврат "accepted";
	КонецЕсли;
	
	Возврат "not_accepted";
	
КонецФункции

&НаСервере
Функция ПриглашениеПринятоПоИдентификаторам(ИдЭДО, Организация)
	
	ИдОрганизации = ИдентификаторЭДООрганизации(Организация);
	Если ПустаяСтрока(ИдОрганизации) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Принято
	|ИЗ
	|	РегистрСведений.ПриглашенияКОбменуЭлектроннымиДокументами КАК П
	|ГДЕ
	|	П.ИдентификаторОрганизации = &ИдОрганизации
	|	И П.ИдентификаторКонтрагента = &ИдКонтрагента
	|	И П.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПриглашений.Принято)";
	Запрос.УстановитьПараметр("ИдОрганизации", ИдОрганизации);
	Запрос.УстановитьПараметр("ИдКонтрагента", ИдЭДО);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервере
Функция ИдентификаторЭДООрганизации(Организация)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УчетныеЗаписи.ИдентификаторЭДО КАК ИдентификаторЭДО
	|ИЗ
	|	РегистрСведений.УчетныеЗаписиЭДО КАК УчетныеЗаписи
	|ГДЕ
	|	УчетныеЗаписи.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ИдентификаторЭДО;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция ПринятыеИдентификаторыЭДО(ИдОрганизации, ИдКонтрагентов)
	
	Результат = Новый Соответствие;
	
	Если ПустаяСтрока(ИдОрганизации) Или ИдКонтрагентов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.ИдентификаторКонтрагента КАК ИдентификаторКонтрагента
	|ИЗ
	|	РегистрСведений.ПриглашенияКОбменуЭлектроннымиДокументами КАК П
	|ГДЕ
	|	П.ИдентификаторОрганизации = &ИдОрганизации
	|	И П.ИдентификаторКонтрагента В (&ИдКонтрагентов)
	|	И П.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПриглашений.Принято)";
	Запрос.УстановитьПараметр("ИдОрганизации", ИдОрганизации);
	Запрос.УстановитьПараметр("ИдКонтрагентов", ИдКонтрагентов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ИдентификаторКонтрагента, Истина);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция РеквизитыАбонентаЭДО(ИдЭДО)
	
	Результат = Новый Структура("ИНН, КПП", "", "");
	Если ПустаяСтрока(ИдЭДО) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Абоненты.ИНН КАК ИНН,
	|	Абоненты.КПП КАК КПП
	|ИЗ
	|	РегистрСведений.АбонентыЭДО КАК Абоненты
	|ГДЕ
	|	Абоненты.ИдентификаторЭДО = &ИдЭДО";
	Запрос.УстановитьПараметр("ИдЭДО", ИдЭДО);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ИНН = Строка(Выборка.ИНН);
		Результат.КПП = Строка(Выборка.КПП);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СсылкаЭТНПоUUID(Ref)
	
	Если ПустаяСтрока(Ref) Тогда
		Возврат Документы.ЭлектроннаяТранспортнаяНакладная.ПустаяСсылка();
	КонецЕсли;
	
	Попытка
		UUID = Новый УникальныйИдентификатор(Ref);
	Исключение
		Возврат Документы.ЭлектроннаяТранспортнаяНакладная.ПустаяСсылка();
	КонецПопытки;
	
	Возврат Документы.ЭлектроннаяТранспортнаяНакладная.ПолучитьСсылку(UUID);
	
КонецФункции

&НаСервере
Функция ЗаписатьJSONСтрокой(Значение)
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

#КонецОбласти
