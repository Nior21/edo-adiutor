&НаКлиенте
Процедура ОтправитьРезультатОбновленияВИнтерфейс(Успех, Сообщение, TargetPath, LatestVersion, LaunchedPath = "", РезультатАктивации = Неопределено)
	
	Ответ = Новый Структура;
	Ответ.Вставить("phase", "apply");
	Ответ.Вставить("success", Успех);
	Ответ.Вставить("message", Сообщение);
	Ответ.Вставить("targetPath", TargetPath);
	Ответ.Вставить("latestVersion", LatestVersion);
	Ответ.Вставить("launchedPath", LaunchedPath);
	Ответ.Вставить("currentVersion", ВерсияПриложенияНаКлиенте());
	Если РезультатАктивации <> Неопределено Тогда
		Ответ.Вставить("anchorReplaced", РезультатАктивации.ЯкорьОбновлен = Истина);
		Ответ.Вставить("openedNewWindow", РезультатАктивации.ОткрытоНовоеОкно = Истина);
		Ответ.Вставить("reloadedInPlace", РезультатАктивации.ПерезагруженоВЭтомОкне = Истина);
	КонецЕсли;
	
	JSON = ЗаписатьJSONСтрокойНаКлиенте(Ответ);
	Попытка
		View().edoSetUpdateInfo(JSON);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
