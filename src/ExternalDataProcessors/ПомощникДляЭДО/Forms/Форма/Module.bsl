#КонецОбласти

#Область СерверныеAPI

&НаСервере
Функция РазобратьКомандуМостаНаСервере(Href)
	
	ПозицияQuery = СтрНайти(Href, "?");
	Если ПозицияQuery = 0 Тогда
		ВызватьИсключение "В команде моста отсутствуют параметры";
	КонецЕсли;
	
	ПараметрыЗапроса = ПараметрыЗапросаИзСтроки(Сред(Href, ПозицияQuery + 1));
	Действие = ЗначениеПараметраЗапроса(ПараметрыЗапроса, "action");
	
	Если ПустаяСтрока(Действие) Тогда
		ВызватьИсключение "В команде моста отсутствует параметр action";
	КонецЕсли;
	
	Команда = Новый Структура;
	Команда.Вставить("Действие", Действие);
	Команда.Вставить("Ref", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "ref"));
	Команда.Вставить("DocType", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "docType"));
	Команда.Вставить("Comment", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "comment"));
	Команда.Вставить("EdoId", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "edoId"));
	Команда.Вставить("OrgRef", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "orgRef"));
	Команда.Вставить("EntityRef", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "entityRef"));
	Команда.Вставить("Offset", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "offset"));
	Команда.Вставить("Limit", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "limit"));
	Команда.Вставить("Refs", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "refs"));
	Команда.Вставить("TargetPath", ЗначениеПараметраЗапроса(ПараметрыЗапроса, "targetPath"));
	
	Возврат Команда;
	
КонецФункции

&НаСервере
Функция ПараметрыЗапросаИзСтроки(QueryString)
	
	Результат = Новый Соответствие;
	
	Для Каждого Часть Из СтрРазделить(QueryString, "&", Ложь) Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Имя = Сред(Часть, 1, Позиция - 1);
		Значение = РаскодироватьПроцентыURL(Сред(Часть, Позиция + 1));
		Результат.Вставить(Имя, Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗначениеПараметраЗапроса(ПараметрыЗапроса, Имя)
	
	Значение = ПараметрыЗапроса.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

&НаСервере
Функция РаскодироватьПроцентыURL(Знач Строка)
	
	// КодировкаURL корректно раскодирует UTF-8 (%D0%A7…), в отличие от посимвольного Символ().
	Результат = РаскодироватьСтроку(Строка, СпособКодированияСтроки.КодировкаURL);
	// Пробелы в query-string часто приходят как «+».
	Возврат СтрЗаменить(Результат, "+", " ");
	
КонецФункции

&НаСервере
Функция ПолучитьВерсиюПриложенияНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Возврат ОбработкаОбъект.ВерсияПриложения();
	
КонецФункции

&НаСервере
Функция ПолучитьСписокЭПДJSONНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Данные = Новый Структура;
	Данные.Вставить("version", ОбработкаОбъект.ВерсияПриложения());
	Данные.Вставить("items", ПолучитьСписокЭПД());
	Возврат ЗаписатьJSONСтрокой(Данные);
	
КонецФункции

&НаСервере
Функция ПолучитьМетаСпискаЭПДJSONНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Данные = Новый Структура;
	Данные.Вставить("version", ОбработкаОбъект.ВерсияПриложения());
	Данные.Вставить("total", ПолучитьКоличествоЭПД());
	Возврат ЗаписатьJSONСтрокой(Данные);
	
КонецФункции

&НаСервере
Функция ПолучитьСтраницуСпискаЭПДJSONНаСервере(OffsetStr, LimitStr)
	
	Offset = ЧислоПараметраМоста(OffsetStr, 0);
	Limit = ЧислоПараметраМоста(LimitStr, 20);
	Если Limit <= 0 Тогда
		Limit = 20;
	КонецЕсли;
	Если Limit > 50 Тогда
		Limit = 50;
	КонецЕсли;
	
	Страница = ПолучитьСтраницуЭПД(Offset, Limit);
	Данные = Новый Структура;
	Данные.Вставить("offset", Offset);
	Данные.Вставить("limit", Limit);
	Данные.Вставить("total", Страница.Total);
	Данные.Вставить("items", Страница.Items);
	Возврат ЗаписатьJSONСтрокой(Данные);
	
КонецФункции

&НаСервере
Функция ОбогатитьСтрокиЭПДJSONНаСервере(RefsCSV)
	
	МассивRef = РазобратьСписокRefCSV(RefsCSV);
	Обновления = ОбогатитьСтрокиЭПД(МассивRef);
	Данные = Новый Структура;
	Данные.Вставить("updates", Обновления);
	Возврат ЗаписатьJSONСтрокой(Данные);
	
КонецФункции

&НаСервере
Функция ЧислоПараметраМоста(Значение, ЗначениеПоУмолчанию)
	
	Если ПустаяСтрока(Значение) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция РазобратьСписокRefCSV(RefsCSV)
	
	Результат = Новый Массив;
	Если ПустаяСтрока(RefsCSV) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Часть Из СтрРазделить(RefsCSV, ",", Ложь) Цикл
		Ref = СокрЛП(Часть);
		Если Не ПустаяСтрока(НормализоватьUUIDСтроку(Ref)) Тогда
			Результат.Добавить(Ref);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьКоличествоЭПД()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Реестр.Ссылка) КАК Количество
	|ИЗ
	|	РегистрСведений.РеестрЭПД КАК Реестр";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

&НаСервере
Функция ПолучитьСтраницуЭПД(Offset, Limit)
	
	Результат = Новый Структура("Total, Items", ПолучитьКоличествоЭПД(), Новый Массив);
	
	Если Limit <= 0 Или Offset < 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если КэшСсылокЭПДUUID = Неопределено Тогда
		КэшСсылокЭПДUUID = Новый Соответствие;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаСтраницыРеестраЭПД(Limit, Offset);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьСсылкуВКэшЭПД(Выборка.Ссылка);
		Результат.Items.Добавить(СтруктураДокументаИзРеестраЛегкая(Выборка));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ТекстЗапросаСтраницыРеестраЭПД(Limit, Offset)
	
	Limit = Макс(1, Мин(Limit, 50));
	Offset = Макс(0, Offset);
	
	ТекстПолей =
	"	Реестр.Ссылка КАК Ссылка,
	|	Реестр.Организация КАК ОрганизацияСсылка,
	|	ПРЕДСТАВЛЕНИЕ(Реестр.Организация) КАК Организация,
	|	Реестр.НомерЭПД КАК НомерЭПД,
	|	Реестр.ДатаЭПД КАК ДатаЭПД,
	|	Реестр.НомерДокументаИБ КАК НомерДокументаИБ,
	|	Реестр.Грузоотправитель КАК Грузоотправитель,
	|	Реестр.Грузополучатель КАК Грузополучатель,
	|	Реестр.Перевозчик КАК Перевозчик,
	|	Реестр.ТекущийШаг КАК ТекущийШаг,
	|	Реестр.ТекущийШагВыполнен КАК ТекущийШагВыполнен,
	|	Реестр.Проведен КАК Проведен,
	|	Реестр.ПометкаУдаления КАК ПометкаУдаления,
	|	Реестр.Комментарий КАК Комментарий";
	
	ТекстСортировки =
	"УПОРЯДОЧИТЬ ПО
	|	Реестр.ДатаЭПД УБЫВ,
	|	Реестр.НомерЭПД УБЫВ";
	
	Если Offset > 0 Тогда
		Возврат СтрШаблон(
			"ВЫБРАТЬ ПЕРВЫЕ %1
			|%2
			|ИЗ
			|	РегистрСведений.РеестрЭПД КАК Реестр
			|ГДЕ
			|	Реестр.Ссылка НЕ В (
			|		ВЫБРАТЬ ПЕРВЫЕ %3
			|			Р2.Ссылка
			|		ИЗ
			|			РегистрСведений.РеестрЭПД КАК Р2
			|		УПОРЯДОЧИТЬ ПО
			|			Р2.ДатаЭПД УБЫВ,
			|			Р2.НомерЭПД УБЫВ)
			|%4",
			Limit,
			ТекстПолей,
			Offset,
			ТекстСортировки);
	КонецЕсли;
	
	Возврат СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ %1
		|%2
		|ИЗ
		|	РегистрСведений.РеестрЭПД КАК Реестр
		|%3",
		Limit,
		ТекстПолей,
		ТекстСортировки);
	
КонецФункции

&НаСервере
Функция ОбогатитьСтрокиЭПД(МассивRef)
	
	Обновления = Новый Массив;
	
	Для Каждого Ref Из МассивRef Цикл
		СтрокаОбогащения = ОбогатитьСтрокуЭПДПоRef(Ref);
		Если СтрокаОбогащения <> Неопределено Тогда
			Обновления.Добавить(СтрокаОбогащения);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Обновления;
	
КонецФункции

&НаСервере
Функция ОбогатитьСтрокуЭПДПоRef(Ref)
	
	Ссылка = СсылкаИзКэшаЭПД(НормализоватьUUIDСтроку(Ref));
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Ссылка = СсылкаДокументаЭПДПоUUID(Ref, "");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаСтрокиРеестраЭПДПоСсылке();
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПолнаяСтрока = СтруктураДокументаИзРеестра(Выборка, Ложь);
	Обновление = Новый Структура;
	Обновление.Вставить("ref", ПолнаяСтрока.ref);
	Обновление.Вставить("shipper", ПолнаяСтрока.shipper);
	Обновление.Вставить("carrier", ПолнаяСтрока.carrier);
	Обновление.Вставить("consignee", ПолнаяСтрока.consignee);
	
	Возврат Обновление;
	
КонецФункции

