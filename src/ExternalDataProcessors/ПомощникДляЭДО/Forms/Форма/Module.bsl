&НаСервере
Функция ЗаголовокLocationHTTPНаСервере(ОтветHTTP)
	
	Если ОтветHTTP = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Заголовки = ОтветHTTP.Заголовки;
	Если Заголовки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Для Каждого Пара Из Заголовки Цикл
		Если НРег(СокрЛП(Пара.Ключ)) = "location" Тогда
			Возврат СокрЛП(Строка(Пара.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция АбсолютныйURLРедиректаНаСервере(БазовыйURL, Location)
	
	Location = СокрЛП(Location);
	Если ПустаяСтрока(Location) Тогда
		Возврат "";
	КонецЕсли;
	
	НРегLoc = НРег(Location);
	Если СтрНачинаетсяС(НРегLoc, "http://") Или СтрНачинаетсяС(НРегLoc, "https://") Тогда
		Возврат Location;
	КонецЕсли;
	
	Попытка
		URI = ОбщегоНазначенияКлиентСервер.СтруктураURI(БазовыйURL);
	Исключение
		Возврат "";
	КонецПопытки;
	
	Схема = СокрЛП(URI.Схема);
	Хост = СокрЛП(URI.Хост);
	ПортСтрока = "";
	Если ЗначениеЗаполнено(URI.Порт) Тогда
		Порт = Число(URI.Порт);
		Если (НРег(Схема) = "https" И Порт <> 443) Или (НРег(Схема) = "http" И Порт <> 80) Тогда
			ПортСтрока = ":" + Формат(Порт, "ЧГ=0");
		КонецЕсли;
	КонецЕсли;
	
	Если Лев(Location, 1) = "/" Тогда
		Возврат Схема + "://" + Хост + ПортСтрока + Location;
	КонецЕсли;
	
	Путь = URI.ПутьНаСервере;
	Если ПустаяСтрока(Путь) Тогда
		Путь = "/";
	КонецЕсли;
	Позиция = СтрНайти(Путь, "/", НаправлениеПоиска.СКонца);
	Если Позиция > 0 Тогда
		Путь = Лев(Путь, Позиция);
	Иначе
		Путь = "/";
	КонецЕсли;
	
	Возврат Схема + "://" + Хост + ПортСтрока + Путь + Location;
	
КонецФункции

&НаСервере
Функция СравнитьВерсииПриложения(Версия1, Версия2)
	
	Части1 = СтрРазделить(СокрЛП(Строка(Версия1)), ".", Ложь);
	Части2 = СтрРазделить(СокрЛП(Строка(Версия2)), ".", Ложь);
	Макс = Макс(Части1.Количество(), Части2.Количество());
	
	// СтрРазделить → массив с индексами 0..N-1 (не 1..N).
	Для Индекс = 0 По Макс - 1 Цикл
		Н1 = 0;
		Н2 = 0;
		Если Индекс < Части1.Количество() Тогда
			Н1 = ЧислоСегментаВерсии(Части1[Индекс]);
		КонецЕсли;
		Если Индекс < Части2.Количество() Тогда
			Н2 = ЧислоСегментаВерсии(Части2[Индекс]);
		КонецЕсли;
		Если Н1 > Н2 Тогда
			Возврат 1;
		ИначеЕсли Н1 < Н2 Тогда
			Возврат -1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

&НаСервере
Функция ЧислоСегментаВерсии(Значение)
	
	Значение = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Значение) Тогда
		Возврат 0;
	КонецЕсли;
	
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
	
КонецФункции

