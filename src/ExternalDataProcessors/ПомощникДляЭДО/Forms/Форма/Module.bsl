&НаСервере
Функция МаксимальнаяВерсияИзСпискаНаСервере(СписокРелизов)
	
	Максимум = "";
	Если ТипЗнч(СписокРелизов) <> Тип("Массив") Тогда
		Возврат Максимум;
	КонецЕсли;
	
	Для Каждого Элемент Из СписокРелизов Цикл
		Версия = "";
		Если ТипЗнч(Элемент) = Тип("Структура") И Элемент.Свойство("version") Тогда
			Версия = СокрЛП(Элемент.version);
		КонецЕсли;
		Если ПустаяСтрока(Версия) Тогда
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(Максимум) Или СравнитьВерсииПриложения(Версия, Максимум) > 0 Тогда
			Максимум = Версия;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Максимум;
	
КонецФункции

&НаСервере
Функция ДатаСозданияДляJSONИзВыборки(Выборка)
	
	ДатаСоздания = Неопределено;
	Попытка
		ДатаСоздания = Выборка.ДатаСозданияДокумента;
	Исключение
		ДатаСоздания = Неопределено;
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ДатаСоздания) Тогда
		Возврат XMLСтрока(ДатаСоздания);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.ДатаЭПД) Тогда
		Возврат XMLСтрока(Выборка.ДатаЭПД);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция СтрокаДатыДляJSON(ЗначениеДаты)
	
	Если Не ЗначениеЗаполнено(ЗначениеДаты) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат XMLСтрока(ЗначениеДаты);
	
КонецФункции

