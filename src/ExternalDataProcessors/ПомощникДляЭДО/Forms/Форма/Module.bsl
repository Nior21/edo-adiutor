&НаСервере
Функция ПолучитьСтраницуСпискаЭПДJSONНаСервере(OffsetStr, LimitStr)
	
	Offset = ЧислоПараметраМоста(OffsetStr, 0);
	Limit = ЧислоПараметраМоста(LimitStr, 20);
	Если Limit <= 0 Тогда
		Limit = 20;
	КонецЕсли;
	Если Limit > 50 Тогда
		Limit = 50;
	КонецЕсли;
	
	Страница = ПолучитьСтраницуЭПД(Offset, Limit);
	Данные = Новый Структура;
	Данные.Вставить("offset", Offset);
	Данные.Вставить("limit", Limit);
	Данные.Вставить("total", Страница.Total);
	Данные.Вставить("items", Страница.Items);
	Возврат ЗаписатьJSONСтрокой(Данные);
	
КонецФункции

&НаСервере
Функция ОбогатитьСтрокиЭПДJSONНаСервере(RefsCSV)
	
	МассивRef = РазобратьСписокRefCSV(RefsCSV);
	Обновления = ОбогатитьСтрокиЭПД(МассивRef);
	Данные = Новый Структура;
	Данные.Вставить("updates", Обновления);
	Возврат ЗаписатьJSONСтрокой(Данные);
	
КонецФункции

&НаСервере
Функция ЧислоПараметраМоста(Значение, ЗначениеПоУмолчанию)
	
	Если ПустаяСтрока(Значение) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция РазобратьСписокRefCSV(RefsCSV)
	
	Результат = Новый Массив;
	Если ПустаяСтрока(RefsCSV) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Часть Из СтрРазделить(RefsCSV, ",", Ложь) Цикл
		Ref = СокрЛП(Часть);
		Если Не ПустаяСтрока(НормализоватьUUIDСтроку(Ref)) Тогда
			Результат.Добавить(Ref);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьКоличествоЭПД()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Реестр.Ссылка) КАК Количество
	|ИЗ
	|	РегистрСведений.РеестрЭПД КАК Реестр";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

&НаСервере
Функция ПолучитьСтраницуЭПД(Offset, Limit)
	
	Результат = Новый Структура("Total, Items", ПолучитьКоличествоЭПД(), Новый Массив);
	
	Если Limit <= 0 Или Offset < 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если КэшСсылокЭПДUUID = Неопределено Тогда
		КэшСсылокЭПДUUID = Новый Соответствие;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаСтраницыРеестраЭПД(Limit, Offset);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьСсылкуВКэшЭПД(Выборка.Ссылка);
		Результат.Items.Добавить(СтруктураДокументаИзРеестраЛегкая(Выборка));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ТекстЗапросаСтраницыРеестраЭПД(Limit, Offset)
	
	Limit = Макс(1, Мин(Limit, 50));
	Offset = Макс(0, Offset);
	
	ТекстПолей =
	"	Реестр.Ссылка КАК Ссылка,
	|	Реестр.Организация КАК ОрганизацияСсылка,
	|	ПРЕДСТАВЛЕНИЕ(Реестр.Организация) КАК Организация,
	|	Реестр.НомерЭПД КАК НомерЭПД,
	|	Реестр.ДатаЭПД КАК ДатаЭПД,
	|	Реестр.Ссылка.Дата КАК ДатаСозданияДокумента,
	|	Реестр.НомерДокументаИБ КАК НомерДокументаИБ,
	|	Реестр.Грузоотправитель КАК Грузоотправитель,
	|	Реестр.Грузополучатель КАК Грузополучатель,
	|	Реестр.Перевозчик КАК Перевозчик,
	|	Реестр.ТекущийШаг КАК ТекущийШаг,
	|	Реестр.ТекущийШагВыполнен КАК ТекущийШагВыполнен,
	|	Реестр.Проведен КАК Проведен,
	|	Реестр.ПометкаУдаления КАК ПометкаУдаления,
	|	Реестр.Комментарий КАК Комментарий";
	
	ТекстСортировки =
	"УПОРЯДОЧИТЬ ПО
	|	Реестр.ДатаЭПД УБЫВ,
	|	Реестр.НомерЭПД УБЫВ";
	
	Если Offset > 0 Тогда
		Возврат СтрШаблон(
			"ВЫБРАТЬ ПЕРВЫЕ %1
			|%2
			|ИЗ
			|	РегистрСведений.РеестрЭПД КАК Реестр
			|ГДЕ
			|	Реестр.Ссылка НЕ В (
			|		ВЫБРАТЬ ПЕРВЫЕ %3
			|			Р2.Ссылка
			|		ИЗ
			|			РегистрСведений.РеестрЭПД КАК Р2
			|		УПОРЯДОЧИТЬ ПО
			|			Р2.ДатаЭПД УБЫВ,
			|			Р2.НомерЭПД УБЫВ)
			|%4",
			Limit,
			ТекстПолей,
			Offset,
			ТекстСортировки);
	КонецЕсли;
	
	Возврат СтрШаблон(
		"ВЫБРАТЬ ПЕРВЫЕ %1
		|%2
		|ИЗ
		|	РегистрСведений.РеестрЭПД КАК Реестр
		|%3",
		Limit,
		ТекстПолей,
		ТекстСортировки);
	
КонецФункции

&НаСервере
Функция ОбогатитьСтрокиЭПД(МассивRef)
	
	Обновления = Новый Массив;
	
	Для Каждого Ref Из МассивRef Цикл
		СтрокаОбогащения = ОбогатитьСтрокуЭПДПоRef(Ref);
		Если СтрокаОбогащения <> Неопределено Тогда
			Обновления.Добавить(СтрокаОбогащения);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Обновления;
	
КонецФункции

&НаСервере
Функция ОбогатитьСтрокуЭПДПоRef(Ref)
	
	Ссылка = СсылкаИзКэшаЭПД(НормализоватьUUIDСтроку(Ref));
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Ссылка = СсылкаДокументаЭПДПоUUID(Ref, "");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаСтрокиРеестраЭПДПоСсылке();
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПолнаяСтрока = СтруктураДокументаИзРеестра(Выборка, Ложь);
	Обновление = Новый Структура;
	Обновление.Вставить("ref", ПолнаяСтрока.ref);
	Обновление.Вставить("shipper", ПолнаяСтрока.shipper);
	Обновление.Вставить("carrier", ПолнаяСтрока.carrier);
	Обновление.Вставить("consignee", ПолнаяСтрока.consignee);
	
	Возврат Обновление;
	
КонецФункции

&НаСервере
Функция ПолучитьДокументЭПДJSONНаСервере(Ref, DocType = "")
	
	Попытка
		Документ = ПолучитьДокументЭПД(Ref, DocType);
		Если Документ = Неопределено Тогда
			Возврат "{""error"":""Документ не найден в реестре ЭПД""}";
		КонецЕсли;
		
		Возврат ЗаписатьJSONСтрокой(Документ);
	Исключение
		Возврат "{""error"":""" + ЭкранироватьСтрокуJSON(ОписаниеОшибки()) + """}";
	КонецПопытки;
	
КонецФункции

&НаСервере
Функция ПолучитьСсылкуДокументаЭПДНаСервере(Ref, DocType = "")
	
	Возврат СсылкаДокументаЭПДПоUUID(Ref, DocType);
	
КонецФункции

&НаСервере
Функция ПолучитьСписокЭПД()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	Реестр.Ссылка КАК Ссылка,
	|	Реестр.Организация КАК ОрганизацияСсылка,
	|	ПРЕДСТАВЛЕНИЕ(Реестр.Организация) КАК Организация,
	|	Реестр.НомерЭПД КАК НомерЭПД,
	|	Реестр.ДатаЭПД КАК ДатаЭПД,
	|	Реестр.Ссылка.Дата КАК ДатаСозданияДокумента,
	|	Реестр.НомерДокументаИБ КАК НомерДокументаИБ,
	|	Реестр.Грузоотправитель КАК Грузоотправитель,
	|	Реестр.Грузополучатель КАК Грузополучатель,
	|	Реестр.Перевозчик КАК Перевозчик,
	|	Реестр.ТекущийШаг КАК ТекущийШаг,
	|	Реестр.ТекущийШагВыполнен КАК ТекущийШагВыполнен,
	|	Реестр.Проведен КАК Проведен,
	|	Реестр.ПометкаУдаления КАК ПометкаУдаления,
	|	Реестр.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.РеестрЭПД КАК Реестр
	|
	|УПОРЯДОЧИТЬ ПО
	|	Реестр.ДатаЭПД УБЫВ,
	|	Реестр.НомерЭПД УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;
	КэшСсылокЭПДUUID = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		ДобавитьСсылкуВКэшЭПД(Выборка.Ссылка);
		Результат.Добавить(СтруктураДокументаИзРеестраЛегкая(Выборка));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьСсылкуВКэшЭПД(СсылкаДокумента)
	
	Если Не ЗначениеЗаполнено(СсылкаДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	Если КэшСсылокЭПДUUID = Неопределено Тогда
		КэшСсылокЭПДUUID = Новый Соответствие;
	КонецЕсли;
	
	UUIDСтрока = НормализоватьUUIDСтроку(Строка(СсылкаДокумента.УникальныйИдентификатор()));
	КэшСсылокЭПДUUID.Вставить(UUIDСтрока, СсылкаДокумента);
	
КонецПроцедуры

&НаСервере
Функция СсылкаИзКэшаЭПД(UUIDСтрока)
	
	Если КэшСсылокЭПДUUID = Неопределено Или ПустаяСтрока(UUIDСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Ссылка = КэшСсылокЭПДUUID.Получить(UUIDСтрока);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПолучитьДокументЭПД(Ref, DocType = "")
	
	Ссылка = СсылкаДокументаЭПДПоUUID(Ref, DocType);
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Реестр.Ссылка КАК Ссылка,
	|	Реестр.Организация КАК ОрганизацияСсылка,
	|	ПРЕДСТАВЛЕНИЕ(Реестр.Организация) КАК Организация,
	|	Реестр.НомерЭПД КАК НомерЭПД,
	|	Реестр.ДатаЭПД КАК ДатаЭПД,
	|	Реестр.Ссылка.Дата КАК ДатаСозданияДокумента,
	|	Реестр.НомерДокументаИБ КАК НомерДокументаИБ,
	|	Реестр.Грузоотправитель КАК Грузоотправитель,
	|	Реестр.Грузополучатель КАК Грузополучатель,
	|	Реестр.Перевозчик КАК Перевозчик,
	|	Реестр.ТекущийШаг КАК ТекущийШаг,
	|	Реестр.ТекущийШагВыполнен КАК ТекущийШагВыполнен,
	|	Реестр.Проведен КАК Проведен,
	|	Реестр.ПометкаУдаления КАК ПометкаУдаления,
	|	Реестр.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.РеестрЭПД КАК Реестр
	|ГДЕ
	|	Реестр.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СтруктураДокументаИзРеестра(Выборка, Истина);
	
КонецФункции

&НаСервере
Функция НормализоватьUUIDСтрокуНаСервере(Ref)
	
	Возврат НормализоватьUUIDСтроку(Ref);
	
КонецФункции

&НаСервере
Функция СохранитьКомментарийЭПДНаСервере(Ref, Comment, DocType = "")
	
	Результат = Новый Структура("Успех, Сообщение", Ложь, "");
	
	Если ПустаяСтрока(НормализоватьUUIDСтроку(Ref)) Тогда
		Результат.Сообщение = "Не передан идентификатор документа (ref).";
		Возврат Результат;
	КонецЕсли;
	
	Ссылка = СсылкаДокументаЭПДПоUUID(Ref, DocType);
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Результат.Сообщение = "Документ ЭПД не найден.";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		ОбъектДокумента = Ссылка.ПолучитьОбъект();
		ОбъектДокумента.Комментарий = Comment;
		ОбъектДокумента.Записать();
		ЗаписатьКомментарийВРеестрЭПД(Ссылка, Comment);
		Результат.Успех = Истина;
	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаписатьКомментарийВРеестрЭПД(СсылкаДокумента, Comment)
	
	МенеджерЗаписи = РегистрыСведений.РеестрЭПД.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Ссылка = СсылкаДокумента;
	МенеджерЗаписи.Прочитать();
	
	Если Не МенеджерЗаписи.Выбран() Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи.Комментарий = Comment;
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

