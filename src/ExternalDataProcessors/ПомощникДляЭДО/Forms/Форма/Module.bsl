	ДобавитьПолеКарточки(Поля, ЗаголовокГруппы, "Статус обмена ЭДО", Ячейка.edoExchangeStatus);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПоляМассиваВКарточку(Поля, Группа, Метка, МассивЗначений)
	
	Если МассивЗначений = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Номер = 0;
	Для Каждого Значение Из МассивЗначений Цикл
		Номер = Номер + 1;
		Подпись = ?(МассивЗначений.Количество() > 1, Метка + " " + Формат(Номер, "ЧГ=0"), Метка);
		ДобавитьПолеКарточки(Поля, Группа, Подпись, Значение);
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Процедура ДобавитьПоляСодержимогоЭТрНВКарточку(Поля, СсылкаДокумента)

	Если СсылкаДокумента.Метаданные().Имя <> "ЭлектроннаяТранспортнаяНакладная" Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ДокументОбъект = СсылкаДокумента.ПолучитьОбъект();
	Исключение
		Возврат;
	КонецПопытки;

	МетаДокумента = ДокументОбъект.Метаданные();
	Для Каждого РеквизитМета Из МетаДокумента.Реквизиты Цикл
		Имя = РеквизитМета.Имя;
		Если Не СтрНачинаетсяС(Имя, "Титул") Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(ВРег(Имя), "ИДЕНТИФИКАТОРФАЙЛА") > 0
			Или СтрНайти(ВРег(Имя), "ДАТАФОРМИРОВАНИЯ") > 0
			Или СтрНайти(ВРег(Имя), "ВРЕМЯФОРМИРОВАНИЯ") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Значение = ДокументОбъект[Имя];
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Группа = "Реквизиты титулов";
		Метка = ?(ЗначениеЗаполнено(РеквизитМета.Синоним), РеквизитМета.Синоним, Имя);
		ДобавитьПолеКарточки(Поля, Группа, Метка, ПредставлениеЗначенияДляКарточки(Значение));
	КонецЦикла;

	Для Каждого ТЧМета Из МетаДокумента.ТабличныеЧасти Цикл
		Если Не СтрНачинаетсяС(ТЧМета.Имя, "Титул") Тогда
			Продолжить;
		КонецЕсли;
		Таблица = ДокументОбъект[ТЧМета.Имя];
		Если Таблица.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СинонимТЧ = ?(ЗначениеЗаполнено(ТЧМета.Синоним), ТЧМета.Синоним, ТЧМета.Имя);
		НомерСтроки = 0;
		Для Каждого СтрокаТЧ Из Таблица Цикл
			НомерСтроки = НомерСтроки + 1;
			Группа = "Содержимое: " + СинонимТЧ;
			Если Таблица.Количество() > 1 Тогда
				Группа = Группа + " · строка " + Формат(НомерСтроки, "ЧГ=0");
			КонецЕсли;
			Для Каждого РеквизитТЧ Из ТЧМета.Реквизиты Цикл
				Значение = СтрокаТЧ[РеквизитТЧ.Имя];
				Если Не ЗначениеЗаполнено(Значение) Тогда
					Продолжить;
				КонецЕсли;
				Метка = ?(ЗначениеЗаполнено(РеквизитТЧ.Синоним), РеквизитТЧ.Синоним, РеквизитТЧ.Имя);
				ДобавитьПолеКарточки(Поля, Группа, Метка, ПредставлениеЗначенияДляКарточки(Значение));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПредставлениеЗначенияДляКарточки(Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Тип = ТипЗнч(Значение);
	Если Тип = Тип("Булево") Тогда
		Возврат ?(Значение, "Да", "Нет");
	ИначеЕсли Тип = Тип("Дата") Тогда
		Возврат Формат(Значение, "ДЛФ=DT");
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));

КонецФункции
&НаСервере
Процедура ДобавитьПолеКарточки(Поля, Группа, Метка, Значение)
	
	Значение = СокрЛП(Строка(Значение));
	Если ПустаяСтрока(Значение) Тогда
		Возврат;
	КонецЕсли;
	
	Поле = Новый Структура("group, label, value", Группа, Метка, Значение);
	Поля.Добавить(Поле);
	
КонецПроцедуры


&НаСервере
Функция ЗначениеПоляСтруктурыДокумента(СтруктураДокумента, ИмяПоля)

	Если ТипЗнч(СтруктураДокумента) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Если Не СтруктураДокумента.Свойство(ИмяПоля) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Строка(СтруктураДокумента[ИмяПоля]));

КонецФункции

&НаСервере
Функция ДиагностикаДокументаЭПД(СтруктураДокумента)
	
	Замечания = Новый Массив;
	
	Если СтруктураДокумента.deletionMark Тогда
		Замечания.Добавить("Документ помечен на удаление.");
	КонецЕсли;
	
	ДобавитьЗамечаниеПустогоИдЭДО(Замечания, "грузоотправителя", СтруктураДокумента.shipper);
	ДобавитьЗамечаниеПустогоИдЭДО(Замечания, "грузополучателя", СтруктураДокумента.consignee);
	ДобавитьЗамечаниеПустогоИдЭДО(Замечания, "перевозчика", СтруктураДокумента.carrier);
	
	Если СтруктураДокумента.Свойство("waybillNumber")
		И ЗначениеЗаполнено(СтруктураДокумента.waybillNumber)
		И СтруктураДокумента.waybillNumber <> СтруктураДокумента.number Тогда
		Замечания.Добавить("Номер ЭПД (" + СтруктураДокумента.number + ") не совпадает с номером ТН (" + СтруктураДокумента.waybillNumber + ").");
	КонецЕсли;
	
	Если СтруктураДокумента.Свойство("isIncoming")
		И СтруктураДокумента.isIncoming = Истина
		И СтруктураДокумента.Свойство("roleParticipant")
		И СтрНайти(Строка(СтруктураДокумента.roleParticipant), "2") > 0 Тогда
		Замечания.Добавить("Входящий документ: роль участника — грузополучатель.");
	КонецЕсли;
	
	ИменаСторон = Новый Массив;
	ИменаСторон.Добавить("shipper");
	ИменаСторон.Добавить("consignee");
	ИменаСторон.Добавить("carrier");
	Для Каждого Ключ Из ИменаСторон Цикл
		Ячейка = СтруктураДокумента[Ключ];
		Если ЗначениеЗаполнено(Ячейка.edoId)
			И Ячейка.edoExchangeStatus = "not_accepted"
			И Не Ячейка.isOwnOrganization Тогда
			Замечания.Добавить("Обмен ЭДО не принят для ID: " + Ячейка.edoId);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Замечания;
	
КонецФункции

&НаСервере
Процедура ДобавитьЗамечаниеПустогоИдЭДО(Замечания, ИмяСтороны, Ячейка)
	
	Если ЗначениеЗаполнено(Ячейка.name) И ПустаяСтрока(Ячейка.edoId) Тогда
		Замечания.Добавить("Не заполнен ID ЭДО " + ИмяСтороны + ".");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция МассивДатТитуловЭТН(Реквизиты)
	
	Результат = Новый Массив;
	ДобавитьДатуТитула(Результат, "Грузоотправитель", Реквизиты.ТитулГрузоотправителяДатаФормированияФайла);
	ДобавитьДатуТитула(Результат, "Перевозчик (приёмка)", Реквизиты.ТитулПеревозчикаПриемкаДатаФормированияФайла);
	ДобавитьДатуТитула(Результат, "Грузополучатель", Реквизиты.ТитулГрузополучателяДатаФормированияФайла);
	ДобавитьДатуТитула(Результат, "Перевозчик (выдача)", Реквизиты.ТитулПеревозчикаВыдачаДатаФормированияФайла);
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьДатуТитула(МассивДат, Ключ, ЗначениеДаты)
	
	Элемент = Новый Структура;
	Элемент.Вставить("key", Ключ);
	Элемент.Вставить("value", XMLСтрокаЕслиЗаполнено(ЗначениеДаты));
