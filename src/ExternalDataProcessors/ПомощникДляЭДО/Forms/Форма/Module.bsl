&НаКлиенте
Процедура ВыбратьПутьКФайлуEPFНаКлиенте()
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Файл внешней обработки для автоматического обновления";
	Диалог.Фильтр = "Внешние обработки (*.epf)|*.epf";
	Диалог.МножественныйВыбор = Ложь;
	
	СохраненныйПуть = ПутьКФайлуEPFНаСервере();
	Если ЗначениеЗаполнено(СохраненныйПуть) Тогда
		Диалог.ПолноеИмяФайла = СохраненныйПуть;
	КонецЕсли;
	
	Если Диалог.Выбрать() Тогда
		СохранитьПутьКФайлуEPFНаСервере(Диалог.ПолноеИмяФайла);
		ОтправитьСведенияОбОбновленииВИнтерфейс();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбновлениеФайлаEPF(TargetPath)
	
	TargetPath = СокрЛП(TargetPath);
	Если ПустаяСтрока(TargetPath) Тогда
		TargetPath = ПутьКФайлуEPFНаСервере();
	КонецЕсли;
	
	Если ПустаяСтрока(TargetPath) Тогда
		СообщитьBridgeОшибку("Укажите файл .epf, который нужно обновлять (кнопка «Выбрать файл…»).");
		Возврат;
	КонецЕсли;
	
	Если Не СтрЗаканчиваетсяНа(НРег(TargetPath), ".epf") Тогда
		СообщитьBridgeОшибку("Путь должен указывать на файл .epf");
		Возврат;
	КонецЕсли;
	
	Подготовка = ПодготовитьЗагрузкуОбновленияНаСервере();
	Если Не Подготовка.Успех Тогда
		ОтправитьРезультатОбновленияВИнтерфейс(Ложь, Подготовка.Сообщение, TargetPath, "");
		Возврат;
	КонецЕсли;
	
	Попытка
		ПрименитьДвоичныеОбновленияКФайлу(TargetPath, Подготовка.АдресДанных);
		СохранитьПутьКФайлуEPFНаСервере(TargetPath);
		Текст = "Файл обновлён до v" + Подготовка.Версия + ". Закройте обработку и откройте снова: " + TargetPath;
		ОтправитьРезультатОбновленияВИнтерфейс(Истина, Текст, TargetPath, Подготовка.Версия);
		СообщитьBridgeСтатус("Обновление установлено. Перезапустите обработку из файла.");
	Исключение
		ОтправитьРезультатОбновленияВИнтерфейс(Ложь, ОписаниеОшибки(), TargetPath, "");
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьДвоичныеОбновленияКФайлу(ПутьНазначения, АдресДанных)
	
	Двоичные = ПолучитьИзВременногоХранилища(АдресДанных);
	Если Двоичные = Неопределено Или Двоичные.Размер() = 0 Тогда
		ВызватьИсключение "Пустой файл обновления";
	КонецЕсли;
	
	Файл = Новый Файл(ПутьНазначения);
	Если Файл.Существует() Тогда
		РезервнаяКопия = ПутьНазначения + ".bak";
		КопироватьФайл(ПутьНазначения, РезервнаяКопия);
	КонецЕсли;
	
	Двоичные.Записать(ПутьНазначения);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьРезультатОбновленияВИнтерфейс(Успех, Сообщение, TargetPath, LatestVersion)
	
	Ответ = Новый Структура;
	Ответ.Вставить("phase", "apply");
	Ответ.Вставить("success", Успех);
	Ответ.Вставить("message", Сообщение);
	Ответ.Вставить("targetPath", TargetPath);
	Ответ.Вставить("latestVersion", LatestVersion);
	
	JSON = ЗаписатьJSONСтрокойНаСервере(Ответ);
	Попытка
		View().edoSetUpdateInfo(JSON);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ЗаписатьJSONСтрокойНаСервере(Значение)
	
	Возврат ЗаписатьJSONСтрокой(Значение);
	
КонецФункции

&НаСервере
Функция СведенияОбОбновленииJSONНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ТекущаяВерсия = ОбработкаОбъект.ВерсияПриложения();
	URLМанифеста = СокрЛП(ОбработкаОбъект.URLМанифестаОбновлений());
	ПутьEPF = ПутьКФайлуEPFНаСервере();
	
	Ответ = Новый Структура;
	Ответ.Вставить("phase", "check");
	Ответ.Вставить("currentVersion", ТекущаяВерсия);
	Ответ.Вставить("latestVersion", ТекущаяВерсия);
	Ответ.Вставить("updateAvailable", Ложь);
	Ответ.Вставить("manifestConfigured", ЗначениеЗаполнено(URLМанифеста));
	Ответ.Вставить("epfPath", ПутьEPF);
	Ответ.Вставить("epfUrl", "");
	Ответ.Вставить("notes", "");
	Ответ.Вставить("error", "");
	
	Если ПустаяСтрока(URLМанифеста) Тогда
		Возврат ЗаписатьJSONСтрокой(Ответ);
	КонецЕсли;
	
	Манифест = ПрочитатьМанифестОбновления(URLМанифеста);
	Если Не ПустаяСтрока(Манифест.Ошибка) Тогда
		Ответ.Вставить("error", Манифест.Ошибка);
		Возврат ЗаписатьJSONСтрокой(Ответ);
	КонецЕсли;
	
	Ответ.Вставить("latestVersion", Манифест.Версия);
	Ответ.Вставить("epfUrl", Манифест.EpfUrl);
	Ответ.Вставить("notes", Манифест.Примечания);
	Ответ.Вставить("updateAvailable", (СравнитьВерсииПриложения(ТекущаяВерсия, Манифест.Версия) < 0));
	
	Возврат ЗаписатьJSONСтрокой(Ответ);
	
КонецФункции

&НаСервере
Функция ПодготовитьЗагрузкуОбновленияНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("АдресДанных", "");
	Результат.Вставить("Версия", "");
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	URLМанифеста = СокрЛП(ОбработкаОбъект.URLМанифестаОбновлений());
	Если ПустаяСтрока(URLМанифеста) Тогда
		Результат.Сообщение = "URL манифеста обновлений не настроен (ObjectModule.URLМанифестаОбновлений).";
		Возврат Результат;
	КонецЕсли;
	
	Манифест = ПрочитатьМанифестОбновления(URLМанифеста);
	Если Не ПустаяСтрока(Манифест.Ошибка) Тогда
		Результат.Сообщение = Манифест.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	Если ПустаяСтрока(Манифест.EpfUrl) Тогда
		Результат.Сообщение = "В манифесте не указан epfUrl.";
		Возврат Результат;
	КонецЕсли;
	
	Загрузка = HTTPПолучитьДвоичныеДанные(Манифест.EpfUrl);
	Если Не ПустаяСтрока(Загрузка.Ошибка) Тогда
		Результат.Сообщение = Загрузка.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	Если Загрузка.Данные.Размер() < 1024 Тогда
		Результат.Сообщение = "Слишком маленький файл обновления — проверьте epfUrl в манифесте.";
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.АдресДанных = ПоместитьВоВременноеХранилище(Загрузка.Данные, УникальныйИдентификатор);
	Результат.Версия = Манифест.Версия;
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПрочитатьМанифестОбновления(URLМанифеста)
	
	Результат = Новый Структура;
	Результат.Вставить("Версия", "");
	Результат.Вставить("EpfUrl", "");
	Результат.Вставить("Примечания", "");
	Результат.Вставить("Ошибка", "");
	
	Загрузка = HTTPПолучитьСтроку(URLМанифеста);
	Если Не ПустаяСтрока(Загрузка.Ошибка) Тогда
		Результат.Ошибка = Загрузка.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Данные = ОбщегоНазначения.JSONВЗначение(Загрузка.Текст, , Ложь);
	Исключение
		Результат.Ошибка = "Манифест не JSON: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Структура") И ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Результат.Ошибка = "Манифест обновлений имеет неверный формат.";
		Возврат Результат;
	КонецЕсли;
	
	Результат.Версия = СокрЛП(JSONСтрокаПоля(Данные, "version"));
	Результат.EpfUrl = СокрЛП(JSONСтрокаПоля(Данные, "epfUrl"));
	Результат.Примечания = СокрЛП(JSONСтрокаПоля(Данные, "notes"));
	
	Если ПустаяСтрока(Результат.Версия) Тогда
		Результат.Ошибка = "В манифесте не указано поле version.";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция JSONСтрокаПоля(ДанныеJSON, ИмяПоля)
	
	Если ДанныеJSON = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(ДанныеJSON) = Тип("Структура") Тогда
		Если ДанныеJSON.Свойство(ИмяПоля) Тогда
			Возврат Строка(ДанныеJSON[ИмяПоля]);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеJSON) = Тип("Соответствие") Тогда
		Значение = ДанныеJSON.Получить(ИмяПоля);
		Если Значение <> Неопределено Тогда
			Возврат Строка(Значение);
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервере
Функция HTTPПолучитьСтроку(URL)
	
	Результат = Новый Структура("Текст, Ошибка", "", "");
	Двоичные = HTTPПолучитьДвоичныеДанные(URL);
	Если Не ПустаяСтрока(Двоичные.Ошибка) Тогда
		Результат.Ошибка = Двоичные.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Текст = ПолучитьСтрокуИзДвоичныхДанных(Двоичные.Данные, КодировкаТекста.UTF8);
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция HTTPПолучитьДвоичныеДанные(URL)
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Неопределено);
	Результат.Вставить("Ошибка", "");
	
	URL = СокрЛП(URL);
	Если ПустаяСтрока(URL) Тогда
		Результат.Ошибка = "Пустой URL";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		URI = ОбщегоНазначенияКлиентСервер.СтруктураURI(URL);
	Исключение
		Результат.Ошибка = "Некорректный URL: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	Схема = НРег(СокрЛП(URI.Схема));
	Защищенное = (Схема = "https");
	Порт = 0;
	Если ЗначениеЗаполнено(URI.Порт) Тогда
		Порт = Число(URI.Порт);
	Иначе
		Порт = ?(Защищенное, 443, 80);
	КонецЕсли;
	
	Путь = URI.ПутьНаСервере;
	Если ПустаяСтрока(Путь) Тогда
		Путь = "/";
	ИначеЕсли Лев(Путь, 1) <> "/" Тогда
		Путь = "/" + Путь;
	КонецЕсли;
	
	Попытка
		Соединение = Новый HTTPСоединение(URI.Хост, Порт, , , , 60, ?(Защищенное, Новый ЗащищенноеСоединениеOpenSSL, Неопределено));
		Запрос = Новый HTTPЗапрос(Путь);
		Ответ = Соединение.Получить(Запрос);
		Если Ответ.КодСостояния <> 200 Тогда
			Результат.Ошибка = "HTTP " + Формат(Ответ.КодСостояния, "ЧГ=0") + " при загрузке " + URL;
			Возврат Результат;
		КонецЕсли;
		Результат.Данные = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Исключение
		Результат.Ошибка = "Загрузка по HTTP: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СравнитьВерсииПриложения(Версия1, Версия2)
	
	Части1 = СтрРазделить(СокрЛП(Версия1), ".", Ложь);
	Части2 = СтрРазделить(СокрЛП(Версия2), ".", Ложь);
	Макс = Макс(Части1.Количество(), Части2.Количество());
	
	Для Индекс = 1 По Макс Цикл
		Н1 = 0;
		Н2 = 0;
		Если Индекс <= Части1.Количество() Тогда
			Н1 = ЧислоПараметраМоста(Части1[Индекс], 0);
		КонецЕсли;
		Если Индекс <= Части2.Количество() Тогда
			Н2 = ЧислоПараметраМоста(Части2[Индекс], 0);
		КонецЕсли;
		Если Н1 > Н2 Тогда
			Возврат 1;
		ИначеЕсли Н1 < Н2 Тогда
			Возврат -1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

&НаСервере
Функция ПутьКФайлуEPFНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Ключ = ОбработкаОбъект.КлючХранилищаНастроекОбновления();
	Значение = ХранилищеОбщихНастроек.Загрузить(Ключ, "ПутьКФайлуEPF");
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
	
КонецФункции

&НаСервере
Процедура СохранитьПутьКФайлуEPFНаСервере(Путь)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Ключ = ОбработкаОбъект.КлючХранилищаНастроекОбновления();
	ХранилищеОбщихНастроек.Сохранить(Ключ, "ПутьКФайлуEPF", СокрЛП(Путь));
	
КонецПроцедуры

&НаСервере
Функция СтрокаДатыДляJSON(ЗначениеДаты)
	
	Если Не ЗначениеЗаполнено(ЗначениеДаты) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат XMLСтрока(ЗначениеДаты);
	
КонецФункции

&НаСервере
Функция ЗаписатьJSONСтрокой(Значение)
	
	Настройки = Новый НастройкиСериализацииJSON;
	Настройки.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	Настройки.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.УниверсальнаяДата;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Значение, Настройки);
	Возврат ЗаписьJSON.Закрыть();
	
КонецФункции

#КонецОбласти
