&НаСервере
Функция URLAssetEpfИзGitHubJSONНаСервере(ДанныеJSON, ИмяПредпочтительное)
	
	Assets = ЗначениеJSONПоляНаСервере(ДанныеJSON, "assets");
	Если Assets = Неопределено Или ТипЗнч(Assets) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;
	
	URLПервыйEpf = "";
	Для Инд = 0 По Assets.ВГраница() Цикл
		Asset = Assets[Инд];
		Имя = JSONСтрокаПоляНаСервере(Asset, "name");
		URL = JSONСтрокаПоляНаСервере(Asset, "browser_download_url");
		Если ПустаяСтрока(URL) Тогда
			Продолжить;
		КонецЕсли;
		Если Имя = ИмяПредпочтительное Тогда
			Возврат URL;
		КонецЕсли;
		Если ПустаяСтрока(URLПервыйEpf) И (СтрЗаканчиваетсяНа(НРег(Имя), ".epf")) Тогда
			URLПервыйEpf = URL;
		КонецЕсли;
	КонецЦикла;
	
	Возврат URLПервыйEpf;
	
КонецФункции

&НаСервере
Функция ЗначениеJSONПоляНаСервере(ДанныеJSON, ИмяПоля)
	
	Если ДанныеJSON = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеJSON) = Тип("Структура") Тогда
		Значение = Неопределено;
		Если ДанныеJSON.Свойство(ИмяПоля, Значение) Тогда
			Возврат Значение;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеJSON) = Тип("Соответствие") Тогда
		Возврат ДанныеJSON.Получить(ИмяПоля);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция HTTPПолучитьСтроку(URL, Заголовки = Неопределено)
	
	Результат = Новый Структура("Текст, Ошибка", "", "");
	Двоичные = HTTPПолучитьДвоичныеДанные(URL, Заголовки);
	Если Не ПустаяСтрока(Двоичные.Ошибка) Тогда
		Результат.Ошибка = Двоичные.Ошибка;
		Возврат Результат;
	КонецЕсли;
	
	Результат.Текст = ПолучитьСтрокуИзДвоичныхДанных(Двоичные.Данные, КодировкаТекста.UTF8);
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция HTTPПолучитьДвоичныеДанные(URL, Заголовки = Неопределено, ГлубинаРедиректа = 0)
	
	Результат = Новый Структура;
	Результат.Вставить("Данные", Неопределено);
	Результат.Вставить("Ошибка", "");
	
	URL = СокрЛП(URL);
	Если ПустаяСтрока(URL) Тогда
		Результат.Ошибка = "Пустой URL";
		Возврат Результат;
	КонецЕсли;
	
	Если ГлубинаРедиректа > 8 Тогда
		Результат.Ошибка = "Слишком много HTTP-редиректов при загрузке " + URL;
		Возврат Результат;
	КонецЕсли;
	
	Если Заголовки = Неопределено И СтрНайти(НРег(URL), "github.com") > 0 Тогда
		Заголовки = ЗаголовкиHTTPGitHubНаСервере();
	КонецЕсли;
	
	Попытка
		URI = ОбщегоНазначенияКлиентСервер.СтруктураURI(URL);
	Исключение
		Результат.Ошибка = "Некорректный URL: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;
	
	Схема = НРег(СокрЛП(URI.Схема));
	Защищенное = (Схема = "https");
	Порт = 0;
	Если ЗначениеЗаполнено(URI.Порт) Тогда
		Порт = Число(URI.Порт);
	Иначе
		Порт = ?(Защищенное, 443, 80);
	КонецЕсли;
	
	Путь = URI.ПутьНаСервере;
	Если ПустаяСтрока(Путь) Тогда
		Путь = "/";
	ИначеЕсли Лев(Путь, 1) <> "/" Тогда
		Путь = "/" + Путь;
	КонецЕсли;
	
	HTTPОшибка = "";
	Для НомерПопытки = 1 По 3 Цикл
		Попытка
			Соединение = Новый HTTPСоединение(URI.Хост, Порт, , , , 90, ?(Защищенное, Новый ЗащищенноеСоединениеOpenSSL, Неопределено));
			Запрос = Новый HTTPЗапрос(Путь);
			Если Заголовки <> Неопределено Тогда
				Для Каждого ПараЗаголовка Из Заголовки Цикл
					Запрос.Заголовки.Вставить(ПараЗаголовка.Ключ, ПараЗаголовка.Значение);
				КонецЦикла;
			КонецЕсли;
			Ответ = Соединение.Получить(Запрос);
			Код = Ответ.КодСостояния;
			Если Код >= 300 И Код < 400 Тогда
				Location = ЗаголовокLocationHTTPНаСервере(Ответ);
				СледующийURL = АбсолютныйURLРедиректаНаСервере(URL, Location);
				Если ПустаяСтрока(СледующийURL) Тогда
					Результат.Ошибка = "HTTP " + Формат(Код, "ЧГ=0") + " без Location при загрузке " + URL;
					Возврат Результат;
				КонецЕсли;
				Возврат HTTPПолучитьДвоичныеДанные(СледующийURL, Заголовки, ГлубинаРедиректа + 1);
			КонецЕсли;
			Если Код <> 200 Тогда
				Результат.Ошибка = "HTTP " + Формат(Код, "ЧГ=0") + " при загрузке " + URL;
				Возврат Результат;
			КонецЕсли;
			Результат.Данные = Ответ.ПолучитьТелоКакДвоичныеДанные();
			HTTPОшибка = "";
			Прервать;
		Исключение
			HTTPОшибка = ОписаниеОшибки();
			Если НомерПопытки < 3 Тогда
				ПаузаМсHTTPНаСервере(400 * НомерПопытки);
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	
	Если Не ПустаяСтрока(HTTPОшибка) Тогда
		Результат.Ошибка = ТекстОшибкиHTTPЗагрузкиНаСервере(HTTPОшибка, URL);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


