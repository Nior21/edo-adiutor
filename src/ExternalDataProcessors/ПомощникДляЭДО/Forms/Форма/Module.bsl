	TargetPath = ОчередьApplyTargetPath;
	ReleaseVer = ОчередьApplyReleaseVer;
	EpfUrl = ОчередьApplyEpfUrl;
	ОчередьApplyTargetPath = "";
	ОчередьApplyReleaseVer = "";
	ОчередьApplyEpfUrl = "";
	
	ПереключитьсяНаДоступнуюВерсию(TargetPath, Ложь, ReleaseVer, EpfUrl);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСведенияОбОбновленииВИнтерфейс()
	
	ОбеспечитьПутьЯкоряНаКлиенте();
	JSON = "";
	Попытка
		JSON = СведенияОбОбновленииJSONНаСервере();
		JSON = ДополнитьСведенияОбОбновленииJSONНаКлиенте(JSON);
	Исключение
		JSON = JSONСведенияОбОбновленииСОшибкойНаСервере(ОчиститьСтрокуДляОбмена(ОписаниеОшибки()));
	КонецПопытки;
	
	Попытка
		View().edoSetUpdateInfo(JSON);
	Исключение
		СообщитьBridgeОшибку("React UI: edoSetUpdateInfo — " + ОписаниеОшибки());
	КонецПопытки;
	
	Если ОкноПомеченоУстаревшим Тогда
		Возврат;
	КонецЕсли;
	
	Данные = РазобратьJSONСтруктуруНаКлиенте(JSON);
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Автопереключение с epfUrl — в React (bridge applyUpdate), не дублируем здесь.
	
КонецПроцедуры

&НаКлиенте
Процедура ОтложенноеАвтоПереключениеВерсии() Экспорт
	
	Версия = ОчередьПереключенияВерсии;
	ОчередьПереключенияВерсии = "";
	Если ПустаяСтрока(Версия) Или ОкноПомеченоУстаревшим Тогда
		Возврат;
	КонецЕсли;
	
	ПереключитьсяНаДоступнуюВерсию("", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПутьКФайлуEPFНаКлиенте()
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Файл внешней обработки для автоматического обновления";
	Диалог.Фильтр = "Внешние обработки (*.epf)|*.epf";
	Диалог.МножественныйВыбор = Ложь;
	
	СохраненныйПуть = ПутьКФайлуEPFНаСервере();
	Если ЗначениеЗаполнено(СохраненныйПуть) Тогда
		Диалог.ПолноеИмяФайла = СохраненныйПуть;
	КонецЕсли;
	
	Если Диалог.Выбрать() Тогда
		СохранитьПутьКФайлуEPFНаСервере(НормализоватьПутьЯкоряНаКлиенте(Диалог.ПолноеИмяФайла));
		ОтправитьСведенияОбОбновленииВИнтерфейс();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьсяНаДоступнуюВерсию(TargetPath, Автоматически, ЦелеваяВерсияИзReact = "", EpfUrlИзReact = "")
	
	ПутьЯкоря = СокрЛП(TargetPath);
	Если ПустаяСтрока(ПутьЯкоря) Тогда
		ПутьЯкоря = ПутьКФайлуEPFНаСервере();
	КонецЕсли;
	ПутьЯкоря = НормализоватьПутьЯкоряНаКлиенте(ПутьЯкоря);
	
	Если ПустаяСтрока(ПутьЯкоря) Тогда
		ОбеспечитьПутьЯкоряНаКлиенте();
		ПутьЯкоря = НормализоватьПутьЯкоряНаКлиенте(ПутьКФайлуEPFНаСервере());
	КонецЕсли;
	
	Если ПустаяСтрока(ПутьЯкоря) Тогда
		СообщитьBridgeОшибку("Не удалось определить файл .epf для обновления.");
		Возврат;
	КонецЕсли;
	
	СохранитьПутьКФайлуEPFНаСервере(ПутьЯкоря);
	
	ЦелеваяВерсия = СокрЛП(ЦелеваяВерсияИзReact);
	EpfUrl = СокрЛП(EpfUrlИзReact);
	
	Если ЗначениеЗаполнено(ЦелеваяВерсия) И ЗначениеЗаполнено(EpfUrl) Тогда
		Данные = Новый Структура("epfUrl, notes, localHasTarget", EpfUrl, "", Ложь);
	Иначе
		JSON = СведенияОбОбновленииJSONНаСервере();
		JSON = ДополнитьСведенияОбОбновленииJSONНаКлиенте(JSON);
		Данные = РазобратьJSONСтруктуруНаКлиенте(JSON);
		Если Данные = Неопределено Тогда
			СообщитьBridgeОшибку("Не удалось определить целевую версию.");
			Возврат;
		КонецЕсли;
		ЦелеваяВерсия = СокрЛП(JSONСтрокаПоляНаКлиенте(Данные, "targetVersion"));
	КонецЕсли;
	
	Если ПустаяСтрока(ЦелеваяВерсия) Тогда
		СообщитьBridgeСтатус("Нет версии новее текущей.");
		Возврат;
	КонецЕсли;
	
	Текущая = ПолучитьВерсиюПриложенияНаСервере();
	Если СравнитьВерсииПриложенияНаСервере(Текущая, ЦелеваяВерсия) > 0 Тогда
		СообщитьBridgeСтатус("Уже запущена более новая версия (v" + Текущая + ").");
		Возврат;
	КонецЕсли;
	
	Попытка
		РезультатАктивации = АктивироватьВерсиюEpfНаКлиенте(ПутьЯкоря, ЦелеваяВерсия, Данные, Автоматически, Истина);
		Предупреждение = РезультатАктивации.Предупреждение;
		УспехОбновления = (РезультатАктивации.ОткрытоНовоеОкно
			Или РезультатАктивации.ПерезагруженоВЭтомОкне
			Или РезультатАктивации.ЯкорьОбновлен);
		Если РезультатАктивации.ОткрытоНовоеОкно Тогда
			Сообщение = "Версия v" + ЦелеваяВерсия + " открыта в новом окне. Это окно можно закрыть.";
		ИначеЕсли РезультатАктивации.ПерезагруженоВЭтомОкне Тогда
			Сообщение = "Версия v" + ЦелеваяВерсия + " применена в этом окне.";
		ИначеЕсли РезультатАктивации.ЯкорьОбновлен Тогда
			Сообщение = "Файл v" + ЦелеваяВерсия + " записан в " + ПутьЯкоря + ". Закройте обработку и откройте этот .epf снова.";
		Иначе
			Сообщение = "Не удалось автоматически переключиться на v" + ЦелеваяВерсия
				+ ". Файл скачан: " + РезультатАктивации.ПутьРелиза
				+ ". Нажмите «Открыть новую версию» или закройте окно и откройте .epf заново.";
		КонецЕсли;
		Если ЗначениеЗаполнено(Предупреждение) Тогда
			Сообщение = Сообщение + " " + Предупреждение;
		КонецЕсли;
		ПутьЗапуска = ?(ЗначениеЗаполнено(РезультатАктивации.ПутьРелиза), РезультатАктивации.ПутьРелиза, ПутьЯкоря);
		ОтправитьРезультатОбновленияВИнтерфейс(
			УспехОбновления,
			Сообщение,
			ПутьЯкоря,
			ЦелеваяВерсия,
			ПутьЗапуска,
			РезультатАктивации);
	Исключение
		МостПриостановлен = Ложь;
		ОжидаемReadyПослеПерезагрузки = Ложь;
		Текст = ОписаниеОшибки();
		СообщитьBridgeОшибку(Текст);
		ОтправитьРезультатОбновленияВИнтерфейс(Ложь, Текст, ПутьЯкоря, "", "", Неопределено);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЛокальныйРелизПоВерсии(Версия, EpfUrl = "")
	
	Версия = СокрЛП(Версия);
	EpfUrl = СокрЛП(EpfUrl);
	Если ПустаяСтрока(Версия) Тогда
		Возврат;
	КонецЕсли;
	
	ОбеспечитьПутьЯкоряНаКлиенте();
	ПутьЯкоря = ПутьКФайлуEPFНаСервере();
	Если ПустаяСтрока(ПутьЯкоря) Тогда
		СообщитьBridgeОшибку("Не удалось определить файл .epf (откройте обработку из файла на диске).");
		Возврат;
	КонецЕсли;
	
	ПутьЯкоря = НормализоватьПутьЯкоряНаКлиенте(ПутьЯкоря);
	ПутьEpf = ПутьEpfРелизаНаКлиенте(ПутьЯкоря, Версия);
	Если Не EPFФайлСуществуетНаКлиенте(ПутьEpf) Тогда
		Если ЗначениеЗаполнено(EpfUrl) Тогда
			ПереключитьсяНаДоступнуюВерсию(ПутьЯкоря, Ложь, Версия, EpfUrl);
			Возврат;
		КонецЕсли;
		СообщитьBridgeОшибку("На диске нет релиза v" + Версия + ". Укажите URL в манифесте или скачайте с GitHub.");
		Возврат;
	КонецЕсли;
	
	Попытка
		РезЛок = Новый Структура("Предупреждение", "");
		ПодменитьЯкорныйEpfБезОшибкиНаКлиенте(ПутьЯкоря, ПутьEpf, РезЛок);
		МостПриостановлен = Истина;
		ОжидаемReadyПослеПерезагрузки = Истина;
		Если ЭтоВебКлиентПомощникаНаКлиенте() Тогда
			Если ОбновитьОбработкуИReactИзФайлаНаКлиенте(ПутьEpf) Тогда
				// Мост разблокируется по action=ready
			ИначеЕсли ОткрытьEpfПоПутиВНовомОкнеКлиентом(ПутьEpf) Тогда
				ОжидаемReadyПослеПерезагрузки = Ложь;
				ПометитьОкноУстаревшим(Версия, ПутьEpf, Ложь);
				МостПриостановлен = Ложь;
			Иначе
				ОжидаемReadyПослеПерезагрузки = Ложь;
				МостПриостановлен = Ложь;
				СообщитьBridgeОшибку("В веб-клиенте откройте v" + Версия + " через «Открыть новую версию» или заново с диска: " + ПутьEpf);
			КонецЕсли;
		ИначеЕсли ПерезагрузитьТекущуюФормуИзEpfНаКлиенте(ПутьEpf) Тогда
			// Мост разблокируется по action=ready
		ИначеЕсли ОткрытьEpfВНезависимомОкнеНаКлиенте(ПутьEpf, ПутьЯкоря) Тогда
			ОжидаемReadyПослеПерезагрузки = Ложь;
			ПометитьОкноУстаревшим(Версия, ПутьEpf, Ложь);
			МостПриостановлен = Ложь;
		Иначе
			ОжидаемReadyПослеПерезагрузки = Ложь;
			МостПриостановлен = Ложь;
			СообщитьBridgeОшибку("Не удалось открыть v" + Версия + ". Файл: " + ПутьEpf);
		КонецЕсли;
	Исключение
		МостПриостановлен = Ложь;
		ОжидаемReadyПослеПерезагрузки = Ложь;
		СообщитьBridgeОшибку(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция АктивироватьВерсиюEpfНаКлиенте(ПутьЯкоря, ЦелеваяВерсия, Данные, Автоматически, ПометитьУстаревшим)
	
	Результат = Новый Структура(
		"Предупреждение, ПерезагруженоВЭтомОкне, ОткрытоНовоеОкно, ПутьРелиза, ЯкорьОбновлен",
		"", Ложь, Ложь, "", Ложь);
	МостПриостановлен = Истина;
	ПутьЯкоря = НормализоватьПутьЯкоряНаКлиенте(ПутьЯкоря);
	СохранитьПутьКФайлуEPFНаСервере(ПутьЯкоря);
	
	ПутьРелиза = ОбеспечитьЛокальныйРелизНаКлиенте(ПутьЯкоря, ЦелеваяВерсия, Данные);
	Результат.ПутьРелиза = ПутьРелиза;
	ПутьПоследнегоРелизаEpf = ПутьРелиза;
	
	// Якорь на диске — до перезагрузки UI (иначе повторное открытие .epf остаётся на старой версии).
	Результат.ЯкорьОбновлен = ПодменитьЯкорныйEpfБезОшибкиНаКлиенте(ПутьЯкоря, ПутьРелиза, Результат);
	
	// В веб-клиенте in-place: только серверное переподключение + новый HTML (без Подключить с клиента).
	Если ЭтоВебКлиентПомощникаНаКлиенте() Тогда
		ОжидаемReadyПослеПерезагрузки = Истина;
		Если ОбновитьОбработкуИReactИзФайлаНаКлиенте(ПутьРелиза) Тогда
			Результат.ПерезагруженоВЭтомОкне = Истина;
			Если ПометитьУстаревшим Тогда
				// окно актуально
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
		Если ОткрытьОбновлениеEpfВНовомОкнеНаКлиенте(ПутьРелиза, ПутьЯкоря) Тогда
			Результат.ОткрытоНовоеОкно = Истина;
			ОжидаемReadyПослеПерезагрузки = Ложь;
			Если ПометитьУстаревшим Тогда
				ПометитьОкноУстаревшим(ЦелеваяВерсия, ПутьРелиза, Автоматически);
			КонецЕсли;
			МостПриостановлен = Ложь;
			Возврат Результат;
		КонецЕсли;
		Если Результат.ЯкорьОбновлен Тогда
			Если ПометитьУстаревшим Тогда
				ПометитьОкноУстаревшим(ЦелеваяВерсия, ПутьРелиза, Автоматически);
			КонецЕсли;
			Результат.Предупреждение = "Файл обновлён. Закройте это окно и откройте .epf с диска (в веб-клиенте перезапуск из формы недоступен).";
		КонецЕсли;
		МостПриостановлен = Ложь;
		Возврат Результат;
	КонецЕсли;

	// В веб-клиенте переподключение .epf из открытой формы часто падает — сначала открываем файл по пути.
	Если ОткрытьОбновлениеEpfВНовомОкнеНаКлиенте(ПутьРелиза, ПутьЯкоря) Тогда
		Результат.ОткрытоНовоеОкно = Истина;
		ОжидаемReadyПослеПерезагрузки = Ложь;
		Если ПометитьУстаревшим Тогда
			ПометитьОкноУстаревшим(ЦелеваяВерсия, ПутьРелиза, Автоматически);
		КонецЕсли;
		МостПриостановлен = Ложь;
		Возврат Результат;
	КонецЕсли;
	
	// In-place reload в веб-клиенте даёт «Неизвестный идентификатор формы» — только толстый/тонкий клиент.
	Если ЭтоВебКлиентПомощникаНаКлиенте() Тогда
		МостПриостановлен = Ложь;
		Возврат Результат;
	КонецЕсли;
	
	// Перезагрузка в этом окне — без второго окна и повторного «первого запуска» .epf.
	ОжидаемReadyПослеПерезагрузки = Истина;
	Если ПерезагрузитьТекущуюФормуИзEpfНаКлиенте(ПутьРелиза) Тогда
		Результат.ПерезагруженоВЭтомОкне = Истина;
		Возврат Результат;
	КонецЕсли;
	ОжидаемReadyПослеПерезагрузки = Ложь;
	
	Если ПометитьУстаревшим Тогда
		ПометитьОкноУстаревшим(ЦелеваяВерсия, ПутьРелиза, Автоматически);
	КонецЕсли;
	
	Если ОткрытьEpfВНезависимомОкнеНаКлиенте(ПутьРелиза, ПутьЯкоря) Тогда
		Результат.ОткрытоНовоеОкно = Истина;
		МостПриостановлен = Ложь;
		Возврат Результат;
	КонецЕсли;
	
	МостПриостановлен = Ложь;
	
	Если Не Результат.ЯкорьОбновлен Тогда
		Результат.Предупреждение = СокрЛП(Результат.Предупреждение + " Якорный .epf занят — закройте все окна обработки и откройте файл снова.");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция ПутьОтложеннойПодменыЯкоряНаКлиенте(ПутьЯкоря)
	
	Возврат СокрЛП(ПутьЯкоря) + ".pending-update.epf";
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьОтложеннуюПодменуЯкоряНаКлиенте(ПутьЯкоря, ПутьРелиза)
	
	ПутьPending = ПутьОтложеннойПодменыЯкоряНаКлиенте(ПутьЯкоря);
	Попытка
		КопироватьФайл(ПутьРелиза, ПутьPending);
	Исключение
		Двоичные = Новый ДвоичныеДанные(ПутьРелиза);
		Двоичные.Записать(ПутьPending);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьОтложеннуюПодменуЯкоряНаКлиенте()
	
	ОбеспечитьПутьЯкоряНаКлиенте();
	ПутьЯкоря = НормализоватьПутьЯкоряНаКлиенте(ПутьКФайлуEPFНаСервере());
	Если ПустаяСтрока(ПутьЯкоря) Тогда
		Возврат;
	КонецЕсли;
	
	ПутьPending = ПутьОтложеннойПодменыЯкоряНаКлиенте(ПутьЯкоря);
	Если Не EPFФайлСуществуетНаКлиенте(ПутьPending) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ПодменитьЯкорныйEpfИзРелизаНаКлиенте(ПутьЯкоря, ПутьPending);
		УдалитьФайлы(ПутьPending);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция ПодменитьЯкорныйEpfБезОшибкиНаКлиенте(ПутьЯкоря, ПутьРелиза, РезультатАктивации)
	
	// Резерв: при занятом якоре подмена сработает в ПриОткрытии через .pending-update.epf
	ЗаписатьОтложеннуюПодменуЯкоряНаКлиенте(ПутьЯкоря, ПутьРелиза);
	
	Попытка
		ПодменитьЯкорныйEpfИзРелизаНаКлиенте(ПутьЯкоря, ПутьРелиза);
		ПутьPending = ПутьОтложеннойПодменыЯкоряНаКлиенте(ПутьЯкоря);
		Если EPFФайлСуществуетНаКлиенте(ПутьPending) Тогда
			Попытка
				УдалитьФайлы(ПутьPending);
			Исключение
			КонецПопытки;
		КонецЕсли;
		Возврат Истина;
	Исключение
		РезультатАктивации.Предупреждение = СокрЛП(
			РезультатАктивации.Предупреждение + " Якорь занят — при следующем открытии .epf подставится версия из .pending-update.epf.");
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ВерсияМанифестаРелизаНаКлиенте(ПутьEpf)
	
	Файл = Новый Файл(ПутьEpf);
	ПутьМанифеста = Файл.Путь + "manifest.json";
	ФайлМанифест = Новый Файл(ПутьМанифеста);
	Если Не ФайлМанифест.Существует() Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеТекста(ПутьМанифеста, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
		Данные = JSONВЗначениеНаСервере(Текст);
		Возврат JSONСтрокаПоляНаСервере(Данные, "version");
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ПодменитьЯкорныйEpfИзРелизаНаКлиенте(ПутьЯкоря, ПутьРелиза)
	
	Если Не EPFФайлСуществуетНаКлиенте(ПутьРелиза) Тогда
		ВызватьИсключение "Файл релиза не найден: " + ПутьРелиза;
	КонецЕсли;
	
	ФайлЯкоря = Новый Файл(ПутьЯкоря);
	КаталогЯкоря = Новый Файл(ФайлЯкоря.Путь);
	Если Не КаталогЯкоря.Существует() Тогда
		СоздатьКаталог(ФайлЯкоря.Путь);
	КонецЕсли;
	
	Попытка
		КопироватьФайл(ПутьРелиза, ПутьЯкоря);
	Исключение
		Двоичные = Новый ДвоичныеДанные(ПутьРелиза);
		Двоичные.Записать(ПутьЯкоря);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция НормализоватьПутьЯкоряНаКлиенте(ПутьЯкоря)
	
	ПутьЯкоря = СокрЛП(ПутьЯкоря);
	Если ПустаяСтрока(ПутьЯкоря) Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяEpf = ИмяФайлаEpfНаСервере();
	Файл = Новый Файл(ПутьЯкоря);
	Каталог = Файл.Путь;
	Подкаталог = ПодкаталогРелизовНаСервере();
	Маркер = "\" + Подкаталог + "\";
	Поз = СтрНайти(ВРег(Каталог), ВРег(Маркер));
	Если Поз > 0 Тогда
		Каталог = Лев(Каталог, Поз);
	КонецЕсли;
	
	Возврат Каталог + ИмяEpf;
	
КонецФункции

&НаКлиенте
Функция ОбеспечитьЛокальныйРелизНаКлиенте(ПутьЯкоря, ЦелеваяВерсия, Данные)
	
	ПутьEpf = ПутьEpfРелизаНаКлиенте(ПутьЯкоря, ЦелеваяВерсия);
	Если EPFФайлСуществуетНаКлиенте(ПутьEpf) Тогда
		ВерсияКэша = ВерсияМанифестаРелизаНаКлиенте(ПутьEpf);
		Если Не ПустаяСтрока(ВерсияКэша) И СравнитьВерсииПриложенияНаСервере(ВерсияКэша, ЦелеваяВерсия) = 0 Тогда
			Возврат ПутьEpf;
		КонецЕсли;
		Попытка
			УдалитьФайлы(ПутьEpf);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если JSONБулевоПоляНаСервере(Данные, "localHasTarget") = Истина Тогда
		// Рассинхрон индекса — пересканируем.
		ПутьEpf = НайтиПутьРелизаПоВерсииНаКлиенте(ПутьЯкоря, ЦелеваяВерсия);
		Если ЗначениеЗаполнено(ПутьEpf) Тогда
			Возврат ПутьEpf;
		КонецЕсли;
	КонецЕсли;
	
	URLСкачивания = JSONСтрокаПоляНаСервере(Данные, "epfUrl");
	Подготовка = ПодготовитьЗагрузкуОбновленияНаСервере(ЦелеваяВерсия, URLСкачивания);
	Если Не Подготовка.Успех Тогда
		ВызватьИсключение Подготовка.Сообщение;
	КонецЕсли;
	
	СоздатьКаталогРелизаНаКлиенте(ПутьEpf);
	ЗаписатьДвоичныеEpfНаКлиенте(ПутьEpf, Подготовка.АдресДанных);
	ЗаписатьМанифестРелизаНаКлиенте(ПутьEpf, ЦелеваяВерсия, JSONСтрокаПоляНаСервере(Данные, "notes"));
	
	Возврат ПутьEpf;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьДвоичныеEpfНаКлиенте(ПутьEpf, АдресДанных)
	
	Двоичные = ПолучитьИзВременногоХранилища(АдресДанных);
	Если Двоичные = Неопределено Или Двоичные.Размер() = 0 Тогда
		ВызватьИсключение "Пустой файл обновления";
	КонецЕсли;
	
	Двоичные.Записать(ПутьEpf);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКаталогРелизаНаКлиенте(ПутьEpf)
	
	Файл = Новый Файл(ПутьEpf);
	Каталог = Новый Файл(Файл.Путь);
	Если Не Каталог.Существует() Тогда
		СоздатьКаталог(Файл.Путь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьМанифестРелизаНаКлиенте(ПутьEpf, Версия, Примечания)
	
	Файл = Новый Файл(ПутьEpf);
	ПутьМанифеста = Файл.Путь + "manifest.json";
	Тело = "{""version"":""" + СтрЗаменить(Версия, """", "\""") + """,""notes"":""" + СтрЗаменить(Примечания, """", "\""") + """}";
	Запись = Новый ЗаписьТекста(ПутьМанифеста, КодировкаТекста.UTF8);
	Запись.Записать(Тело);
	Запись.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьИОткрытьEpfНаКлиенте()
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Открыть внешнюю обработку (.epf)";
	Диалог.Фильтр = "Внешние обработки (*.epf)|*.epf";
	Диалог.МножественныйВыбор = Ложь;
	
	Подсказка = ПутьПоследнегоРелизаEpf;
	Если ПустаяСтрока(Подсказка) Тогда
		Подсказка = ПутьКФайлуEPFНаСервере();
	КонецЕсли;
	Если ЗначениеЗаполнено(Подсказка) Тогда
		Диалог.ПолноеИмяФайла = Подсказка;
	КонецЕсли;
	
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	Путь = НормализоватьПутьЯкоряНаКлиенте(Диалог.ПолноеИмяФайла);
	СохранитьПутьКФайлуEPFНаСервере(Путь);
	Если Не ОткрытьEpfВНезависимомОкнеНаКлиенте(Диалог.ПолноеИмяФайла, Путь) Тогда
		СообщитьBridgeОшибку("Не удалось открыть выбранный .epf. Попробуйте перетащить файл на окно 1С (Файл → Открыть).");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьEpfПоПутиЗапускаНаКлиенте(ПутьИзReact)
	
	ПутьEpf = СокрЛП(ПутьИзReact);
	Если ПустаяСтрока(ПутьEpf) Тогда
		ПутьEpf = ПутьПоследнегоРелизаEpf;
	КонецЕсли;
	Если ПустаяСтрока(ПутьEpf) Или Не EPFФайлСуществуетНаКлиенте(ПутьEpf) Тогда
		ОбеспечитьПутьЯкоряНаКлиенте();
		ПутьЯкоря = ПутьКФайлуEPFНаСервере();
		Если ЗначениеЗаполнено(ПутьЯкоря) Тогда
			ПутьEpf = ПутьЯкоря;
		КонецЕсли;
	КонецЕсли;
	
	Если ПустаяСтрока(ПутьEpf) Или Не EPFФайлСуществуетНаКлиенте(ПутьEpf) Тогда
		СообщитьBridgeОшибку("Файл новой версии не найден. Укажите .epf через «Выбрать файл…».");
		Возврат;
	КонецЕсли;
	
	ПутьЯкоря = НормализоватьПутьЯкоряНаКлиенте(ПутьКФайлуEPFНаСервере());
	Если Не ОткрытьEpfВНезависимомОкнеНаКлиенте(ПутьEpf, ПутьЯкоря) Тогда
		СообщитьBridgeОшибку("Не удалось открыть: " + ПутьEpf);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
&НаКлиенте
Функция ОшибкаСессииФормыПотеряна(ТекстОшибки)

	Текст = ВРег(СокрЛП(Строка(ТекстОшибки)));
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СтрНайти(Текст, "НЕИЗВЕСТНЫЙ ИДЕНТИФИКАТОР ФОРМЫ") > 0
		Или СтрНайти(Текст, "UNKNOWN FORM IDENTIFIER") > 0;

КонецФункции

&НаКлиенте
Функция ЭтоВебКлиентПомощникаНаКлиенте()

	#Если ВебКлиент Тогда
		Возврат Истина;
	#Иначе
		Возврат Ложь;
	#КонецЕсли

КонецФункции

&НаКлиенте
Функция ОткрытьОбновлениеEpfВНовомОкнеНаКлиенте(ПутьРелиза, ПутьЯкоря)
	
	Если ОткрытьEpfПоПутиВНовомОкнеКлиентом(ПутьРелиза) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПутьЯкоря = СокрЛП(ПутьЯкоря);
	Если ЗначениеЗаполнено(ПутьЯкоря) И ВРег(ПутьЯкоря) <> ВРег(СокрЛП(ПутьРелиза)) Тогда
		Если ОткрытьEpfПоПутиВНовомОкнеКлиентом(ПутьЯкоря) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ОткрытьEpfПоПутиВНовомОкнеКлиентом(ПутьEpf)
	
	ПутьEpf = СокрЛП(ПутьEpf);
	Если ПустаяСтрока(ПутьEpf) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ОткрытьФорму(ПутьEpf, , , , , , , РежимОткрытияОкнаФормы.Независимый);
		Возврат Истина;
	Исключение
		Попытка
			ОткрытьФорму(ПутьEpf);
			Возврат Истина;
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция ОткрытьEpfВНезависимомОкнеНаКлиенте(ПутьEpf, ЯкорьПараметрыСтроки = "")
	
	ПутьEpf = СокрЛП(ПутьEpf);
	Если ПустаяСтрока(ПутьEpf) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОткрытьEpfПоПутиВНовомОкнеКлиентом(ПутьEpf) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ЭтоВебКлиентПомощникаНаКлиенте() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Двоичные = Новый ДвоичныеДанные(ПутьEpf);
	Исключение
		СообщитьBridgeОшибку("Нет доступа к файлу .epf: " + ПутьEpf);
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		Результат = ПодключитьEpfИзДвоичныхНаСервере(Двоичные);
	Исключение
		Если Не ОшибкаСессииФормыПотеряна(ОписаниеОшибки()) Тогда
			СообщитьBridgeОшибку("Открытие .epf: " + ОписаниеОшибки());
		КонецЕсли;
		Возврат Ложь;
	КонецПопытки;
	
	Если Не Результат.Успех Или ПустаяСтрока(Результат.ИмяПодключения) Тогда
		Текст = Результат.Сообщение;
		Если ПустаяСтрока(Текст) Тогда
			Текст = "не удалось подключить .epf";
		КонецЕсли;
		СообщитьBridgeОшибку("Подключение .epf: " + Текст);
		Возврат Ложь;
	КонецЕсли;
	
	ЯкорьПараметры = СокрЛП(ЯкорьПараметрыСтроки);
	Если ПустаяСтрока(ЯкорьПараметры) Тогда
		ЯкорьПараметры = НормализоватьПутьЯкоряНаКлиенте(ПутьEpf);
	КонецЕсли;
	
	ОткрытьФормуEpfСПутем(Результат.ИмяПодключения, ЯкорьПараметры, Истина);
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьEpfФайлВНовомОкне(ПутьEpf)
	
	ПутьЯкоря = НормализоватьПутьЯкоряНаКлиенте(ПутьКФайлуEPFНаСервере());
	Если Не ОткрытьEpfВНезависимомОкнеНаКлиенте(ПутьEpf, ПутьЯкоря) Тогда
		СообщитьBridgeОшибку("Не удалось открыть новое окно. Файл: " + ПутьEpf);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуEpfСПутем(ИмяПодключения, ПутьEpf, НезависимоеОкно = Ложь)
	
	ПараметрыФормы = Неопределено;
	Если ЗначениеЗаполнено(ПутьEpf) Тогда
		ПараметрыФормы = Новый Структура("ПутьКФайлуEpf", ПутьEpf);
	КонецЕсли;
	
	ИмяОткрываемойФормыEpf = "ВнешняяОбработка." + ИмяПодключения + ".Форма.Форма";
	РежимОкна = ?(НезависимоеОкно, РежимОткрытияОкнаФормы.Независимый, Неопределено);
	
	Если ПараметрыФормы = Неопределено Тогда
		ОткрытьФорму(ИмяОткрываемойФормыEpf, , , , , , , РежимОкна);
	Иначе
		ОткрытьФорму(ИмяОткрываемойФормыEpf, ПараметрыФормы, , , , , , РежимОкна);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодключитьEpfФайлНаСервере(ПутьEpf)
	
	Результат = Новый Структура("Успех, ИмяПодключения, Сообщение", Ложь, "", "");
	ПутьEpf = СокрЛП(ПутьEpf);
	Если ПустаяСтрока(ПутьEpf) Тогда
		Результат.Сообщение = "Пустой путь к .epf";
		Возврат Результат;
	КонецЕсли;
	
	ИмяПодключения = ПодключитьEpfПлатформойНаСервере(ПутьEpf);
	Результат.Успех = ЗначениеЗаполнено(ИмяПодключения);
	Результат.ИмяПодключения = ИмяПодключения;
	Если Не Результат.Успех Тогда
		Результат.Сообщение = "Сервер не смог подключить .epf по пути (файл может быть недоступен серверу 1С).";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПодключитьEpfИзДвоичныхНаСервере(ДвоичныеEpf)
	
	Результат = Новый Структура("Успех, ИмяПодключения, Сообщение", Ложь, "", "");
	
	Если ДвоичныеEpf = Неопределено Или ДвоичныеEpf.Размер() < 1024 Тогда
		Результат.Сообщение = "Пустой или слишком маленький файл .epf";
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		АдресДанных = ПоместитьВоВременноеХранилище(ДвоичныеEpf, УникальныйИдентификатор);
		РезультатПодключения = ПодключитьEpfПоАдресуХранилищаНаСервере(АдресДанных);
		Возврат РезультатПодключения;
	Исключение
		Результат.Сообщение = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПодключитьEpfПоАдресуХранилищаНаСервере(АдресДанных)
	
	Результат = Новый Структура("Успех, ИмяПодключения, Сообщение", Ложь, "", "");
	АдресДанных = СокрЛП(АдресДанных);
	Если ПустаяСтрока(АдресДанных) Тогда
		Результат.Сообщение = "Пустой адрес данных .epf";
		Возврат Результат;
	КонецЕсли;
	
	ИмяПодключения = ПодключитьEpfПлатформойНаСервере(АдресДанных);
	Результат.Успех = ЗначениеЗаполнено(ИмяПодключения);
	Результат.ИмяПодключения = ИмяПодключения;
	Если Не Результат.Успех Тогда
		Результат.Сообщение = "ВнешниеОбработки.Подключить не принял файл из хранилища.";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПодключитьEpfПлатформойНаСервере(ПутьИлиАдрес)
	
	ИмяПодключения = "";
	Попытка
		Выполнить("ИмяПодключения = ВнешниеОбработки.Подключить(ПутьИлиАдрес, , Ложь);");
	Исключение
		Попытка
			Выполнить("ПодключитьВнешнююОбработку(ПутьИлиАдрес, ИмяПодключения, Ложь);");
		Исключение
			Возврат "";
		КонецПопытки;
	КонецПопытки;
	
	Возврат ИмяПодключения;
	
КонецФункции

&НаКлиенте
Процедура ПометитьОкноУстаревшим(НоваяВерсия, ПутьEpf, Автоматически)
	
	ОкноПомеченоУстаревшим = Истина;
	
	Сообщение = "Запущена версия v" + НоваяВерсия + ". Закройте это окно обработки.";
	Если Автоматически Тогда
		Сообщение = "Автообновление: " + Сообщение;
	КонецЕсли;
	
	Ответ = Новый Структура;
	Ответ.Вставить("phase", "superseded");
	Ответ.Вставить("uiMode", "superseded");
	Ответ.Вставить("launchedVersion", НоваяВерсия);
	Ответ.Вставить("launchedPath", ПутьEpf);
	Ответ.Вставить("message", Сообщение);
	Ответ.Вставить("currentVersion", ВерсияПриложенияНаКлиенте());
	
	JSON = ЗаписатьJSONСтрокойНаКлиенте(Ответ);
	Попытка
		View().edoSetUpdateInfo(JSON);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция ДополнитьСведенияОбОбновленииJSONНаКлиенте(JSON)
	
	Данные = РазобратьJSONСтруктуруНаКлиенте(JSON);
	Если Данные = Неопределено Тогда
		Возврат JSON;
	КонецЕсли;
	
	ПутьЯкоря = НормализоватьПутьЯкоряНаКлиенте(ПутьКФайлуEPFНаСервере());
	Данные.Вставить("epfPath", ПутьЯкоря);
	
	Локальные = СканироватьЛокальныеРелизыНаКлиенте(ПутьЯкоря);
	Данные.Вставить("localReleases", Локальные);
	
	ЛокальнаяМакс = МаксимальнаяВерсияИзСпискаНаСервере(Локальные);
	Данные.Вставить("localLatestVersion", ЛокальнаяМакс);
	
	GitHub = ПрочитатьGitHubРелизНаСервере();
	Если ЗначениеЗаполнено(GitHub.Версия) Тогда
		Данные.Вставить("remoteLatestVersion", GitHub.Версия);
		Данные.Вставить("epfUrl", GitHub.EpfUrl);
		Данные.Вставить("notes", ОчиститьСтрокуДляОбмена(GitHub.Примечания));
		Данные.Вставить("githubReleaseUrl", GitHub.HtmlUrl);
		Данные.Вставить("manifestConfigured", Истина);
		Если ПустаяСтрока(GitHub.EpfUrl) Тогда
			Данные.Вставить("error", "На GitHub Release нет asset " + ИмяФайлаGitHubReleaseНаСервере() + ".");
		КонецЕсли;
	ИначеЕсли Не ПустаяСтрока(GitHub.Ошибка) И ПустаяСтрока(JSONСтрокаПоляНаСервере(Данные, "error")) Тогда
		Данные.Вставить("error", ОчиститьСтрокуДляОбмена(GitHub.Ошибка));
	КонецЕсли;
	
	Если ПустаяСтрока(JSONСтрокаПоляНаСервере(Данные, "remoteLatestVersion")) И ЗначениеЗаполнено(ПутьЯкоря) Тогда
		ЛокальныйМанифест = ПрочитатьЛокальныйМанифестРядомСEpfНаКлиенте(ПутьЯкоря);
		Если Не ПустаяСтрока(ЛокальныйМанифест.Ошибка) Тогда
			Если ПустаяСтрока(JSONСтрокаПоляНаСервере(Данные, "error")) Тогда
				Данные.Вставить("error", ОчиститьСтрокуДляОбмена(ЛокальныйМанифест.Ошибка));
			КонецЕсли;
		Иначе
			Данные.Вставить("remoteLatestVersion", ЛокальныйМанифест.Версия);
			Данные.Вставить("epfUrl", ЛокальныйМанифест.EpfUrl);
			Данные.Вставить("notes", ОчиститьСтрокуДляОбмена(ЛокальныйМанифест.Примечания));
			Данные.Вставить("manifestConfigured", Истина);
		КонецЕсли;
	КонецЕсли;
	
	Целевая = JSONСтрокаПоляНаСервере(Данные, "remoteLatestVersion");
	Если ЗначениеЗаполнено(ЛокальнаяМакс) И (ПустаяСтрока(Целевая) Или СравнитьВерсииПриложенияНаСервере(ЛокальнаяМакс, Целевая) > 0) Тогда
		Целевая = ЛокальнаяМакс;
	КонецЕсли;
	Данные.Вставить("targetVersion", Целевая);
	Данные.Вставить("latestVersion", Целевая);
	
	Данные.Вставить("localHasTarget", ЗначениеЗаполнено(НайтиПутьРелизаПоВерсииНаКлиенте(ПутьЯкоря, Целевая)));
	ТекущаяВерсия = JSONСтрокаПоляНаСервере(Данные, "currentVersion");
	ОбновлениеДоступно = (СравнитьВерсииПриложенияНаСервере(ТекущаяВерсия, Целевая) < 0);
	Данные.Вставить("updateAvailable", ОбновлениеДоступно);
	EpfUrl = JSONСтрокаПоляНаСервере(Данные, "epfUrl");
	Данные.Вставить("autoSwitchRecommended", Ложь);
	Данные.Вставить("versionCatalog", СформироватьКаталогВерсийНаКлиенте(Данные));
	
	Возврат ЗаписатьJSONСтрокойНаКлиенте(Данные);
	
КонецФункции

&НаКлиенте
Процедура ОбеспечитьПутьЯкоряНаКлиенте()
	
	Если ЗначениеЗаполнено(ПутьКФайлуEPFНаСервере()) Тогда
		Возврат;
	КонецЕсли;
	
	Используемое = ПолучитьИспользуемоеИмяФайлаEpfНаСервере();
	Если ЗначениеЗаполнено(Используемое) Тогда
		СохранитьПутьКФайлуEPFНаСервере(НормализоватьПутьЯкоряНаКлиенте(Используемое));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьКаталогВерсийНаКлиенте(Данные)
	
	Каталог = Новый Массив;
	Если Данные = Неопределено Тогда
		Возврат Каталог;
	КонецЕсли;
	
	Текущая = СокрЛП(JSONСтрокаПоляНаСервере(Данные, "currentVersion"));
	ПутьЯкоря = СокрЛП(JSONСтрокаПоляНаСервере(Данные, "epfPath"));
	Целевая = СокрЛП(JSONСтрокаПоляНаСервере(Данные, "targetVersion"));
	EpfUrl = СокрЛП(JSONСтрокаПоляНаСервере(Данные, "epfUrl"));
	ОбновлениеДоступно = (JSONБулевоПоляНаСервере(Данные, "updateAvailable") = Истина);
	ЛокальноЕстьЦель = (JSONБулевоПоляНаСервере(Данные, "localHasTarget") = Истина);
	
	УжеВКаталоге = Новый Соответствие;
	
	Если ЗначениеЗаполнено(Текущая) Тогда
		Строка = Новый Структура("version, path, kind, installed, epfUrl", Текущая, ПутьЯкоря, "current", Истина, "");
		Каталог.Добавить(Строка);
		УжеВКаталоге.Вставить(Текущая, Истина);
	КонецЕсли;
	
	Локальные = ЗначениеJSONПоляНаСервере(Данные, "localReleases");
	Если ТипЗнч(Локальные) = Тип("Массив") Тогда
		Для Каждого Элемент Из Локальные Цикл
			Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			Версия = СокрЛП(JSONСтрокаПоляНаСервере(Элемент, "version"));
			Если ПустаяСтрока(Версия) Или УжеВКаталоге.Получить(Версия) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Путь = СокрЛП(JSONСтрокаПоляНаСервере(Элемент, "path"));
			Kind = ?(Версия = Текущая, "current", "local");
			Строка = Новый Структура("version, path, kind, installed, epfUrl", Версия, Путь, Kind, Истина, "");
			Каталог.Добавить(Строка);
			УжеВКаталоге.Вставить(Версия, Истина);
		КонецЦикла;
	КонецЕсли;
	
	Если ОбновлениеДоступно И ЗначениеЗаполнено(Целевая) И УжеВКаталоге.Получить(Целевая) = Неопределено Тогда
		Kind = ?(ЛокальноЕстьЦель, "local", "remote");
		Установлен = ЛокальноЕстьЦель;
		Строка = Новый Структура("version, path, kind, installed, epfUrl", Целевая, "", Kind, Установлен, EpfUrl);
		Каталог.Добавить(Строка);
	КонецЕсли;
	
	Возврат Каталог;
	
КонецФункции

&НаКлиенте
Функция ПрочитатьЛокальныйМанифестРядомСEpfНаКлиенте(ПутьЯкоря)
	
	Результат = Новый Структура("Версия, EpfUrl, Примечания, Ошибка", "", "", "", "");
	ФайлЯкорь = Новый Файл(ПутьЯкоря);
	ПутьМанифеста = ФайлЯкорь.Путь + "update-manifest.json";
	Файл = Новый Файл(ПутьМанифеста);
	Если Не Файл.Существует() Тогда
		Результат.Ошибка = "Не задан URL манифеста и нет файла update-manifest.json в " + ФайлЯкорь.Путь;
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		Чтение = Новый ЧтениеТекста(ПутьМанифеста, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
		Данные = JSONВЗначениеНаСервере(Текст);
		Результат.Версия = JSONСтрокаПоляНаСервере(Данные, "version");
		Результат.EpfUrl = JSONСтрокаПоляНаСервере(Данные, "epfUrl");
		Результат.Примечания = JSONСтрокаПоляНаСервере(Данные, "notes");
	Исключение
		Результат.Ошибка = ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция СканироватьЛокальныеРелизыНаКлиенте(ПутьЯкоря)
	
	Результат = Новый Массив;
	Если ПустаяСтрока(ПутьЯкоря) Тогда
		Возврат Результат;
	КонецЕсли;
	
	КаталогРелизов = КаталогРелизовНаКлиенте(ПутьЯкоря);
	Каталог = Новый Файл(КаталогРелизов);
	Если Не Каталог.Существует() Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИмяEpf = ИмяФайлаEpfНаСервере();
	НайденныеВКаталоге = НайтиФайлы(КаталогРелизов, "*", Ложь);
	Для Каждого Элемент Из НайденныеВКаталоге Цикл
		Если Не Элемент.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Версия = СокрЛП(Элемент.Имя);
		ПутьEpf = КаталогРелизов + Версия + "\" + ИмяEpf;
		Если EPFФайлСуществуетНаКлиенте(ПутьEpf) Тогда
			СтрокаРелиза = Новый Структура("version, path", Версия, ПутьEpf);
			Результат.Добавить(СтрокаРелиза);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Функция НайтиПутьРелизаПоВерсииНаКлиенте(ПутьЯкоря, Версия)
	
	ПутьEpf = ПутьEpfРелизаНаКлиенте(ПутьЯкоря, Версия);
	Если EPFФайлСуществуетНаКлиенте(ПутьEpf) Тогда
		Возврат ПутьEpf;
	КонецЕсли;
	Возврат "";
	
КонецФункции

&НаКлиенте
Функция ПутьEpfРелизаНаКлиенте(ПутьЯкоря, Версия)
	
	Возврат КаталогРелизовНаКлиенте(ПутьЯкоря) + СокрЛП(Версия) + "\" + ИмяФайлаEpfНаСервере();
	
КонецФункции

&НаКлиенте
Функция КаталогРелизовНаКлиенте(ПутьЯкоря)
	
	ПутьЯкоря = НормализоватьПутьЯкоряНаКлиенте(ПутьЯкоря);
	Файл = Новый Файл(ПутьЯкоря);
	Подкаталог = ПодкаталогРелизовНаСервере();
