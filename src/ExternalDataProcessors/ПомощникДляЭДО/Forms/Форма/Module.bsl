КонецФункции

&НаСервере
Функция ПолучитьОнлайнИдЭДОJSONНаСервере(OrgRef, EntityRef)
	
	Организация = СсылкаКаталогаПоUUID(OrgRef);
	Контрагент = СсылкаКаталогаПоUUID(EntityRef);
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат JSONОшибкиОнлайнИдЭДОНаСервере("Не найдена организация документа.");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат JSONОшибкиОнлайнИдЭДОНаСервере("Не найден контрагент.");
	КонецЕсли;
	
	ИдОрганизации = ИдентификаторЭДООрганизации(Организация);
	ЗагрузкаОнлайн = ЗагрузитьИдентификаторыКонтрагентаИзСервисаЭДО(Организация, Контрагент, ИдОрганизации);
	
	ОнлайнЭлементы = Новый Массив;
	Для Каждого КлючИЗначение Из ЗагрузкаОнлайн.Идентификаторы Цикл
		Элемент = Новый Структура;
		Элемент.Вставить("edoId", КлючИЗначение.Ключ);
		Элемент.Вставить("title", КлючИЗначение.Значение);
		ОнлайнЭлементы.Добавить(Элемент);
	КонецЦикла;
	
	Ответ = Новый Структура;
	Ответ.Вставить("onlineItems", ОнлайнЭлементы);
	Ответ.Вставить("onlineLoaded", ЗагрузкаОнлайн.onlineLoaded);
	Ответ.Вставить("loadWarning", ЗагрузкаОнлайн.loadWarning);
	
	Возврат ЗаписатьJSONСтрокой(Ответ);
	
КонецФункции

&НаСервере
Функция ПолучитьДиагностикуЭДОJSONНаСервере(OrgRef, EntityRef, CurrentEdoId, ЗагружатьОнлайн = Истина)
	
	Организация = СсылкаКаталогаПоUUID(OrgRef);
	Контрагент = СсылкаКаталогаПоUUID(EntityRef);
	CurrentEdoId = СокрЛП(CurrentEdoId);
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат ЗаписатьJSONСтрокой(Новый Структура("error", "Не найдена организация документа."));
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат ЗаписатьJSONСтрокой(Новый Структура("error", "Не найден контрагент."));
	КонецЕсли;
	
	ИдОрганизации = ИдентификаторЭДООрганизации(Организация);
	ИННКонтрагента = "";
	КППКонтрагента = "";
	Попытка
		ИмяИНН = ИнтеграцияЭДО.ИмяНаличиеОбъектаРеквизитаВПрикладномРешении("ИННКонтрагента");
		ИмяКПП = ИнтеграцияЭДО.ИмяНаличиеОбъектаРеквизитаВПрикладномРешении("КППКонтрагента");
		РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, ИмяИНН + ", " + ИмяКПП);
		ИННКонтрагента = СокрЛП(Строка(РеквизитыКонтрагента[ИмяИНН]));
		КППКонтрагента = СокрЛП(Строка(РеквизитыКонтрагента[ИмяКПП]));
	Исключение
	КонецПопытки;
	
	ЗагрузкаОнлайн = Новый Структура("Идентификаторы, onlineLoaded, loadWarning", Новый Соответствие, Ложь, "");
	Если ЗагружатьОнлайн Тогда
		ЗагрузкаОнлайн = ЗагрузитьИдентификаторыКонтрагентаИзСервисаЭДО(Организация, Контрагент, ИдОрганизации);
	КонецЕсли;
	
	НастройкиПоИд = ДанныеНастроекОтправкиПоИдентификаторам(Организация, Контрагент);
	ПриглашенияПоИд = ПриглашенияДляДиагностикиЭДОПоИдентификаторам(Контрагент, ИННКонтрагента, ИдОрганизации);
	
	Идентификаторы = Новый Соответствие;
	ПорядокИд = Новый Массив;
	
	Для Каждого КлючИЗначение Из ЗагрузкаОнлайн.Идентификаторы Цикл
		ДобавитьИдентификаторВДиагностику(Идентификаторы, КлючИЗначение.Ключ, КлючИЗначение.Значение, "online");
		ПорядокИд.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	// ID только из локальной базы (была настройка или приглашение, но нет в онлайн-списке).
	ЛокальныеИд = Новый Массив;
	Для Каждого КлючИЗначение Из НастройкиПоИд Цикл
		ЛокальныеИд.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Для Каждого КлючИЗначение Из ПриглашенияПоИд Цикл
		ЛокальныеИд.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Для Каждого ИдЭДО Из ЛокальныеИд Цикл
		Если Идентификаторы.Получить(ИдЭДО) = Неопределено Тогда
			Заголовок = ЗаголовокИдентификатораЭДО(ИдЭДО);
			ДобавитьИдентификаторВДиагностику(Идентификаторы, ИдЭДО, Заголовок, "local");
			ПорядокИд.Добавить(ИдЭДО);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИдЭДО Из ПорядокИд Цикл
		Запись = Идентификаторы.Получить(ИдЭДО);
		Если Запись = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеНастройки = НастройкиПоИд.Получить(ИдЭДО);
		Если ДанныеНастройки <> Неопределено Тогда
			Запись.inSendSettings = Истина;
			Запись.settingsChangedAt = СтрокаДатыДляJSON(ДанныеНастройки.settingsChangedAt);
		КонецЕсли;
		
		Приглашения = ПриглашенияПоИд.Получить(ИдЭДО);
		Если Приглашения <> Неопределено Тогда
			Для Каждого Приглашение Из Приглашения Цикл
				Запись.invitations.Добавить(Приглашение);
				Если Приглашение.status = "accepted" Тогда
					Запись.hasAccepted = Истина;
				КонецЕсли;
				Если Приглашение.archived Тогда
					Запись.hasArchived = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Запись.hasLocalData = Запись.inSendSettings Или Запись.invitations.Количество() > 0;
		Запись.isCurrentInDoc = (Запись.edoId = CurrentEdoId);
		ЗаполнитьОператораЭДОВЗаписиДиагностики(Запись);
	КонецЦикла;
	
	МассивИд = Новый Массив;
	Для Каждого ИдЭДО Из ПорядокИд Цикл
		Запись = Идентификаторы.Получить(ИдЭДО);
		Если Запись <> Неопределено Тогда
			МассивИд.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;
	
	Ответ = Новый Структура;
	Ответ.Вставить("partyName", Строка(Контрагент));
	Ответ.Вставить("inn", ИННКонтрагента);
	Ответ.Вставить("kpp", КППКонтрагента);
	Ответ.Вставить("orgEdoId", ИдОрганизации);
	Ответ.Вставить("currentEdoId", CurrentEdoId);
	Ответ.Вставить("onlineLoaded", ЗагрузкаОнлайн.onlineLoaded);
	Ответ.Вставить("loadWarning", ЗагрузкаОнлайн.loadWarning);
	Ответ.Вставить("items", МассивИд);
	
	Возврат ЗаписатьJSONСтрокой(Ответ);
	
КонецФункции

&НаСервере
Функция ЗагрузитьИдентификаторыКонтрагентаИзСервисаЭДО(Организация, Контрагент, ИдОрганизации)
	
	Результат = Новый Структура;
	Результат.Вставить("Идентификаторы", Новый Соответствие);
	Результат.Вставить("onlineLoaded", Ложь);
	Результат.Вставить("loadWarning", "");
	
	Попытка
		ПараметрыПолучения = РаботаСАбонентамиЭДО.НовыеПараметрыПолученияСвязиИдентификаторов();
		ПараметрыПолучения.Контрагент = Контрагент;
		ПараметрыПолучения.ФормироватьСписокВыбора = Истина;
		ПараметрыПолучения.ПриоритетПодключенные = Истина;
		
		Если ЗначениеЗаполнено(ИдОрганизации) Тогда
			ПараметрыПолучения.ИдентификаторыОрганизации = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИдОрганизации);
		КонецЕсли;
		
		КонтекстДиагностики = ОбработкаНеисправностейБЭД.НовыйКонтекстДиагностики();
		СвязьИдентификаторов = РаботаСАбонентамиЭДО.ПараметрыСвязиИдентификаторов(
			ПараметрыПолучения, КонтекстДиагностики, Истина);
		
		Если СвязьИдентификаторов <> Неопределено Тогда
			Для Каждого СтрокаСвязи Из СвязьИдентификаторов Цикл
				Если ТипЗнч(СтрокаСвязи.СписокВыбора) <> Тип("СписокЗначений") Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого ЭлементСписка Из СтрокаСвязи.СписокВыбора Цикл
					ИдЭДО = СокрЛП(Строка(ЭлементСписка.Значение));
					Если ПустаяСтрока(ИдЭДО) Тогда
						Продолжить;
					КонецЕсли;
					Результат.Идентификаторы.Вставить(ИдЭДО, СокрЛП(Строка(ЭлементСписка.Представление)));
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
		Если Результат.Идентификаторы.Количество() > 0 Тогда
			Результат.onlineLoaded = Истина;
		КонецЕсли;
	Исключение
		Результат.loadWarning = "Сервис ЭДО: " + ОписаниеОшибки();
	КонецПопытки;
	
	Если Не Результат.onlineLoaded Тогда
		Попытка
			Доступные = СинхронизацияЭДО.ДоступныеИдентификаторыЭДО(Организация, Контрагент);
			Для Каждого СтрокаИд Из Доступные.ИдентификаторыПолучателя Цикл
				ИдЭДО = СокрЛП(Строка(СтрокаИд.Значение));
				Если Не ПустаяСтрока(ИдЭДО) И Результат.Идентификаторы.Получить(ИдЭДО) = Неопределено Тогда
					Результат.Идентификаторы.Вставить(ИдЭДО, СокрЛП(Строка(СтрокаИд.Представление)));
				КонецЕсли;
			КонецЦикла;
			Если Результат.Идентификаторы.Количество() > 0 Тогда
				Предупреждение = "Список ID взят из локальной базы (сервис ЭДО недоступен или пуст).";
				Если ПустаяСтрока(Результат.loadWarning) Тогда
					Результат.loadWarning = Предупреждение;
				Иначе
					Результат.loadWarning = Результат.loadWarning + " " + Предупреждение;
				КонецЕсли;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОператораЭДОВЗаписиДиагностики(Запись)
	
	ДанныеОператора = ДанныеОператораЭДОДляJSON(Запись.edoId);
	Запись.operatorCode = ДанныеОператора.operatorCode;
	Запись.operatorLabel = ДанныеОператора.operatorLabel;
	
КонецПроцедуры

&НаСервере
Функция ДанныеОператораЭДОДляJSON(ИдЭДО)
	
	Результат = Новый Структура;
	Результат.Вставить("operatorCode", "");
	Результат.Вставить("operatorLabel", "");
	
	ИдЭДО = СокрЛП(ИдЭДО);
	Если ПустаяСтрока(ИдЭДО) Тогда
		Возврат Результат;
	КонецЕсли;
	
	КодОператора = "";
	Попытка
		КодОператора = УчетныеЗаписиЭДОКлиентСервер.ИдентификаторОператора(ИдЭДО);
	Исключение
		КодОператора = ВРег(Лев(ИдЭДО, 3));
	КонецПопытки;
	Результат.operatorCode = КодОператора;
	
	Попытка
		Информация = РегистрыСведений.ОператорыЭДО.ИнформацияОбОператореЭДОУчетнойЗаписи(ИдЭДО);
		Если Информация <> Неопределено Тогда
			Представление = СокрЛП(Строка(Информация.Представление));
			Если ЗначениеЗаполнено(Представление) Тогда
				Результат.operatorLabel = Представление;
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ЗаголовокИдентификатораЭДО(ИдЭДО)
	
	Абонент = РеквизитыАбонентаЭДО(ИдЭДО);
	Если ЗначениеЗаполнено(Абонент.Наименование) Тогда
		Возврат ИдЭДО + " (" + Абонент.Наименование + ")";
	КонецЕсли;
	
	Возврат ИдЭДО;
	
КонецФункции

&НаСервере
Процедура ДобавитьИдентификаторВДиагностику(Идентификаторы, EdoId, Title, Source)
	
	EdoId = СокрЛП(EdoId);
	Если ПустаяСтрока(EdoId) Тогда
		Возврат;
	КонецЕсли;
	
	Если Идентификаторы.Получить(EdoId) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запись = Новый Структура;
	Запись.Вставить("edoId", EdoId);
	Запись.Вставить("title", СокрЛП(Title));
	Запись.Вставить("operatorCode", "");
	Запись.Вставить("operatorLabel", "");
	Запись.Вставить("source", Source);
	Запись.Вставить("inSendSettings", Ложь);
	Запись.Вставить("isCurrentInDoc", Ложь);
	Запись.Вставить("hasAccepted", Ложь);
	Запись.Вставить("hasArchived", Ложь);
	Запись.Вставить("hasLocalData", Ложь);
	Запись.Вставить("settingsChangedAt", "");
	Запись.Вставить("invitations", Новый Массив);
	Идентификаторы.Вставить(EdoId, Запись);
	
КонецПроцедуры

&НаСервере
Функция ДанныеНастроекОтправкиПоИдентификаторам(Организация, Контрагент)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Настройки.ИдентификаторПолучателя КАК ИдентификаторПолучателя
	|ИЗ
	|	РегистрСведений.НастройкиОтправкиЭлектронныхДокументовПоВидам КАК Настройки
	|ГДЕ
	|	Настройки.Отправитель = &Организация
	|	И Настройки.Получатель = &Контрагент
	|	И Настройки.ИдентификаторПолучателя <> """"";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИдЭДО = СокрЛП(Выборка.ИдентификаторПолучателя);
		Если ПустаяСтрока(ИдЭДО) Тогда
			Продолжить;
		КонецЕсли;
		Данные = Новый Структура;
		// Регистр непериодический — отдельной даты изменения настроек нет; дата берётся из приглашений.
		Данные.Вставить("settingsChangedAt", "");
		Результат.Вставить(ИдЭДО, Данные);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПриглашенияДляДиагностикиЭДОПоИдентификаторам(Контрагент, ИНН, ИдОрганизации)
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.ИдентификаторКонтрагента КАК ИдентификаторКонтрагента,
	|	П.ИдентификаторОрганизации КАК ИдентификаторОрганизации,
	|	П.ИдентификаторОператора КАК ОператорЭДО,
	|	П.Статус КАК Статус,
	|	П.ДатаИзмененияСтатуса КАК ДатаИзмененияСтатуса,
	|	П.Ознакомиться КАК Ознакомиться,
	|	П.ИНН КАК ИНН,
	|	П.КПП КАК КПП
	|ИЗ
	|	РегистрСведений.ПриглашенияКОбменуЭлектроннымиДокументами КАК П
	|ГДЕ
	|	П.Контрагент = &Контрагент
	|	ИЛИ (&ИНН <> """" И П.ИНН = &ИНН)
	|УПОРЯДОЧИТЬ ПО
	|	П.ДатаИзмененияСтатуса УБЫВ";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ИНН", ИНН);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИдЭДО = СокрЛП(Выборка.ИдентификаторКонтрагента);
		Если ПустаяСтрока(ИдЭДО) Или ИдЭДО = ИНН Тогда
			Продолжить;
		КонецЕсли;
		
		Запись = Новый Структура;
		Запись.Вставить("edoId", ИдЭДО);
		Запись.Вставить("orgEdoId", СокрЛП(Выборка.ИдентификаторОрганизации));
		Запись.Вставить("operator", СокрЛП(Выборка.ОператорЭДО));
		Запись.Вставить("status", КодСтатусаПриглашенияJSON(Выборка.Статус));
		Запись.Вставить("statusLabel", ПредставлениеСтатусаПриглашения(Выборка.Статус));
		Запись.Вставить("statusChangedAt", СтрокаДатыДляJSON(Выборка.ДатаИзмененияСтатуса));
		Запись.Вставить("archived", Выборка.Ознакомиться = Истина);
		Запись.Вставить("forOurOrg", ПустаяСтрока(ИдОрганизации) Или СокрЛП(Выборка.ИдентификаторОрганизации) = ИдОрганизации);
		
		Список = Результат.Получить(ИдЭДО);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Результат.Вставить(ИдЭДО, Список);
		КонецЕсли;
		Список.Добавить(Запись);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция КодСтатусаПриглашенияJSON(Статус)
	
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Возврат "unknown";
	КонецЕсли;
	
	Если Статус = Перечисления.СтатусыПриглашений.Принято Тогда
		Возврат "accepted";
	ИначеЕсли Статус = Перечисления.СтатусыПриглашений.Отклонено Тогда
		Возврат "rejected";
	ИначеЕсли Статус = Перечисления.СтатусыПриглашений.ОжидаемСогласия Тогда
		Возврат "awaiting_consent";
	ИначеЕсли Статус = Перечисления.СтатусыПриглашений.ТребуетсяСогласие Тогда
		Возврат "requires_consent";
	ИначеЕсли Статус = Перечисления.СтатусыПриглашений.ТребуетсяОтправить Тогда
		Возврат "requires_send";
	ИначеЕсли Статус = Перечисления.СтатусыПриглашений.НастройкаРоуминга Тогда
		Возврат "roaming_setup";
	ИначеЕсли Статус = Перечисления.СтатусыПриглашений.Ошибка Тогда
		Возврат "error";
	ИначеЕсли Статус = Перечисления.СтатусыПриглашений.НеТребуется Тогда
		Возврат "not_required";
	КонецЕсли;
	
	Возврат "unknown";
	
КонецФункции

&НаСервере
Функция ПредставлениеСтатусаПриглашения(Статус)
	
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Возврат "Неизвестно";
	КонецЕсли;
	
	Возврат Строка(Статус);
	
КонецФункции

&НаСервере
Функция ДанныеДляТранспортныхНастроекНаСервере(OrgRef, EntityRef)
	
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("Контрагент", Неопределено);
	Результат.Вставить("ИдОрганизации", "");
	
	Организация = СсылкаКаталогаПоUUID(OrgRef);
	Контрагент = СсылкаКаталогаПоUUID(EntityRef);
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Результат.Сообщение = "Не найдена организация документа.";
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Результат.Сообщение = "Не найден контрагент.";
		Возврат Результат;
	КонецЕсли;
	
	ИдОрганизации = ИдентификаторЭДООрганизации(Организация);
	Если ПустаяСтрока(ИдОрганизации) Тогда
		Результат.Сообщение = "Для организации не настроена учётная запись ЭДО.";
		Возврат Результат;
	КонецЕсли;
	
	Результат.Успех = Истина;
	Результат.Организация = Организация;
	Результат.Контрагент = Контрагент;
	Результат.ИдОрганизации = ИдОрганизации;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция РеквизитыАбонентаЭДО(ИдЭДО)
	
	Результат = Новый Структура("ИНН, КПП, Наименование", "", "", "");
	Если ПустаяСтрока(ИдЭДО) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Абоненты.ИНН КАК ИНН,
	|	Абоненты.КПП КАК КПП,
	|	Абоненты.КраткоеОписание КАК Наименование
	|ИЗ
	|	РегистрСведений.АбонентыЭДО КАК Абоненты
	|ГДЕ
	|	Абоненты.ИдентификаторЭДО = &ИдЭДО";
	Запрос.УстановитьПараметр("ИдЭДО", ИдЭДО);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ИНН = Строка(Выборка.ИНН);
		Результат.КПП = Строка(Выборка.КПП);
		Результат.Наименование = Строка(Выборка.Наименование);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

