;font-size:.88rem}.edo-diag-error{margin:0;padding:10px 12px;border-radius:8px;background:#fef2f2;color:#b42318;font-size:.9rem}.edo-diag-table-wrap{flex:1;min-height:0;overflow:auto;margin-top:8px;border:1px solid #e4e7ec;border-radius:8px}.edo-diag-table{width:100%;border-collapse:collapse;font-size:.86rem}.edo-diag-table th,.edo-diag-table td{padding:8px 10px;border-bottom:1px solid #eef1f5;vertical-align:top;text-align:left}.edo-diag-table th{position:sticky;top:0;background:#f8fafc;font-weight:600;z-index:1}.edo-diag-table tr.is-current{background:#fffbeb}.edo-diag-table tr.is-in-settings{background:#f0fdf4}.edo-diag-table tr.is-online-only{background:#fff}.edo-diag-warning{margin:8px 0 0;padding:8px 10px;border-radius:8px;background:#fffbeb;color:#92400e;font-size:.84rem}.edo-diag-online-banner{display:flex;align-items:center;gap:10px;margin:8px 0 10px;padding:10px 12px;border-radius:8px;background:#eff6ff;color:#1e40af;font-size:.86rem}.edo-diag-id-cell{display:flex;flex-direction:column;gap:4px}.edo-diag-id-row{display:flex;align-items:flex-start;gap:8px}.edo-diag-id-main{flex:1;min-width:0}.edo-diag-id-copy.copyable{display:block;max-width:100%}.edo-diag-id-copy .copyable-value{font-size:.82rem;word-break:break-all;white-space:normal;line-height:1.35}.edo-diag-id-actions{display:flex;flex-shrink:0;align-items:center;gap:2px;padding-top:1px}.edo-diag-operator{font-size:.84rem;vertical-align:top}.edo-diag-operator-name{display:block;line-height:1.35}.edo-diag-operator-code{display:block;font-size:.75rem;margin-top:2px}.edo-diag-id{font-size:.82rem;word-break:break-all}.edo-diag-title{font-size:.78rem}.edo-diag-badges{display:flex;flex-wrap:wrap;gap:4px}.edo-diag-badge{display:inline-block;padding:1px 6px;border-radius:4px;font-size:.72rem;line-height:1.4}.edo-diag-badge-current{background:#fef3c7;color:#92400e}.edo-diag-badge-settings{background:#dcfce7;color:#166534}.edo-diag-badge-archive{background:#f3f4f6;color:#4b5563}.edo-diag-badge-other-org{background