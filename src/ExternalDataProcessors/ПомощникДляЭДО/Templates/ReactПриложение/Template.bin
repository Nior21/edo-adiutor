;font-size:.88rem}.edo-diag-error{margin:0;padding:10px 12px;border-radius:8px;background:#fef2f2;color:#b42318;font-size:.9rem}.edo-diag-table-wrap{flex:1;min-height:0;overflow:auto;margin-top:8px;border:1px solid #e4e7ec;border-radius:8px}.edo-diag-table{width:100%;border-collapse:collapse;font-size:.86rem}.edo-diag-table th,.edo-diag-table td{padding:8px 10px;border-bottom:1px solid #eef1f5;vertical-align:top;text-align:left}.edo-diag-table th{position:sticky;top:0;background:#f8fafc;font-weight:600;z-index:1}.edo-diag-table tr.is-current{background:#fffbeb}.edo-diag-table tr.is-in-settings{background:#f0fdf4}.edo-diag-table tr.is-online-only{background:#fff}.edo-diag-warning{margin:8px 0 0;padding:8px 10px;border-radius:8px;background:#fffbeb;color:#92400e;font-size:.84rem}.edo-diag-online-banner{display:flex;align-items:center;gap:10px;margin:8px 0 10px;padding:10px 12px;border-radius:8px;background:#eff6ff;color:#1e40af;font-size:.86rem}.edo-diag-id-cell{display:flex;flex-direction:column;gap:4px}.edo-diag-id-row{display:flex;align-items:flex-start;gap:8px}.edo-diag-id-main{flex:1;min-width:0}.edo-diag-id-copy.copyable{display:block;max-width:100%}.edo-diag-id-copy .copyable-value{font-size:.82rem;word-break:break-all;white-space:normal;line-height:1.35}.edo-diag-id-actions{display:flex;flex-shrink:0;align-items:center;gap:2px;padding-top:1px}.edo-diag-operator{font-size:.84rem;vertical-align:top}.edo-diag-operator-name{display:block;line-height:1.35}.edo-diag-operator-code{display:block;font-size:.75rem;margin-top:2px}.edo-diag-id{font-size:.82rem;word-break:break-all}.edo-diag-title{font-size:.78rem}.edo-diag-badges{display:flex;flex-wrap:wrap;gap:4px}.edo-diag-badge{display:inline-block;padding:1px 6px;border-radius:4px;font-size:.72rem;line-height:1.4}.edo-diag-badge-current{background:#fef3c7;color:#92400e}.edo-diag-badge-settings{background:#dcfce7;color:#166534}.edo-diag-badge-archive{background:#f3f4f6;color:#4b5563}.edo-diag-badge-other-org{background:#eff6ff;color:#1d4ed8}.edo-diag-status-line{display:flex;align-items:center;gap:6px}.edo-diag-status{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;font-size:.72rem;font-weight:700;flex-shrink:0}.edo-diag-status-accepted{background:#dcfce7;color:#15803d}.edo-diag-status-rejected,.edo-diag-status-error{background:#fee2e2;color:#b91c1c}.edo-diag-status-awaiting_consent,.edo-diag-status-requires_consent,.edo-diag-status-requires_send,.edo-diag-status-roaming_setup{background:#fef3c7;color:#a16207}.edo-diag-status-in_settings{background:#dbeafe;color:#1d4ed8}.edo-diag-status-no_invitation,.edo-diag-status-unknown,.edo-diag-status-not_required{background:#f3f4f6;color:#6b7280}.edo-diag-date{white-space:nowrap;font-size:.8rem}.edo-diag-actions{white-space:nowrap}.edo-diag-link-btn{border:none;background:transparent;cursor:pointer;padding:2px 4px;font-size:.95rem;color:#475467;line-height:1}.edo-diag-link-btn:hover{color:#175cd3}.edo-diag-invitations{list-style:none;margin:4px 0 0;padding:0;display:flex;flex-direction:column;gap:2px}.edo-diag-invitation{display:flex;align-items:center;flex-wrap:wrap;gap:6px;font-size:.76rem}.edo-diag-invitation.is-archived{opacity:.75}.edo-diag-invitation-label{flex:0 1 auto}.edo-diag-invitation-date{flex:0 0 auto}.edo-diag-footer{margin-top:12px;padding-top:12px;border-top:1px solid #e4e7ec}.edo-diag-primary-link{border:none;background:transparent;padding:0;color:#175cd3;font:inherit;font-size:.9rem;cursor:pointer;text-decoration:underline}.edo-diag-primary-link:hover{color:#1040a0}.update-banner{margin:0 0 10px;padding:10px 12px;border-radius:8px;font-size:.86rem}.update-banner-info{background:#eff6ff;border:1px solid #bfdbfe;color:#1e3a8a}.update-banner-ok{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}.update-banner-error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.update-banner-error-text{color:#b91c1c;margin:0 0 6px}.update-banner-actions{display:flex;