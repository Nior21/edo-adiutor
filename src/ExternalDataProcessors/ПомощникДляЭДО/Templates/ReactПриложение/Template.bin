himmer 2.4s ease-in-out infinite;box-shadow:0 0 0 1px #22c55e26}@keyframes status-badge-shimmer{0%{background-position:0% 50%}50%{background-position:100% 50%}to{background-position:0% 50%}}.status-version-shake{display:inline-block;animation:status-icon-vibrate .55s ease-in-out infinite}@keyframes status-icon-vibrate{0%,to{transform:translate(0) rotate(0)}25%{transform:translate(-.4px,.2px) rotate(-4deg)}50%{transform:translate(.5px,-.2px) rotate(4deg)}75%{transform:translate(-.3px,-.3px) rotate(-2deg)}}.status-bar-hint{background:#fafbfd}.status-bar-active{background:#fff}.status-bar-message{display:block;flex:1;min-width:0;font-size:.82rem;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.status-bar-hint-text{color:#667085}.status-bar-info{color:#1d4f91;font-weight:500}.status-bar-error{color:#b42318;font-weight:500}.shimmer-block{display:block;height:12px;width:88%;border-radius:6px;background:#dfe6ef}.shimmer-block-css{-webkit-animation:shimmer-lab 1.1s ease-in-out infinite;animation:shimmer-lab 1.1s ease-in-out infinite}.shimmer-block-tall{height:34px}.shimmer-block-short{width:55%}.shimmer-block-mid{width:72%}.shimmer-block-menu{width:18px;height:18px;margin:0 auto}.skeleton-doc-cell{display:flex;flex-direction:column;gap:4px}.skeleton-row{cursor:default}.skeleton-row:hover{background:transparent}.loading-placeholder-row{cursor:default;pointer-events:none}.loading-placeholder-row:hover{background:transparent}.loading-shimmer{pointer-events:none;user-select:none}.loading-shimmer .doc-type-badge{opacity:.55}.loading-text{display:inline}.loading-text-bright{opacity:1!important}.party-placeholder-name{font-weight:500;color:#101828;font-size:inherit}.party-placeholder-inn,.party-placeholder-edo{color:#667085;font-size:.82rem;font-family:Consolas,Courier New,monospace}.row-menu-btn-placeholder{display:inline-flex;cursor:default;pointer-events:none}@-webkit-keyframes loading-text-pulse{0%,to{opacity:.28}50%{opacity:.92}}@keyframes loading-t