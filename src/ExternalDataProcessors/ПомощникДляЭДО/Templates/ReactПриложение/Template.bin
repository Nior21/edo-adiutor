m}.update-banner-info{background:#eff6ff;border:1px solid #bfdbfe;color:#1e3a8a}.update-banner-ok{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}.update-banner-error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.update-banner-error-text{color:#b91c1c;margin:0 0 6px}.update-banner-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}.update-btn-primary{font-weight:600}.update-path{margin:8px 0 0;font-size:.78rem;word-break:break-all}.layout-superseded .main-card,.layout-superseded .status-bar{pointer-events:none;user-select:none;filter:grayscale(.15);opacity:.45}.superseded-overlay{position:absolute;inset:0;z-index:40;display:flex;align-items:center;justify-content:center;padding:24px;background:#0f172a8c;pointer-events:auto}.superseded-card{max-width:420px;padding:20px 22px;border-radius:12px;background:#fff;color:#1f2933;box-shadow:0 12px 40px #00000040;text-align:center}.superseded-title{margin:0 0 8px;font-size:1.1rem;font-weight:700}.superseded-version{margin:0 0 8px;font-weight:600;color:#2563eb}.superseded-hint{margin:12px 0 0;font-size:.85rem}.superseded-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.status-version-btn{border:none;cursor:pointer;font:inherit}.status-version-btn:hover{background:#2563eb1f}.status-version-badge-update.status-version-btn:hover{background:linear-gradient(120deg,#d1fae5,#a7f3d0,#d1fae5)}.update-offer-card{max-width:440px}.update-offer-lead{margin:0 0 10px;line-height:1.45}.update-offer-hint{margin:0 0 16px;font-size:.88rem}.update-offer-actions{display:flex;flex-direction:column;gap:8px}.version-picker-toolbar{margin-bottom:10px}.version-picker-item-remote{border-style:dashed;border-color:#86efac;background:#f0fdf4}.about-version-line{margin:8px 0 0}.version-picker-card{max-width:420px}.version-picker-hint{margin:0 0 12px;font-size:.88rem}.version-picker-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}.version-picker-item{width:100%;display:flex;justify-content:space-between;align-items:center;padding:10px 12px;border:1px solid #e5e7eb;border-radius:8px;background:#f9fafb;cursor:pointer;font:inherit;color:#101828}.version-picker-item:hover:not(:disabled){border-color:#93c5fd;background:#eff6ff}.version-picker-item-current{cursor:default;background:#eef2f6;border-color:#d0d5dd}.version-picker-item-current .version-picker-ver{color:#475467}.version-picker-item .version-picker-action{color:#475467;font-size:.82rem}.version-picker-ver{font-weight:700;font-size:1rem;color:#101828;letter-spacing:.02em}.version-picker-item-remote .version-picker-ver{color:#14532d}.about-update-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.about-update-error{color:#b91c1c}.about-epf-path{word-break:break-all;font-size:.82rem}.edo-diag-hint{margin:8px 0 0;font-size:.78rem;line-height:1.35}.about-card{max-width:520px}.about-product p{margin:0 0 8px;font-size:.9rem;line-height:1.45}.about-credit{margin:10px 0 0;font-size:.88rem}.about-section{margin-top:16px}.about-section-title{margin:0 0 8px;font-size:.95rem;font-weight:600}.about-placeholder{margin:0 0 10px;font-size:.88rem;line-height:1.4}.about-dl{display:grid;grid-template-columns:120px 1fr;gap:6px 12px;margin:0;font-size:.88rem}.about-dl dt{margin:0;color:#667085}.about-dl dd{margin:0}.about-types{margin:0;font-size:.82rem}.about-author-card{display:grid;grid-template-columns:1fr;gap:12px;padding:12px;background:#f0f0f0;border-radius:8px;box-shadow:inset 0 0 5px #eee}.about-author-text{padding:10px;background:#f9f9f9;border-radius:6px}.about-author-name{margin:0 0 4px;font-size:1rem;font-weight:600;color:#1a1a1a}.about-author-role{margin:0 0 10px;font-size:.82rem;font-weight:500;color:#3566ab}.about-contact{margin:0 0 4px;font-size:.78rem}.about-contact a{color:#1a1a1a;text-decoration:none}.about-contact a:hover{color:#2563eb}.about-photo-link{display:block;line-height:0}.about-photo{width:100%;height:auto;border-radius:4px;background:#fff}.about-legal{margin:10px 0 0;font-size:.68rem;line-height:1.35;text-align:right}.about-footer{display:flex;justify-content:flex-end;padding-top:4px}.about-version-badge{font-size:.72rem;color:#667085;background:#f2f4f7;border:1px solid #e4e7ec;border-radius:999px;padding:2px 8px}.chip-inline{margin-top:4px}.panel{background:#fff;border:1px solid #d0d7e2;border-radius:12px;padding:14px;min-height:420px}.panel h2{margin:0 0 12px;font-size:1rem}.table-wrap{overflow:auto}table{width:100%;border-collapse:separate;border-spacing:0;font-size:.92rem}.epd-table{border-collapse:separate;border-spacing:0}.epd-table th,.epd-table td{padding:6px}th,td{padding:8px 10px;border-bottom:1px solid #e4e7ec;text-align:left;vertical-align:top}tbody tr{cursor:pointer}tbody tr:hover{background:#f8fafc}.row-active{background:#eef4ff}.center{text-align:center}.details{display:grid;grid-template-columns:160px 1fr;gap:8px 12px;margin:0 0 16px}.details dt{margin:0;color:#667085}.details dd{margin:0}.comment-block{display:flex;flex-direction:column;gap:6px;margin-bottom:12px}textarea{width:100%;resize:vertical;min-height:110px;padding:10px;border:1px solid #cfd8e3;border-radius:8px;font:inherit}button{border:0;border-radius:8px;padding:9px 14px;background:#2563eb;color:#fff;font:inherit;cursor:pointer}button:disabled{opacity:.55;cursor:not-allowed}.actions{display:flex;gap:8px}.copyable{display:inline;width:fit-content;max-width:100%;padding:0 2px;border:0;border-radius:4px;background:transparent;color:inherit;font:inherit;text-align:left;cursor:pointer;vertical-align:baseline}.copyable:hover{background:#eef4ff}.copyable-empty{display:inline;color:inherit}.copyable-inline{display:inline;padding:0 2px;border-radius:4px;vertical-align:baseline;gap:0}.copyable-inline .copyable-value{display:inline}.copyable:focus-visible{outline:2px solid rgba(37,99,235,.35);outline-offset:1px}.copyable-mono .copyable-value{font-family:Consolas,Courier New,monospace;font-size:.88rem;word-break:break-all}.copyable-label{color:#667085;font-size:.82rem;margin-right:4px}.panel-details{overflow:auto}.doc-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-bottom:14px}.doc-summary .copyable{flex-direction:column;align-items:flex-start;width:100%;padding:8px 10px;border:1px solid #e4e7ec;background:#fafbfd}.details-compact{margin-bottom:14px}.parties-section{margin-bottom:16px}.parties-header h3{margin:0 0 4px;font-size:.95rem}.parties-hint{margin:0 0 10px;font-size:.82rem}.parties-list{display:flex;flex-direction:column;gap:10px}.party-card{border:1px solid #dbe3ef;border-radius:10px;padding:10px 12px;background:#fbfcfe}.party-card-header{display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;margin-bottom:8px}.party-role{font-weight:600;color:#1d4f91}.party-name{color:#344054}.party-grid{display:grid;grid-template-columns:1fr;gap:8px}.party-field{display:flex;flex-direction:column;gap:4px}.party-label{font-size:.78rem;color:#667085;text-transform:uppercase;letter-spacing:.02em}.party-edo-row{display:flex;align-items:flex-start;gap:8px}.party-edo-id{flex:1}.edo-status{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:999px;font-size:.82rem;font-weight:700;flex-shrink:0}.edo-status-accepted{background:#dcfae6;color:#027a48}.edo-status-rejected{background:#fee4e2;color:#b42318}.edo-status-unknown{background:#f2f4f7;color:#667085}.edo-status-own{background:#eff8ff;color:#175cd3;font-size:.72rem;font-weight:800}.edo-status-idle{background:#f9fafb;color:#cbd5e1;font-weight:400}.edo-status-pending{background:#f9fafb;color:#98a2b3;animation:edo-pending-pulse 1.2s ease-in-out infinite}.party-edo-loading{animation:edo-pending-pulse 1.2s ease-in-out infinite}@keyframes edo-pending-pulse{0%,to{opacity:.45}50%{opacity:1}}@media(max-width:960px){.content{grid-template-columns:1fr}}.row-selected td{background:color-mix(in srgb,var(--accent, #2563eb) 10%,transparent)}.row-selected.row-active td{background:color-mix(in srgb,var(--accent, #2563eb) 16%,transparent)}.floating-menu-heading{padding:.35rem .75rem .2rem;font-size:.68rem;font-weight:600;letter-spacing:.02em;text-transform:uppercase;color:var(--muted-fg, #64748b);pointer-events:none}.status-bar-selection .status-bar-message{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem .75rem}.status-bar-quick-actions{display:inline-flex;flex-wrap:wrap;gap:.35rem .65rem}.status-quick-link{border:none;background:none;padding:0;color:var(--accent, #2563eb);text-decoration:underline;cursor:pointer;font:inherit}.status-quick-link:hover{opacity:.85}.xml-download-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.75rem}.xml-download-item{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:.65rem .75rem;border:1px solid var(--border-subtle, #ddd);border-radius:8px}.xml-download-label{font-weight:600}.xml-download-meta{font-size:.85rem;opacity:.85;word-break:break-all}
</style>
  </head>
  <body>
    <div id="root">
      <div class="layout layout-full layout-shell shell-static">
        <div class="main-card">
          <div class="table-subhead shell-subhead">
            <button type="button" class="date-filter-btn" disabled aria-disabled="true">
              <svg class="date-filter-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2" />
                <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <span class="date-filter-label">все даты</span>
            </button>
            <input class="subhead-search" disabled placeholder="Поиск: номер, контрагент, ИНН, шаг…" aria-disabled="true" />
            <span class="subhead-meta">…</span>
            <div class="subhead-actions">
              <button type="button" class="button-ghost button-anim-test" disabled aria-disabled="true">Тест аним. 8с</button>
              <button type="button" class="button-ghost button-refresh is-busy" aria-busy="true">
                <span class="ico-refresh ico-refresh-js shell-refresh-spin">◴</span>
                Обновить
              </button>
            </div>
          </div>
          <div class="table-scroll">
            <table class="epd-table">
              <thead>
                <tr>
                  <th>Документ</th>
                  <th>Грузоотправитель</th>
                  <th>Перевозчик</th>
                  <th>Грузополучатель</th>
                  <th class="col-row-menu"></th>
                </tr>
              </thead>
              <tbody>
                <tr class="loading-placeholder-row" aria-hidden="true">
                  <td>
                    <div class="doc-cell loading-shimmer">
                      <div class="doc-line doc-line-head">
                        <span class="doc-type-badge">ЭТрН</span>
                        <span class="doc-num-wrap">№ <span class="loading-text anim-lab-css-keyframes shell-loading-pulse">0000000000</span></span>
                      </div>
                      <div class="doc-line doc-line-meta">
                        <span class="cell-muted loading-text anim-lab-css-keyframes shell-loading-pulse">01.01.2025, 12:00</span>
                      </div>
                      <div class="doc-line doc-line-step">
                        <span class="doc-step-name step-pending loading-text anim-lab-css-keyframes shell-loading-pulse">Оформление</span>
                      </div>
                    </div>
                  </td>
                  <td>
                    <div class="party-stack loading-shimmer">
                      <span class="loading-text party-placeholder-name anim-lab-css-keyframes shell-loading-pulse">ООО «Пример»</span>
                      <span class="loading-text party-placeholder-inn anim-lab-css-keyframes shell-loading-pulse">7700000000</span>
                      <span class="loading-text party-placeholder-edo anim-lab-css-keyframes shell-loading-pulse">2BM-0000000000</span>
                    </div>
                  </td>
                  <td>
                    <div class="party-stack loading-shimmer">
                      <span class="loading-text party-placeholder-name anim-lab-css-keyframes shell-loading-pulse">ООО «Перевозчик»</span>
                      <span class="loading-text party-placeholder-inn anim-lab-css-keyframes shell-loading-pulse">7700000001</span>
                      <span class="loading-text party-placeholder-edo anim-lab-css-keyframes shell-loading-pulse">2BM-0000000001</span>
                    </div>
                  </td>
                  <td>
                    <div class="party-stack loading-shimmer">
                      <span class="loading-text party-placeholder-name anim-lab-css-keyframes shell-loading-pulse">ООО «Получатель»</span>
                      <span class="loading-text party-placeholder-inn anim-lab-css-keyframes shell-loading-pulse">7700000002</span>
                      <span class="loading-text party-placeholder-edo anim-lab-css-keyframes shell-loading-pulse">2BM-0000000002</span>
                    </div>
                  </td>
                  <td class="col-row-menu">
                    <span class="row-menu-btn row-menu-btn-placeholder loading-text anim-lab-css-keyframes shell-loading-pulse">⋮</span>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="status-bar status-bar-hint shell-status">
          <span class="status-bar-message status-bar-hint-text">Клик по строке — карточка. Клик по тексту — копирование.</span>
        </div>
      </div>
    </div>
    <a id="bridge-link" href="#" style="display:none" aria-hidden="true"></a>
    <script>
      var process = { env: { NODE_ENV: "production" } };
      window.__edoReportError = function (msg) {
        var root = document.getElementById("root");
        if (root) {
          root.innerHTML =
            '<pre style="padding:12px;font-family:Segoe UI,sans-serif;color:#c00;white-space:pre-wrap">' +
            msg +
            "</pre>";
        }
      };
      window.onerror = function (message, source, line) {
        window.__edoReportError("JS: " + message + "\n" + source + ":" + line);
      };
      (function () {
        var spinFrames = ["◴", "◷", "◶", "◵"];
        var spinEl = document.querySelector(".shell-refresh-spin");
        var pulseEls = document.querySelectorAll(".shell-loading-pulse");
        var spinI = 0;
        var pulseOn = false;
        window.setInterval(function () {
          if (spinEl) {
            spinEl.textContent = spinFrames[spinI % spinFrames.length];
            spinI += 1;
          }
          for (var i = 0; i < pulseEls.length; i += 1) {
            pulseEls[i].style.opacity = pulseOn ? "0.92" : "0.28";
          }
          pulseOn = !pulseOn;
        }, 180);
