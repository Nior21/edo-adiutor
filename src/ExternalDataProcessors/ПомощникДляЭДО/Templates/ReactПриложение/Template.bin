 12px;border-radius:8px;font-size:.86rem}.update-banner-info{background:#eff6ff;border:1px solid #bfdbfe;color:#1e3a8a}.update-banner-ok{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}.update-banner-error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.update-banner-error-text{color:#b91c1c;margin:0 0 6px}.update-banner-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}.update-btn-primary{font-weight:600}.update-path{margin:8px 0 0;font-size:.78rem;word-break:break-all}.layout-superseded .main-card,.layout-superseded .status-bar{pointer-events:none;user-select:none;filter:grayscale(.15);opacity:.45}.superseded-overlay{position:absolute;inset:0;z-index:40;display:flex;align-items:center;justify-content:center;padding:24px;background:#0f172a8c;pointer-events:auto}.superseded-card{max-width:420px;padding:20px 22px;border-radius:12px;background:#fff;color:#1f2933;box-shadow:0 12px 40px #00000040;text-align:center}.superseded-title{margin:0 0 8px;font-size:1.1rem;font-weight:700}.superseded-version{margin:0 0 8px;font-weight:600;color:#2563eb}.superseded-hint{margin:12px 0 0;font-size:.85rem}.status-version-btn{border:none;cursor:pointer;font:inherit}.status-version-btn:hover{background:#2563eb1f}.status-version-badge-update.status-version-btn:hover{background:linear-gradient(120deg,#d1fae5,#a7f3d0,#d1fae5)}.update-offer-card{max-width:440px}.update-offer-lead{margin:0 0 10px;line-height:1.45}.update-offer-hint{margin:0 0 16px;font-size:.88rem}.update-offer-actions{display:flex;flex-direction:column;gap:8px}.version-picker-toolbar{margin-bottom:10px}.version-picker-item-remote{border-style:dashed;border-color:#86efac;background:#f0fdf4}.about-version-line{margin:8px 0 0}.version-picker-card{max-width:420px}.version-picker-hint{margin:0 0 12px;font-size:.88rem}.version-picker-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}.version-picker-item{width:100%;display:flex;justify-content:space-between;align-item