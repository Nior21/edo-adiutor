flex-wrap:wrap;gap:6px;font-size:.76rem}.edo-diag-invitation.is-archived{opacity:.75}.edo-diag-invitation-label{flex:0 1 auto}.edo-diag-invitation-date{flex:0 0 auto}.edo-diag-footer{margin-top:12px;padding-top:12px;border-top:1px solid #e4e7ec}.edo-diag-primary-link{border:none;background:transparent;padding:0;color:#175cd3;font:inherit;font-size:.9rem;cursor:pointer;text-decoration:underline}.edo-diag-primary-link:hover{color:#1040a0}.update-banner{margin:0 0 10px;padding:10px 12px;border-radius:8px;font-size:.86rem}.update-banner-info{background:#eff6ff;border:1px solid #bfdbfe;color:#1e3a8a}.update-banner-ok{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}.update-banner-error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.update-banner-error-text{color:#b91c1c;margin:0 0 6px}.update-banner-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}.update-btn-primary{font-weight:600}.update-path{margin:8px 0 0;font-size:.78rem;word-break:break-all}.layout-superseded .main-card,.layout-superseded .status-bar{pointer-events:none;user-select:none;filter:grayscale(.15);opacity:.45}.superseded-overlay{position:absolute;inset:0;z-index:40;display:flex;align-items:center;justify-content:center;padding:24px;background:#0f172a8c;pointer-events:auto}.superseded-card{max-width:420px;padding:20px 22px;border-radius:12px;background:#fff;color:#1f2933;box-shadow:0 12px 40px #00000040;text-align:center}.superseded-title{margin:0 0 8px;font-size:1.1rem;font-weight:700}.superseded-version{margin:0 0 8px;font-weight:600;color:#2563eb}.superseded-hint{margin:12px 0 0;font-size:.85rem}.superseded-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.status-version-btn{border:none;cursor:pointer;font:inherit}.status-version-btn:hover{background:#2563eb1f}.status-version-badge-update.status-version-btn:hover{background:linear-gradient(120deg,#d1fae5,#a7f3d0,#d1fae5)}.update-offer-card{max-width:440px}.update-offer-lead{margin:0 0 10px;line-height:1.45}.up