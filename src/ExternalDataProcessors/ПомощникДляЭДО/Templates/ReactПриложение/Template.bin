x;flex-direction:column;gap:4px}.skeleton-row{cursor:default}.skeleton-row:hover{background:transparent}.loading-placeholder-row{cursor:default;pointer-events:none}.loading-placeholder-row:hover{background:transparent}.loading-shimmer{pointer-events:none;user-select:none}.loading-shimmer .doc-type-badge{opacity:.55}.loading-text{display:inline}.loading-text-bright{opacity:1!important}.party-placeholder-name{font-weight:500;color:#101828;font-size:inherit}.party-placeholder-inn,.party-placeholder-edo{color:#667085;font-size:.82rem;font-family:Consolas,Courier New,monospace}.row-menu-btn-placeholder{display:inline-flex;cursor:default;pointer-events:none}@-webkit-keyframes loading-text-pulse{0%,to{opacity:.28}50%{opacity:.92}}@keyframes loading-text-pulse{0%,to{opacity:.28}50%{opacity:.92}}.shell-static .shell-static-note{padding:10px 12px;color:#667085;font-size:.85rem}.shell-bar{display:block;height:12px;width:88%;border-radius:6px;background:#dfe6ef;-webkit-animation:shimmer-lab 1.1s ease-in-out infinite;animation:shimmer-lab 1.1s ease-in-out infinite}.shell-bar-tall{height:34px}.shell-doc-stack{display:flex;flex-direction:column;gap:4px}.shell-bar-short{width:55%}.shell-bar-mid{width:72%}.shell-status{position:fixed;left:0;right:0;bottom:0}.anim-lab-header td{padding:10px 12px 6px;font-size:.78rem;font-weight:600;color:#475467;background:#f8fafc;border-bottom:1px solid #e4e7ec}.anim-lab-row td{padding:6px 12px;background:#fcfdff}.anim-lab-line{display:flex;align-items:center;gap:10px}.anim-lab-tag{flex:0 0 118px;font-size:.75rem;color:#667085;font-family:Consolas,Courier New,monospace}.anim-lab-block{display:block;height:12px;width:160px;border-radius:6px;background:#dfe6ef;opacity:.45;transition:opacity .25s ease}.anim-lab-block-bright{opacity:1}.anim-lab-bg{background:#dfe6ef;opacity:1;transition:background-color .25s ease}.anim-lab-bg-alt{background:#b8c9de}.anim-lab-text{font-size:.82rem;color:#475467}.anim-lab-progress-track{display:block;width:180px;height:8p