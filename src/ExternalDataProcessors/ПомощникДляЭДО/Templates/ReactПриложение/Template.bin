;margin:8px 0 10px;padding:10px 12px;border-radius:8px;background:#eff6ff;color:#1e40af;font-size:.86rem}.edo-diag-id-cell{display:flex;flex-direction:column;gap:4px}.edo-diag-id-row{display:flex;align-items:flex-start;gap:8px}.edo-diag-id-main{flex:1;min-width:0}.edo-diag-id-copy.copyable{display:block;max-width:100%}.edo-diag-id-copy .copyable-value{font-size:.82rem;word-break:break-all;white-space:normal;line-height:1.35}.edo-diag-id-actions{display:flex;flex-shrink:0;align-items:center;gap:2px;padding-top:1px}.edo-diag-operator{font-size:.84rem;vertical-align:top}.edo-diag-operator-name{display:block;line-height:1.35}.edo-diag-operator-code{display:block;font-size:.75rem;margin-top:2px}.edo-diag-id{font-size:.82rem;word-break:break-all}.edo-diag-title{font-size:.78rem}.edo-diag-badges{display:flex;flex-wrap:wrap;gap:4px}.edo-diag-badge{display:inline-block;padding:1px 6px;border-radius:4px;font-size:.72rem;line-height:1.4}.edo-diag-badge-current{background:#fef3c7;color:#92400e}.edo-diag-badge-settings{background:#dcfce7;color:#166534}.edo-diag-badge-archive{background:#f3f4f6;color:#4b5563}.edo-diag-badge-other-org{background:#eff6ff;color:#1d4ed8}.edo-diag-status-line{display:flex;align-items:center;gap:6px}.edo-diag-status{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;font-size:.72rem;font-weight:700;flex-shrink:0}.edo-diag-status-accepted{background:#dcfce7;color:#15803d}.edo-diag-status-rejected,.edo-diag-status-error{background:#fee2e2;color:#b91c1c}.edo-diag-status-awaiting_consent,.edo-diag-status-requires_consent,.edo-diag-status-requires_send,.edo-diag-status-roaming_setup{background:#fef3c7;color:#a16207}.edo-diag-status-in_settings{background:#dbeafe;color:#1d4ed8}.edo-diag-status-no_invitation,.edo-diag-status-unknown,.edo-diag-status-not_required{background:#f3f4f6;color:#6b7280}.edo-diag-date{white-space:nowrap;font-size:.8rem}.edo-diag-actions{white-space:nowrap}.edo-diag-link-btn{border:no