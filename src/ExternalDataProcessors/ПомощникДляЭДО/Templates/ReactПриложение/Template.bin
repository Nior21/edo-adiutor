ackground:#ecfdf3;color:#027a48}.chip-neutral{background:#f2f4f7;color:#475467}.chip-danger{background:#fef3f2;color:#b42318}.row-deleted{opacity:.72}.row-deleted td{background:#fff7f7}.party-stack{display:flex;flex-direction:column;align-items:flex-start;gap:2px;line-height:1.25}.party-inline-line{display:inline-flex;align-items:center;flex-wrap:wrap;gap:2px 4px;max-width:100%}.party-name-btn,.party-inn-btn,.party-edo-btn{padding:0 1px}.party-name-btn .copyable-value{font-weight:500;color:#101828}.party-inn-btn .copyable-value,.party-edo-btn .copyable-value{color:#667085;font-size:.82rem}.party-name-muted,.party-inn-muted,.party-edo-muted,.party-empty{color:#98a2b3;font-size:.82rem}.party-edo-line{display:inline-flex;align-items:center;flex-wrap:wrap;gap:4px;max-width:100%}.modal-overlay-portal{position:fixed;top:0;left:0;z-index:99999;background:#1018288c;overflow:auto;-webkit-overflow-scrolling:touch}.modal-overlay-table{display:table;width:100%;height:100%;min-height:100%}.modal-overlay-cell{display:table-cell;vertical-align:middle;text-align:center;padding:24px}.modal-card{display:inline-block;width:min(920px,calc(100vw - 48px));max-width:920px;max-height:calc(100vh - 48px);overflow:auto;text-align:left;vertical-align:middle;background:#fff;border-radius:14px;border:1px solid #d0d7e2;box-shadow:0 20px 48px #1018282e;padding:18px 20px 20px}.modal-header{display:flex;justify-content:space-between;gap:12px;margin-bottom:12px}.modal-header h2{margin:4px 0 0;font-size:1.15rem}.modal-kicker{margin:0;color:#667085;font-size:.82rem}.modal-close{width:36px;height:36px;padding:0;border-radius:999px;background:#f2f4f7;color:#344054;font-size:1.4rem;line-height:1}.modal-actions-top{margin-bottom:14px}.button-secondary{background:#fff;color:#1d4f91;border:1px solid #b2c8ea}.modal-section{margin-bottom:16px;padding-top:12px;border-top:1px solid #eaecf0}.modal-section h3{margin:0 0 10px;font-size:.95rem}.modal-subtitle{margin:10px 0 8px;font-size:.88rem;color:#475467}.details