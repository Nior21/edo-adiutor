k;padding:1px 6px;border-radius:4px;font-size:.72rem;line-height:1.4}.edo-diag-badge-current{background:#fef3c7;color:#92400e}.edo-diag-badge-settings{background:#dcfce7;color:#166534}.edo-diag-badge-archive{background:#f3f4f6;color:#4b5563}.edo-diag-badge-other-org{background:#eff6ff;color:#1d4ed8}.edo-diag-status-line{display:flex;align-items:center;gap:6px}.edo-diag-status{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;font-size:.72rem;font-weight:700;flex-shrink:0}.edo-diag-status-accepted{background:#dcfce7;color:#15803d}.edo-diag-status-rejected,.edo-diag-status-error{background:#fee2e2;color:#b91c1c}.edo-diag-status-awaiting_consent,.edo-diag-status-requires_consent,.edo-diag-status-requires_send,.edo-diag-status-roaming_setup{background:#fef3c7;color:#a16207}.edo-diag-status-in_settings{background:#dbeafe;color:#1d4ed8}.edo-diag-status-no_invitation,.edo-diag-status-unknown,.edo-diag-status-not_required{background:#f3f4f6;color:#6b7280}.edo-diag-date{white-space:nowrap;font-size:.8rem}.edo-diag-actions{white-space:nowrap}.edo-diag-link-btn{border:none;background:transparent;cursor:pointer;padding:2px 4px;font-size:.95rem;color:#475467;line-height:1}.edo-diag-link-btn:hover{color:#175cd3}.edo-diag-invitations{list-style:none;margin:4px 0 0;padding:0;display:flex;flex-direction:column;gap:2px}.edo-diag-invitation{display:flex;align-items:center;flex-wrap:wrap;gap:6px;font-size:.76rem}.edo-diag-invitation.is-archived{opacity:.75}.edo-diag-invitation-label{flex:0 1 auto}.edo-diag-invitation-date{flex:0 0 auto}.edo-diag-footer{margin-top:12px;padding-top:12px;border-top:1px solid #e4e7ec}.edo-diag-primary-link{border:none;background:transparent;padding:0;color:#175cd3;font:inherit;font-size:.9rem;cursor:pointer;text-decoration:underline}.edo-diag-primary-link:hover{color:#1040a0}.edo-diag-hint{margin:8px 0 0;font-size:.78rem;line-height:1.35}.about-card{max-width:520px}.about-product p{margin:0 0 8px;font-si