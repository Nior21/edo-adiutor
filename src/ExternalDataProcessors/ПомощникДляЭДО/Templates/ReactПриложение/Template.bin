<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Помощник ЭДО — ЭПД</title>
    <style>:root{color-scheme:light dark;font-family:Segoe UI,system-ui,sans-serif;background:#f3f5f8;color:#1f2933}*{box-sizing:border-box}body{margin:0}body.modal-open{overflow:hidden}.layout{min-height:100vh}.layout-full{max-width:100%}.layout-shell{display:flex;flex-direction:column;min-height:100vh;padding:8px 10px 36px;gap:6px}.layout-toolbar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-shrink:0}.app-meta{font-size:.82rem}.muted{color:#667085}.button-ghost{padding:6px 10px;background:#fff;color:#344054;border:1px solid #d0d7e2;font-size:.82rem}.content{display:grid;grid-template-columns:1.2fr .8fr;gap:16px}.panel-table{width:100%}.panel-flex{flex:1;min-height:0;display:flex;flex-direction:column;padding:0;border:0;background:transparent;min-height:unset;border-radius:0}.table-wrap-wide{flex:1;min-height:0;overflow:auto;height:calc(100vh - 72px);border:1px solid #d0d7e2;border-radius:10px;background:#fff}.epd-table thead{position:sticky;top:0;z-index:5}.epd-table th{font-size:.82rem;color:#475467;background:#f8fafc;position:sticky;top:0;z-index:5;box-shadow:inset 0 -1px #e4e7ec}.epd-table td{min-width:120px}.epd-table td:nth-child(2),.epd-table td:nth-child(3),.epd-table td:nth-child(4){min-width:200px;max-width:260px}.doc-cell{min-width:110px}.doc-type-badge{display:inline-block;padding:2px 8px;border-radius:999px;background:#eef4ff;color:#1d4f91;font-weight:600;font-size:.78rem;width:fit-content}.doc-number-btn{padding:0;font-weight:600}.cell-stack{display:flex;flex-direction:column;gap:2px}.cell-muted{color:#667085;font-size:.8rem}.step-flag{font-size:.78rem}.step-done{color:#027a48}.step-pending{color:#b54708}.status-chips{display:flex;flex-direction:column;gap:4px}.chip{display:inline-block;padding:2px 8px;border-radius:999px;font-size:.75rem;width:fit-content}.chip-ok{background:#ecfdf3;color:#027a48}.chip-neutral{background:#f2f4f7;color:#475467}.chip-danger{background:#fef3f2;color:#b42318}.row-deleted{opacity:.72}.row-deleted td{background:#fff7f7}.party-stack{display:flex;flex-direction:column;gap:2px;line-height:1.25}.party-name-btn,.party-inn-btn,.party-edo-btn{width:100%;justify-content:flex-start;padding:0 2px}.party-name-btn .copyable-value{font-weight:500;color:#101828}.party-inn-btn .copyable-value,.party-edo-btn .copyable-value{color:#667085;font-size:.82rem}.party-name-muted,.party-inn-muted,.party-edo-muted,.party-empty{color:#98a2b3;font-size:.82rem}.party-edo-line{display:flex;align-items:center;gap:6px}.modal-overlay{position:fixed;inset:0;background:#10182873;display:flex;align-items:center;justify-content:center;padding:24px;z-index:10000}.modal-card{width:min(920px,100%);max-height:calc(100vh - 48px);overflow:auto;background:#fff;border-radius:14px;border:1px solid #d0d7e2;box-shadow:0 20px 48px #1018282e;padding:18px 20px 20px}.modal-header{display:flex;justify-content:space-between;gap:12px;margin-bottom:12px}.modal-header h2{margin:4px 0 0;font-size:1.15rem}.modal-kicker{margin:0;color:#667085;font-size:.82rem}.modal-close{width:36px;height:36px;padding:0;border-radius:999px;background:#f2f4f7;color:#344054;font-size:1.4rem;line-height:1}.modal-actions-top{margin-bottom:14px}.button-secondary{background:#fff;color:#1d4f91;border:1px solid #b2c8ea}.modal-section{margin-bottom:16px;padding-top:12px;border-top:1px solid #eaecf0}.modal-section h3{margin:0 0 10px;font-size:.95rem}.modal-subtitle{margin:10px 0 8px;font-size:.88rem;color:#475467}.details-grid{display:grid;grid-template-columns:180px 1fr;gap:8px 12px;margin:0}.details-grid dt{margin:0;color:#667085}.details-grid dd{margin:0}.details-grid-pair{display:contents}.status-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.status-badge{display:inline-block;padding:4px 10px;border-radius:999px;font-size:.78rem}.status-badge-ok{background:#ecfdf3;color:#027a48}.status-badge-warn{background:#fffaeb;color:#b54708}.modal-parties{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.party-column-title{margin:0 0 6px;font-size:.78rem;font-weight:600;color:#475467;text-transform:uppercase;letter-spacing:.02em}.modal-diagnostics ul{margin:0;padding-left:18px;color:#b42318}.modal-diagnostics li{margin-bottom:4px}.modal-loading{display:flex;flex-direction:column;align-items:center;gap:10px;padding:28px 12px;color:#667085}.modal-loading-spinner{width:28px;height:28px;border:3px solid #dbe3ef;border-top-color:#2563eb;border-radius:999px;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.status-bar{position:fixed;left:0;right:0;bottom:0;z-index:50;min-height:32px;padding:6px 12px;border-top:1px solid #d0d7e2;background:#fffffff5;backdrop-filter:blur(6px);transition:background-color .2s ease,border-color .2s ease}.status-bar-hint{background:#fafbfd}.status-bar-active{background:#fff}.status-bar-message{display:block;font-size:.82rem;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.status-bar-hint-text{color:#667085}.status-bar-info{color:#1d4f91;font-weight:500}.status-bar-error{color:#b42318;font-weight:500}.shimmer-block{display:block;height:12px;width:88%;border-radius:6px;background:linear-gradient(90deg,#eef2f6,#f8fafc,#eef2f6 90%);background-size:220% 100%;animation:shimmer 1.4s ease-in-out infinite}.shimmer-block-tall{height:34px}.epd-table-skeleton tbody tr{cursor:default}.epd-table-skeleton tbody tr:hover{background:transparent}@keyframes shimmer{0%{background-position:100% 0}to{background-position:-100% 0}}.panel{background:#fff;border:1px solid #d0d7e2;border-radius:12px;padding:14px;min-height:420px}.panel h2{margin:0 0 12px;font-size:1rem}.table-wrap{overflow:auto;max-height:520px}table{width:100%;border-collapse:separate;border-spacing:0;font-size:.92rem}.epd-table{border-collapse:separate;border-spacing:0}th,td{padding:8px 10px;border-bottom:1px solid #e4e7ec;text-align:left;vertical-align:top}tbody tr{cursor:pointer}tbody tr:hover{background:#f8fafc}.row-active{background:#eef4ff}.center{text-align:center}.details{display:grid;grid-template-columns:160px 1fr;gap:8px 12px;margin:0 0 16px}.details dt{margin:0;color:#667085}.details dd{margin:0}.comment-block{display:flex;flex-direction:column;gap:6px;margin-bottom:12px}textarea{width:100%;resize:vertical;min-height:110px;padding:10px;border:1px solid #cfd8e3;border-radius:8px;font:inherit}button{border:0;border-radius:8px;padding:9px 14px;background:#2563eb;color:#fff;font:inherit;cursor:pointer}button:disabled{opacity:.55;cursor:not-allowed}.actions{display:flex;gap:8px}.copyable{display:inline-flex;align-items:center;gap:6px;max-width:100%;padding:2px 6px;border:0;border-radius:6px;background:transparent;color:inherit;font:inherit;text-align:left;cursor:pointer}.copyable:hover:not(:disabled){background:#eef4ff}.copyable:disabled{cursor:default;opacity:.7}.copyable-mono .copyable-value{font-family:Consolas,Courier New,monospace;font-size:.88rem;word-break:break-all}.copyable-label{color:#667085;font-size:.82rem;margin-right:4px}.copyable-hint{color:#027a48;font-size:.75rem;white-space:nowrap}.copyable-copied .copyable-value{color:#027a48}.panel-details{overflow:auto}.doc-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-bottom:14px}.doc-summary .copyable{flex-direction:column;align-items:flex-start;width:100%;padding:8px 10px;border:1px solid #e4e7ec;background:#fafbfd}.details-compact{margin-bottom:14px}.parties-section{margin-bottom:16px}.parties-header h3{margin:0 0 4px;font-size:.95rem}.parties-hint{margin:0 0 10px;font-size:.82rem}.parties-list{display:flex;flex-direction:column;gap:10px}.party-card{border:1px solid #dbe3ef;border-radius:10px;padding:10px 12px;background:#fbfcfe}.party-card-header{display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;margin-bottom:8px}.party-role{font-weight:600;color:#1d4f91}.party-name{color:#344054}.party-grid{display:grid;grid-template-columns:1fr;gap:8px}.party-field{display:flex;flex-direction:column;gap:4px}.party-label{font-size:.78rem;color:#667085;text-transform:uppercase;letter-spacing:.02em}.party-edo-row{display:flex;align-items:flex-start;gap:8px}.party-edo-id{flex:1}.edo-status{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:999px;font-size:.82rem;font-weight:700;flex-shrink:0}.edo-status-accepted{background:#dcfae6;color:#027a48}.edo-status-rejected{background:#fee4e2;color:#b42318}.edo-status-unknown{background:#f2f4f7;color:#667085}.edo-status-own{background:#eff8ff;color:#175cd3;font-size:.72rem;font-weight:800}@media(max-width:960px){.content{grid-template-columns:1fr}}
</style>
  </head>
  <body>
    <div id="root"><p style="padding:12px;font-family:Segoe UI,sans-serif">Загрузка React UI…</p></div>
