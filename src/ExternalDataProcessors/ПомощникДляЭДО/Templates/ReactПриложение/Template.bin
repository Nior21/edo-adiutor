<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Помощник ЭДО — ЭПД</title>
    <style>:root{color-scheme:light dark;font-family:Segoe UI,system-ui,sans-serif;background:#f3f5f8;color:#1f2933}*{box-sizing:border-box}html,body,#root{height:100%}body{margin:0;overflow:hidden}body.modal-open{overflow:hidden}.layout{min-height:100%}.layout-full{max-width:100%}.layout-shell{display:flex;flex-direction:column;height:100%;min-height:100%;padding:8px 10px 36px;gap:0;position:relative}.main-card{flex:1;min-height:0;display:flex;flex-direction:column;background:#fff;border:1px solid #d0d7e2;border-radius:10px;overflow:hidden}.table-subhead{display:flex;align-items:center;gap:12px;flex-wrap:nowrap;padding:10px 12px;border-bottom:1px solid #e4e7ec;background:#fff;flex-shrink:0;font-size:.92rem}.shell-subhead{padding:10px 12px}.subhead-search{flex:1 1 auto;min-width:140px;min-height:34px;border:1px solid #cfd8e3;border-radius:8px;padding:7px 11px;font:inherit;font-size:.92rem;line-height:1.25;color:#1f2933;background:#fff}.subhead-search:focus{outline:none;border-color:#2563eb;box-shadow:0 0 0 2px #2563eb1f}.subhead-meta{color:#667085;font-size:.92rem;white-space:nowrap;flex-shrink:0;padding:0 2px}.subhead-actions{display:flex;align-items:center;gap:8px;flex-shrink:0;margin-left:auto}.button-refresh{display:inline-flex;align-items:center;gap:5px}.button-refresh.is-busy{pointer-events:none;opacity:.88}.button-refresh.is-busy .ico-refresh{-webkit-animation:spin-refresh .75s linear infinite;animation:spin-refresh .75s linear infinite;-webkit-transform-origin:center center;transform-origin:center center}.button-anim-test.is-active{color:#2563eb;border-color:#93b4ef;background:#eef4ff}@-webkit-keyframes spin-refresh{to{-webkit-transform:rotate(-360deg);transform:rotate(-360deg)}}@keyframes spin-refresh{to{transform:rotate(-360deg)}}.date-filter-btn{display:inline-flex;align-items:center;gap:6px;flex-shrink:0;max-width:12rem;min-height:34px;padding:7px 11px;border:1px solid #d0d7e2;border-radius:8px;background:#fff;color:#344054;font:inherit;font-size:.92rem;cursor:pointer}.date-filter-btn:hover{color:#2563eb;border-color:#93b4ef;background:#f8fafc}.date-filter-icon{flex-shrink:0;color:#667085}.date-filter-btn:hover .date-filter-icon{color:#2563eb}.date-filter-label{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.icon-btn{width:28px;height:28px;display:grid;place-items:center;border:1px solid #d0d7e2;background:#fff;color:#667085;cursor:pointer;padding:0;flex-shrink:0;border-radius:6px}.icon-btn:hover{color:#2563eb;border-color:#93b4ef}.col-actions{width:52px;text-align:center;vertical-align:middle}.col-row-menu{width:34px;min-width:34px;max-width:34px;padding:8px 4px;text-align:center;vertical-align:middle}.btn-open-1c{display:inline-flex;align-items:center;justify-content:center;min-width:36px;padding:4px 8px;border:1px solid #cfd8e3;border-radius:6px;background:#f8fafc;color:#344054;font:inherit;font-size:.72rem;font-weight:600;cursor:pointer;line-height:1.2}.btn-open-1c:hover{color:#2563eb;border-color:#93b4ef;background:#eef4ff}.cal-pop{position:fixed;z-index:60;width:280px;padding:10px;border:1px solid #d0d7e2;border-radius:10px;background:#fff;box-shadow:0 8px 24px #1018281f}.cal-head{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:6px;margin-bottom:8px}.cal-title{text-align:center;font-size:.82rem;font-weight:600;text-transform:capitalize}.cal-actions{display:flex;gap:6px;margin-bottom:8px}.cal-act{flex:1;border:1px solid #d0d7e2;background:#f8fafc;color:#344054;font:inherit;font-size:.72rem;padding:4px 6px;border-radius:6px;cursor:pointer}.cal-act:hover{border-color:#93b4ef;color:#2563eb}.cal-weekdays,.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}.cal-weekdays span{text-align:center;font-size:.68rem;color:#667085;padding:2px 0 4px}.cal-day{border:1px solid transparent;background:transparent;color:#344054;font:inherit;font-size:.78rem;padding:6px 0;border-radius:6px;cursor:pointer}.cal-day.out{color:#98a2b3}.cal-day.has-data{box-shadow:inset 0 -2px #93b4ef}.cal-day.selected{background:#eef4ff;border-color:#2563eb;color:#1d4f91}.cal-day.today:not(.selected){outline:1px solid #cbd5e1}.cal-hint{margin:8px 0 0;font-size:.68rem;color:#667085}.table-scroll{flex:1;min-height:0;overflow:auto;-webkit-overflow-scrolling:touch}.app-meta{font-size:.82rem}.muted{color:#667085}.button-ghost{min-height:34px;padding:7px 11px;background:#fff;color:#344054;border:1px solid #d0d7e2;border-radius:8px;font:inherit;font-size:.92rem;cursor:pointer}.button-ghost:hover{color:#2563eb;border-color:#93b4ef;background:#f8fafc}.content{display:grid;grid-template-columns:1.2fr .8fr;gap:16px}.loading-caption{margin:8px 12px 6px;font-size:.82rem;color:#475467;opacity:.45;transition:opacity .25s ease}.loading-caption-bright{opacity:1}.loading-caption-css{-webkit-animation:shimmer-lab 1.1s ease-in-out infinite;animation:shimmer-lab 1.1s ease-in-out infinite}.epd-table thead{position:sticky;top:0;z-index:5}.epd-table th{font-size:.82rem;color:#475467;background:#f8fafc;position:sticky;top:0;z-index:5;box-shadow:inset 0 -1px #e4e7ec}.epd-table td{min-width:120px}.epd-table td:nth-child(2),.epd-table td:nth-child(3),.epd-table td:nth-child(4){min-width:200px;max-width:260px}.doc-cell{min-width:140px}.doc-line{display:flex;align-items:center;flex-wrap:wrap;gap:4px 6px;line-height:1.3}.doc-line-head{margin-bottom:2px}.doc-line-meta{justify-content:space-between;gap:4px}.doc-line-step{margin-top:1px}.doc-step-name{font-size:.88rem;font-weight:500;cursor:default}.doc-step-name.step-done{color:#027a48}.doc-step-name.step-pending{color:#b54708}.doc-num-wrap{font-size:.88rem;font-weight:600;color:#101828}.doc-type-badge{display:inline-block;padding:2px 8px;border-radius:999px;background:#eef4ff;color:#1d4f91;font-weight:600;font-size:.78rem;width:fit-content;flex-shrink:0}.doc-number-btn{padding:0;font-weight:600}.chip-inline{padding:1px 6px;font-size:.72rem;flex-shrink:0}.link-icon-btn{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;padding:0;border:0;border-radius:5px;background:transparent;color:#667085;cursor:pointer;flex-shrink:0}.link-icon-btn:hover{color:#2563eb;background:#eef4ff}.row-menu-btn{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;padding:0;border:0;border-radius:5px;background:transparent;color:#98a2b3;font-size:1rem;line-height:1;cursor:pointer;flex-shrink:0}.row-menu-btn:hover{color:#2563eb;background:#eef4ff}.floating-menu,.row-context-menu{position:fixed;z-index:100000;min-width:168px;padding:4px;border:1px solid #d0d7e2;border-radius:8px;background:#fff;box-shadow:0 8px 24px #10182824}.floating-menu-item,.row-context-menu-item{display:block;width:100%;padding:8px 10px;border:0;border-radius:6px;background:transparent;color:#344054;font:inherit;font-size:.88rem;text-align:left;cursor:pointer}.floating-menu-item:hover,.row-context-menu-item:hover{background:#eef4ff;color:#1d4f91}.cell-stack{display:flex;flex-direction:column;gap:2px}.cell-muted{color:#667085;font-size:.8rem}.step-flag{font-size:.78rem}.step-done{color:#027a48}.step-pending{color:#b54708}.status-chips{display:flex;flex-direction:column;gap:4px}.chip{display:inline-block;padding:2px 8px;border-radius:999px;font-size:.75rem;width:fit-content}.chip-ok{background:#ecfdf3;color:#027a48}.chip-neutral{background:#f2f4f7;color:#475467}.chip-danger{background:#fef3f2;color:#b42318}.row-deleted{opacity:.72}.row-deleted td{background:#fff7f7}.party-stack{display:flex;flex-direction:column;align-items:flex-start;gap:2px;line-height:1.25}.party-inline-line{display:inline-flex;align-items:center;flex-wrap:wrap;gap:2px 4px;max-width:100%}.party-name-btn,.party-inn-btn,.party-edo-btn{padding:0 1px}.party-name-btn .copyable-value{font-weight:500;color:#101828}.party-inn-btn .copyable-value,.party-edo-btn .copyable-value{color:#667085;font-size:.82rem}.party-name-muted,.party-inn-muted,.party-edo-muted,.party-empty{color:#98a2b3;font-size:.82rem}.party-edo-line{display:inline-flex;align-items:center;flex-wrap:wrap;gap:4px;max-width:100%}.modal-overlay-portal{position:fixed;top:0;left:0;z-index:99999;background:#1018288c;overflow:auto;-webkit-overflow-scrolling:touch}.modal-overlay-table{display:table;width:100%;height:100%;min-height:100%}.modal-overlay-cell{display:table-cell;vertical-align:middle;text-align:center;padding:24px}.modal-card{display:inline-block;width:min(920px,calc(100vw - 48px));max-width:920px;max-height:calc(100vh - 48px);overflow:auto;text-align:left;vertical-align:middle;background:#fff;border-radius:14px;border:1px solid #d0d7e2;box-shadow:0 20px 48px #1018282e;padding:18px 20px 20px}.modal-header{display:flex;justify-content:space-between;gap:12px;margin-bottom:12px}.modal-header h2{margin:4px 0 0;font-size:1.15rem}.modal-kicker{margin:0;color:#667085;font-size:.82rem}.modal-close{width:36px;height:36px;padding:0;border-radius:999px;background:#f2f4f7;color:#344054;font-size:1.4rem;line-height:1}.modal-actions-top{margin-bottom:14px}.button-secondary{background:#fff;color:#1d4f91;border:1px solid #b2c8ea}.modal-section{margin-bottom:16px;padding-top:12px;border-top:1px solid #eaecf0}.modal-section h3{margin:0 0 10px;font-size:.95rem}.modal-subtitle{margin:10px 0 8px;font-size:.88rem;color:#475467}.details-grid{display:grid;grid-template-columns:180px 1fr;gap:8px 12px;margin:0}.details-grid dt{margin:0;color:#667085}.details-grid dd{margin:0}.details-grid-pair{display:contents}.status-row{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.status-badge{display:inline-block;padding:4px 10px;border-radius:999px;font-size:.78rem}.status-badge-ok{background:#ecfdf3;color:#027a48}.status-badge-warn{background:#fffaeb;color:#b54708}.modal-parties{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.party-column-title{margin:0 0 6px;font-size:.78rem;font-weight:600;color:#475467;text-transform:uppercase;letter-spacing:.02em}.modal-diagnostics ul{margin:0;padding-left:18px;color:#b42318}.modal-diagnostics li{margin-bottom:4px}.modal-loading{display:flex;flex-direction:column;align-items:center;gap:10px;padding:28px 12px;color:#667085}.modal-loading-spinner{width:28px;height:28px;border:3px solid #dbe3ef;border-top-color:#2563eb;border-radius:999px}.status-bar{position:fixed;left:0;right:0;bottom:0;z-index:50;min-height:32px;padding:6px 10px 6px 12px;border-top:1px solid #d0d7e2;background:#fffffff5;backdrop-filter:blur(6px);transition:background-color .2s ease,border-color .2s ease;display:flex;align-items:center;justify-content:space-between;gap:10px}.status-bar-tools{display:flex;align-items:center;gap:6px;flex-shrink:0}.status-help-btn{width:22px;height:22px;border-radius:999px;border:1px solid #d0d7e2;background:#fff;color:#667085;font:inherit;font-size:.78rem;font-weight:600;line-height:1;cursor:pointer;padding:0}.status-help-btn:hover{color:#2563eb;border-color:#93b4ef}.status-version-badge{font-size:.68rem;color:#667085;background:#f2f4f7;border:1px solid #e4e7ec;border-radius:999px;padding:2px 7px;white-space:nowrap}.status-bar-hint{background:#fafbfd}.status-bar-active{background:#fff}.status-bar-message{display:block;flex:1;min-width:0;font-size:.82rem;line-height:1.35;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.status-bar-hint-text{color:#667085}.status-bar-info{color:#1d4f91;font-weight:500}.status-bar-error{color:#b42318;font-weight:500}.shimmer-block{display:block;height:12px;width:88%;border-radius:6px;background:#dfe6ef}.shimmer-block-css{-webkit-animation:shimmer-lab 1.1s ease-in-out infinite;animation:shimmer-lab 1.1s ease-in-out infinite}.shimmer-block-tall{height:34px}.shimmer-block-short{width:55%}.shimmer-block-mid{width:72%}.shimmer-block-menu{width:18px;height:18px;margin:0 auto}.skeleton-doc-cell{display:flex;flex-direction:column;gap:4px}.skeleton-row{cursor:default}.skeleton-row:hover{background:transparent}.shell-static .shell-static-note{padding:10px 12px;color:#667085;font-size:.85rem}.shell-bar{display:block;height:12px;width:88%;border-radius:6px;background:#dfe6ef;-webkit-animation:shimmer-lab 1.1s ease-in-out infinite;animation:shimmer-lab 1.1s ease-in-out infinite}.shell-bar-tall{height:34px}.shell-doc-stack{display:flex;flex-direction:column;gap:4px}.shell-bar-short{width:55%}.shell-bar-mid{width:72%}.shell-status{position:fixed;left:0;right:0;bottom:0}.anim-lab-header td{padding:10px 12px 6px;font-size:.78rem;font-weight:600;color:#475467;background:#f8fafc;border-bottom:1px solid #e4e7ec}.anim-lab-row td{padding:6px 12px;background:#fcfdff}.anim-lab-line{display:flex;align-items:center;gap:10px}.anim-lab-tag{flex:0 0 118px;font-size:.75rem;color:#667085;font-family:Consolas,Courier New,monospace}.anim-lab-block{display:block;height:12px;width:160px;border-radius:6px;background:#dfe6ef;opacity:.45;transition:opacity .25s ease}.anim-lab-block-bright{opacity:1}.anim-lab-bg{background:#dfe6ef;opacity:1;transition:background-color .25s ease}.anim-lab-bg-alt{background:#b8c9de}.anim-lab-text{font-size:.82rem;color:#475467}.anim-lab-progress-track{display:block;width:180px;height:8px;border-radius:999px;background:#e4e7ec;overflow:hidden}.anim-lab-progress-fill{display:block;height:100%;border-radius:999px;background:#2563eb;transition:width .45s ease}.anim-lab-css-keyframes{-webkit-animation:shimmer-lab 1.1s ease-in-out infinite;animation:shimmer-lab 1.1s ease-in-out infinite}.anim-lab-css-spin{-webkit-animation:spin-lab .8s linear infinite;animation:spin-lab .8s linear infinite;display:inline-block;margin-left:8px}@-webkit-keyframes shimmer-lab{0%,to{opacity:.35}50%{opacity:.95}}@keyframes shimmer-lab{0%,to{opacity:.35}50%{opacity:.95}}@keyframes spin-lab{to{transform:rotate(360deg)}}.about-card{max-width:520px}.about-product p{margin:0 0 8px;font-size:.9rem;line-height:1.45}.about-credit{margin:10px 0 0;font-size:.88rem}.about-section{margin-top:16px}.about-section-title{margin:0 0 8px;font-size:.95rem;font-weight:600}.about-placeholder{margin:0 0 10px;font-size:.88rem;line-height:1.4}.about-dl{display:grid;grid-template-columns:120px 1fr;gap:6px 12px;margin:0;font-size:.88rem}.about-dl dt{margin:0;color:#667085}.about-dl dd{margin:0}.about-types{margin:0;font-size:.82rem}.about-author-card{display:grid;grid-template-columns:1fr;gap:12px;padding:12px;background:#f0f0f0;border-radius:8px;box-shadow:inset 0 0 5px #eee}.about-author-text{padding:10px;background:#f9f9f9;border-radius:6px}.about-author-name{margin:0 0 4px;font-size:1rem;font-weight:600;color:#1a1a1a}.about-author-role{margin:0 0 10px;font-size:.82rem;font-weight:500;color:#3566ab}.about-contact{margin:0 0 4px;font-size:.78rem}.about-contact a{color:#1a1a1a;text-decoration:none}.about-contact a:hover{color:#2563eb}.about-photo-link{display:block;line-height:0}.about-photo{width:100%;height:auto;border-radius:4px;background:#fff}.about-legal{margin:10px 0 0;font-size:.68rem;line-height:1.35;text-align:right}.about-footer{display:flex;justify-content:flex-end;padding-top:4px}.about-version-badge{font-size:.72rem;color:#667085;background:#f2f4f7;border:1px solid #e4e7ec;border-radius:999px;padding:2px 8px}.chip-inline{margin-top:4px}.panel{background:#fff;border:1px solid #d0d7e2;border-radius:12px;padding:14px;min-height:420px}.panel h2{margin:0 0 12px;font-size:1rem}.table-wrap{overflow:auto}table{width:100%;border-collapse:separate;border-spacing:0;font-size:.92rem}.epd-table{border-collapse:separate;border-spacing:0}th,td{padding:8px 10px;border-bottom:1px solid #e4e7ec;text-align:left;vertical-align:top}tbody tr{cursor:pointer}tbody tr:hover{background:#f8fafc}.row-active{background:#eef4ff}.center{text-align:center}.details{display:grid;grid-template-columns:160px 1fr;gap:8px 12px;margin:0 0 16px}.details dt{margin:0;color:#667085}.details dd{margin:0}.comment-block{display:flex;flex-direction:column;gap:6px;margin-bottom:12px}textarea{width:100%;resize:vertical;min-height:110px;padding:10px;border:1px solid #cfd8e3;border-radius:8px;font:inherit}button{border:0;border-radius:8px;padding:9px 14px;background:#2563eb;color:#fff;font:inherit;cursor:pointer}button:disabled{opacity:.55;cursor:not-allowed}.actions{display:flex;gap:8px}.copyable{display:inline;width:fit-content;max-width:100%;padding:0 2px;border:0;border-radius:4px;background:transparent;color:inherit;font:inherit;text-align:left;cursor:pointer;vertical-align:baseline}.copyable:hover{background:#eef4ff}.copyable-empty{display:inline;color:inherit}.copyable-inline{display:inline;padding:0 2px;border-radius:4px;vertical-align:baseline;gap:0}.copyable-inline .copyable-value{display:inline}.copyable:focus-visible{outline:2px solid rgba(37,99,235,.35);outline-offset:1px}.copyable-mono .copyable-value{font-family:Consolas,Courier New,monospace;font-size:.88rem;word-break:break-all}.copyable-label{color:#667085;font-size:.82rem;margin-right:4px}.panel-details{overflow:auto}.doc-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin-bottom:14px}.doc-summary .copyable{flex-direction:column;align-items:flex-start;width:100%;padding:8px 10px;border:1px solid #e4e7ec;background:#fafbfd}.details-compact{margin-bottom:14px}.parties-section{margin-bottom:16px}.parties-header h3{margin:0 0 4px;font-size:.95rem}.parties-hint{margin:0 0 10px;font-size:.82rem}.parties-list{display:flex;flex-direction:column;gap:10px}.party-card{border:1px solid #dbe3ef;border-radius:10px;padding:10px 12px;background:#fbfcfe}.party-card-header{display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;margin-bottom:8px}.party-role{font-weight:600;color:#1d4f91}.party-name{color:#344054}.party-grid{display:grid;grid-template-columns:1fr;gap:8px}.party-field{display:flex;flex-direction:column;gap:4px}.party-label{font-size:.78rem;color:#667085;text-transform:uppercase;letter-spacing:.02em}.party-edo-row{display:flex;align-items:flex-start;gap:8px}.party-edo-id{flex:1}.edo-status{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;border-radius:999px;font-size:.82rem;font-weight:700;flex-shrink:0}.edo-status-accepted{background:#dcfae6;color:#027a48}.edo-status-rejected{background:#fee4e2;color:#b42318}.edo-status-unknown{background:#f2f4f7;color:#667085}.edo-status-own{background:#eff8ff;color:#175cd3;font-size:.72rem;font-weight:800}@media(max-width:960px){.content{grid-template-columns:1fr}}
</style>
  </head>
  <body>
    <div id="root">
      <div class="layout layout-full layout-shell shell-static">
        <div class="main-card">
          <div class="table-subhead shell-subhead">
            <button type="button" class="date-filter-btn" disabled aria-disabled="true">
              <svg class="date-filter-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="2" />
                <path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
              <span class="date-filter-label">все даты</span>
            </button>
            <input class="subhead-search" disabled placeholder="Поиск: номер, контрагент, ИНН, шаг…" aria-disabled="true" />
            <span class="subhead-meta">…</span>
            <div class="subhead-actions">
              <button type="button" class="button-ghost button-anim-test" disabled aria-disabled="true">Тест аним. 8с</button>
              <button type="button" class="button-ghost button-refresh is-busy" disabled aria-disabled="true">
                <svg class="ico-refresh" width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M21 12a9 9 0 1 1-2.6-6.3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                  <path d="M21 3v6h-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Обновить
              </button>
            </div>
          </div>
          <div class="table-scroll">
            <table class="epd-table">
              <thead>
                <tr>
                  <th>Документ</th>
                  <th>Грузоотправитель</th>
                  <th>Перевозчик</th>
                  <th>Грузополучатель</th>
                  <th class="col-row-menu"></th>
                </tr>
              </thead>
              <tbody>
                <tr class="loading-placeholder-row" aria-hidden="true">
                  <td>
                    <div class="doc-cell loading-shimmer">
                      <div class="doc-line doc-line-head">
                        <span class="doc-type-badge">ЭТрН</span>
                        <span class="doc-num-wrap">№ <span class="loading-text">0000000000</span></span>
                      </div>
                      <div class="doc-line doc-line-meta">
                        <span class="cell-muted loading-text">01.01.2025, 12:00</span>
                      </div>
                      <div class="doc-line doc-line-step">
                        <span class="doc-step-name step-pending loading-text">Оформление</span>
                      </div>
                    </div>
                  </td>
                  <td>
                    <div class="party-stack loading-shimmer">
                      <span class="loading-text party-placeholder-name">ООО «Пример»</span>
                      <span class="loading-text party-placeholder-inn">7700000000</span>
                      <span class="loading-text party-placeholder-edo">2BM-0000000000</span>
                    </div>
                  </td>
                  <td>
                    <div class="party-stack loading-shimmer">
                      <span class="loading-text party-placeholder-name">ООО «Перевозчик»</span>
                      <span class="loading-text party-placeholder-inn">7700000001</span>
                      <span class="loading-text party-placeholder-edo">2BM-0000000001</span>
                    </div>
                  </td>
                  <td>
                    <div class="party-stack loading-shimmer">
                      <span class="loading-text party-placeholder-name">ООО «Получатель»</span>
                      <span class="loading-text party-placeholder-inn">7700000002</span>
                      <span class="loading-text party-placeholder-edo">2BM-0000000002</span>
                    </div>
                  </td>
                  <td class="col-row-menu">
                    <span class="row-menu-btn row-menu-btn-placeholder loading-text">⋮</span>
                  </td>
